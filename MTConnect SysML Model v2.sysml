            PASS {
                doc /* part conforms to given requirements.*/
            }
            FAIL {
                doc /* part does not conform to some given requirements.*/
            }
        }
        enum def DirectionRotaryEnum {
            CLOCKWISE {
                doc /* clockwise rotation using the right-hand rule.*/
            }
            COUNTER_CLOCKWISE {
                doc /* counter-clockwise rotation using the right-hand rule.*/
            }
