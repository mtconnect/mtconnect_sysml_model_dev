                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::MEASUREMENT_UNITS;
            }
            part def CharacteristicStatus :> Event {
                doc /* {{def(EventEnum::CHARACTERISTIC_STATUS)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::ADAPTER_URI;
                attribute result [0..1] :>> result : Profile::DataTypes::CharacteristicStatusEnum :> result;
            }
            part def UncertaintyType :> Event {
                doc /* {{def(EventEnum::UNCERTAINTY_TYPE)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::UNCERTAINTY_TYPE;
                attribute result [0..1] :>> result : Profile::DataTypes::UncertaintyTypeEnum;
            }
            part def Uncertainty :> Event {
                doc /* {{def(EventEnum::UNCERTAINTY)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::UNCERTAINTY;
                attribute result [0..1] :>> result : Profile::DataTypes::double;
            }
            connection def {
                end result :>> target::result : Profile::DataTypes::SensorAttachmentResult => target.result;
                private end : SensorAttachment;
            }
            part def AlarmLimits :> Event {
                doc /* {{def(EventEnum::ALARM_LIMITS)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::ALARM_LIMIT;
                part result [0..1] :>> result : Profile::DataTypes::AlarmLimitResult;
            }
            part def ControlLimits :> Event {
                doc /* {{def(EventEnum::CONTROL_LIMITS)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::CONTROL_LIMIT;
                part result [0..1] :>> result : Profile::DataTypes::ControlLimitResult;
            }
            part def SpecificationLimits :> Event {
                doc /* {{def(EventEnum::SPECIFICATION_LIMITS)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::SPECIFICATION_LIMIT;
                part result [0..1] :>> result : Profile::DataTypes::SpecificationLimitResult;
            }
            part def ToolCuttingItem :> Event {
                doc /* {{def(EventEnum::TOOL_CUTTING_ITEM)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::TOOL_CUTTING_ITEM;
            }
            part def 'Hardware.Model' :> Hardware {
                doc /* model info of the hardware or software.*/
                constant attribute subType :>> ActiveAxes::subType : Profile::DataTypes::DataItemSubTypeEnum :> ActiveAxes::subType default subType::MODEL;
            }
            part def LocationAddress :> Event {
                doc /* {{def(EventEnum::LOCATION_ADDRESS)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::LOCATION_ADDRESS;
                part result [0..1] :>> result : Profile::DataTypes::LocationAddressResult;
            }
            part def ActivePowerSource :> Event {
                doc /* {{def(EventEnum::ACTIVE_POWER_SOURCE)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::ACTIVE_POWER_SOURCE;
                attribute result [0..1] :>> result : Profile::DataTypes::string :> result {
                    doc /* name of the power source referring to {{block(Configuration)}} {{property(PowerSource::value)}}.*/
                }
            }
            part def LocationNarrative :> Event {
                doc /* {{def(EventEnum::LOCATION_NARRATIVE)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::LOCATION_NARRATIVE;
            }
            part def Thickness :> Event {
                doc /* {{def(EventEnum::THICKNESS)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::THICKNESS;
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::ACTUAL;
                attribute result [0..1] :>> result : Profile::DataTypes::float;
            }
            part def 'Thickness.Actual' :> Thickness {
                doc /* {{def(EventEnum::THICKNESS)}} that is {{def(DataItemSubTypeEnum::ACTUAL)}}.*/
                constant attribute subType [1] :>> ActiveAxes::subType : Profile::DataTypes::DataItemSubTypeEnum :> ActiveAxes::subType default subType::ACTUAL;
            }
            part def 'Thickness.Commanded' :> Thickness {
                doc /* {{def(EventEnum::THICKNESS)}} that is {{def(DataItemSubTypeEnum::COMMANDED)}}.*/
                constant attribute subType [1] :>> ActiveAxes::subType : Profile::DataTypes::DataItemSubTypeEnum :> ActiveAxes::subType default subType::COMMANDED;
            }
            part def 'Thickness.Target' :> Thickness {
                doc /* {{def(EventEnum::THICKNESS)}} that is {{def(DataItemSubTypeEnum::TARGET)}}.*/
                constant attribute subType [1] :>> ActiveAxes::subType : Profile::DataTypes::DataItemSubTypeEnum :> ActiveAxes::subType default subType::TARGET;
            }
            part def 'Thickness.Programmed' :> Thickness {
                doc /* {{def(EventEnum::THICKNESS)}} that is {{def(DataItemSubTypeEnum::PROGRAMMED)}}.*/
                constant attribute subType [1] :>> ActiveAxes::subType : Profile::DataTypes::DataItemSubTypeEnum :> ActiveAxes::subType default subType::PROGRAMMED;
            }
            part def LocationSpatialGeographic :> Event {
                doc /* {{def(EventEnum::LOCATION_SPATIAL_GEOGRAPHIC)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::LOCATION_SPATIAL_GEOGRAPHIC;
                part result [0..1] :>> result : Profile::DataTypes::LocationSpatialGeographicResult;
            }
            part def PartIndex :> Event {
                doc /* {{def(EventEnum::PART_INDEX)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::PART_INDEX;
                attribute result [0..1] :>> result : Profile::DataTypes::integer;
            }
            part def AssociatedAssetId :> Event {
                doc 
                /* {{def(EventEnum::ASSOCIATED_ASSET_ID)}}
                 *
                 * If defined as a DataSet or Table:
                 *
                 * * `key` **MUST** be an {{(block(Asset)}} type. Examples: CuttingTool, Fixture, File.
                 *
                 * * `value` **MUST** be the corresponding {{block(Asset::assetId)}}.*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::ASSOCIATED_ASSET_ID;
            }
            part def AssetAdded :> Event {
                doc /* {{def(EventEnum::ASSET_ADDED)}}*/
                attribute assetType [0..1] : Profile::DataTypes::string {
                    doc /* type of {{block(Asset)}} added. See {{package(Asset Information Model)}} for details on the {{block(Asset)}} model.*/
                }
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::ASSET_ADDED;
                attribute hash [0..1] : Profile::DataTypes::string {
                    doc /* condensed message digest from a secure one-way hash function. {{cite(FIPS PUB 180-4)}}*/
                }
            }
            part def TaskAssetId :> Event {
                doc /* {{def(EventEnum::TASK_ASSET_ID)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::TASK_ASSET_ID;
            }
            part def BindingState :> Event {
                doc /* {{def(EventEnum::BINDING_STATE)}}*/
                attribute result [0..1] :>> result : Profile::DataTypes::BindingStateEnum;
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::BINDING_STATE;
            }
            part def 'Material.Electrode' :> MaterialLayer {
                doc /* {{def(EventEnum::MATERIAL)}} for an {{def(DataItemSubType::ELECTRODE)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::ELECTRODE;
            }
            part def 'Material.Gas' :> MaterialLayer {
                doc /* {{def(EventEnum::MATERIAL)}} that is a {{def(DataItemSubType::GAS)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::GAS;
            }
            part def 'Material.Filler' :> MaterialLayer {
                doc /* {{def(EventEnum::MATERIAL)}} that is a {{def(DataItemSubType::FILLER)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::FILLER;
            }
            part def SwingAngle :> Event {
                doc /* {{def(EventEnum::SWING_ANGLE)}}*/
                constant attribute units :>> units : Profile::DataTypes::UnitEnum :> units default units::MILLIMETER;
                constant attribute type :>> Sample::type : Profile::DataTypes::EventEnum :> Sample::type default type::SWING_ANGLE;
                attribute result [0..1] :>> result : Profile::DataTypes::float;
            }
            part def SwingDiameter :> Event {
                doc /* {{def(EventEnum::SWING_DIAMETER)}}*/
                constant attribute units :>> units : Profile::DataTypes::UnitEnum :> units default units::MILLIMETER;
                constant attribute type :>> Sample::type : Profile::DataTypes::EventEnum :> Sample::type default type::SWING_DIAMETER;
                attribute result [0..1] :>> result : Profile::DataTypes::float;
            }
            part def SwingRadius :> Event {
                doc /* {{def(EventEnum::SWING_RADIUS)}}*/
                constant attribute units :>> units : Profile::DataTypes::UnitEnum :> units default units::MILLIMETER;
                constant attribute type :>> Sample::type : Profile::DataTypes::EventEnum :> Sample::type default type::SWING_RADIUS;
                attribute result [0..1] :>> result : Profile::DataTypes::float;
            }
            part def Depth :> Event {
                doc /* {{def(EventEnum::DEPTH)}}*/
                attribute result [0..1] :>> result : Profile::DataTypes::float;
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::DEPTH;
                constant attribute units :>> units : Profile::DataTypes::UnitEnum :> units default units::MILLIMETER;
            }
            part def 'Depth.Plunge' :> Depth {
                doc /* {{def(EventEnum::DEPTH)}} when the action is to {{def(DataItemSubType::PLUNGE)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::PLUNGE;
            }
            part def 'Depth.Peck' :> Depth {
                doc /* {{def(EventEnum::DEPTH)}} when the action is to {{def(DataItemSubType::PECK)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::PECK;
            }
            part def 'Depth.Cut' :> Depth {
                doc /* {{def(EventEnum::DEPTH)}} when the action is to {{def(DataItemSubType::CUT)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::CUT;
            }
            part def 'Depth.Layer' :> Depth {
                doc /* {{def(EventEnum::DEPTH)}} for a {{def(DataItemSubType::LAYER)}}*/
                constant attribute subType :>> subType : Profile::DataTypes::DataItemSubTypeEnum :> subType default subType::LAYER;
            }
            part def FixtureAssetId :> Event {
                doc /* {{def(EventEnum::FIXTURE_ASSET_ID)}}*/
                constant attribute type :>> type : Profile::DataTypes::EventEnum :> type default type::FIXTURE_ASSET_ID;
            }
            doc /* This section provides semantic information for {{block(Event)}} types.*/
        }
        package 'Condition Types' {
            part def Actuator :> Condition {
                doc /* {{def(ConditionEnum::ACTUATOR)}}*/
                constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum default type::ACTUATOR;
            }
            part def Communications :> Condition {
                doc /* {{def(ConditionEnum::COMMUNICATIONS)}}*/
                constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum default type::COMMUNICATIONS;
            }
            part def DataRange :> Condition {
                doc /* {{def(ConditionEnum::DATA_RANGE)}}*/
                constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum default type::DATA_RANGE;
            }
            part def LogicProgram :> Condition {
                doc /* {{def(ConditionEnum::LOGIC_PROGRAM)}}*/
                constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum default type::LOGIC_PROGRAM;
            }
            part def MotionProgram :> Condition {
                doc /* {{def(ConditionEnum::MOTION_PROGRAM)}}*/
                constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum default type::MOTION_PROGRAM;
            }
            part def System :> Condition {
                doc /* {{def(ConditionEnum::SYSTEM)}}*/
                constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum default type::SYSTEM;
            }
            doc 
            /* This section provides semantic information for {{block(Condition)}} types.
             *
             * {{block(Condition)}} types are reported differently from other {{block(Observation)}} types. They are reported based on the {{term(condition state)}} for each {{block(Condition)}}.
             *
             * The {{property(DataItem::type)}} and {{property(DataItem::subType)}} (where applicable) for a {{block(Condition)}} **MAY** be any of the {{property(DataItem::type)}} and {{property(DataItem::subType)}} defined for {{block(DataItem)}}s with {{property(DataItem::category)}} as `SAMPLE` or {{property(DataItem::category)}} as `EVENT` listed in the {{term(Device Information Model)}}.
             *
             * This section lists additional {{block(Condition)}} types that have been defined to represent the health and fault status of {{termplural(Component)}}.*/
        }
        doc 
        /* This section provides semantic information for the {{block(Observation)}} types.
         *
         * {{block(Observation)}} entities are instantiated as {{block(Sample)}}, {{block(Event)}} or {{block(Condition)}} entities based upon the {{property(DataItem::category)}} and {{property(DataItem::type)}} defined for the corresponding {{block(DataItem)}}.
         *
         * See {{figure(DeviceStream Example)}} for examples on how the {{block(Observation)}} types are organized within {{block(ComponentStream)}}.*/
    }
    part def DeviceStream {
        doc /* {{termplural(organize)}} data reported from a {{block(Device)}}.*/
        comment /* Description*/
        attribute name [1] : Profile::DataTypes::string {
            doc 
            /* name of the {{block(Device)}}.
             *
             * The value reported for {{property(DeviceStream::name)}} **MUST** be the same as the value defined for the {{property(Device::name)}} in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute uuid [1] : Profile::DataTypes::UUID {
            doc /* uuid of the {{block(Device)}}.  The value reported for {{property(DeviceStream::uuid)}} **MUST** be the same as the value defined for the {{property(Device::uuid)}} of the same {{block(Device)}} in the {{term(MTConnectDevices Response Document)}}.*/
        }
        part hasComponentStream [1..*] : 'Observation Information Model'::ComponentStream;
        doc 
        /* {{block(DeviceStream)}} **MUST** be provided for each {{block(Device)}} reporting data in an {{term(MTConnectStreams Response Document)}}.
         *
         * If the response to the request for data from an {{term(agent)}} does not contain any data for a specific {{block(Device)}}, an empty {{block(DeviceStream)}} entity **MAY** be created to indicate that the {{block(Device)}} exists, but there was no data available.*/
    }
    connection def ComponentStream {
        end hasComponentStream : 'Observation Information Model'::ComponentStream => target.hasComponentStream;
        doc /* See {{sect(ComponentStream)}}.*/
        end : DeviceStream;
    }
    part def ComponentStream {
        doc /* organizes the data associated with each {{block(Component)}} entity defined for a {{block(Device)}} in the associated {{term(MTConnectDevices Response Document)}}.*/
        comment /* Description*/
        attribute component [1] : Profile::DataTypes::string {
            doc 
            /* identifies the {{block(Component)}} type associated with the {{block(ComponentStream)}}.
             *
             * Examples of {{property(ComponentStream::component)}} are {{block(Device)}}, {{block(Controller)}}, {{block(Linear)}} and {{block(Loader)}}.*/
        }
        attribute componentId [1] : Profile::DataTypes::ID {
            doc /* identifier of the {{block(Component)}} as defined by the {{property(Component::id)}} in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute name [0..1] : Profile::DataTypes::string {
            doc /* name of the {{block(Component)}} associated with the {{block(ComponentStream)}}.*/
        }
        attribute nativeName [0..1] : Profile::DataTypes::string {
            doc /* common name of the {{block(Component)}} associated with the {{block(ComponentStream)}}.*/
        }
        attribute uuid [0..1] : Profile::DataTypes::UUID {
            doc /* uuid of the {{block(Component)}} associated with the {{block(ComponentStream)}}.*/
        }
        ref part organizesEvent [0..*] : Event;
        ref part organizesSample [0..*] : Sample;
        ref part organizesCondition [0..*] : Condition;
        private ref part isOrganizerFor [1] : 'Device Information Model'::Components::Component;
        doc /* At least one of {{block(Sample)}}, {{block(Event)}}, or {{block(Condition)}} **MUST** be organized by a {{block(ComponentStream)}} entity.*/
    }
    abstract part def Observation :> Glossary::'MTConnect Terms'::Observation {
        doc /* abstract entity that provides telemetry data for a {{block(DataItem)}} at a point in time.*/
        comment /* Description*/
        constant attribute compositionId [0..1] : Profile::DataTypes::ID {
            doc /* identifier of the {{block(Composition)}} entity defined in the {{term(MTConnectDevices Response Document)}} associated with the data reported for the {{block(Observation)}}.*/
        }
        constant attribute dataItemId [1] : Profile::DataTypes::ID {
            doc 
            /* unique identifier of the {{block(DataItem)}} associated with this {{block(Observation)}}.
             *
             * {{property(Observation::dataItemId)}} **MUST** match the associated {{property(DataItem::id)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        constant attribute name [0..1] : Profile::DataTypes::string {
            doc 
            /* name of the {{block(DataItem)}} associated with this {{block(Observation)}}.
             *
             * {{property(Observation::name)}} **MUST** match the associated {{property(DataItem::name)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute sequence [1] : Profile::DataTypes::integer {
            doc 
            /* number representing the sequential position of an occurrence of an {{term(observation)}} in the data buffer of an {{term(agent)}}.
             *
             * {{property(Observation::sequence)}} **MUST** have a value represented as an unsigned 64-bit value from 1 to $$ 2^{64}-1 $$.*/
        }
        constant attribute subType [0..1] : Profile::DataTypes::DataItemSubTypeEnum {
            doc 
            /* subtype of the {{block(DataItem)}} associated with this {{block(Observation)}}.
             *
             * {{property(Observation::subType)}} **MUST** match the associated {{property(DataItem::subType)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute timestamp [1] : Profile::DataTypes::datetime {
            doc /* most accurate time available to a piece of equipment that represents the point in time that the data reported was measured.*/
        }
        private ref part madeByComponent [1] : 'Device Information Model'::Components::Component;
        constant attribute type [1] : Profile::DataTypes::DataItemTypeEnum {
            doc 
            /* type of the {{block(DataItem)}} associated with this {{block(Observation)}}.
             *
             * {{property(Observation::type)}} **MUST** match the associated {{property(DataItem::type)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        constant attribute units [0..1] : Profile::DataTypes::UnitEnum {
            doc 
            /* units of the {{block(DataItem)}} associated with this {{block(Observation)}}.
             *
             * {{property(Observation::units)}} **MUST** match the associated {{property(DataItem::units)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute isUnavailable [1] : Profile::DataTypes::boolean default true {
            doc 
            /* when `true`, {{property(Observation::result)}} is indeterminate.
             *
             * > Note 1 to entry: In {{term(XML)}}, when `isUnavailable` is `true`, the {{term(XML)}} `CDATA` of the `Observation` **MUST** be `UNAVAILABLE`.
             *  ```xml
             * <Execution dataItemId="..." ...>UNAVAILABLE</Execution>
             * ```
             *
             * > Note 2 to entry: In {{term(JSON)}}, when `isUnavailable` is `true`, the {{term(JSON)}} `value` of the `Observation` **MUST** be `UNAVAILABLE`.
             * ```json
             *   "Execution" : [ { "dataItemId": "..." ..., "value": "UNAVAILABLE" } ]
             * ```*/
        }
        attribute result [0..1] : Profile::DataTypes::string {
            doc 
            /* {{term(observation)}} of the {{block(Observation)}} entity.
             *
             * The default value type for {{property(Observation::result)}} is `string`.
             *
             * > Note 1 to entry: in {{term(XML)}} the {{property(Observation::result)}} is the `CDATA` of the Observation {{term(element)}}.
             *
             * ~~~~xml
             * <Execution dataItemId="..." ...>READY</Execution>
             * ~~~~
             *
             * > Note 2 to entry: in {{term(JSON)}} the {{property(Observation::result)}} is the member `value` of the Observation object.
             *
             * ~~~~json
             * "Execution" : [ { "dataItemId": "..." ..., "value": "READY" } ]
             * ~~~~*/
        }
        private ref part madeForDataItem [1] : 'Device Information Model'::DataItems::DataItem;
        private attribute quality [0..1] : Profile::DataTypes::QualityEnum default quality::UNVERIFIABLE {
            doc /* indicates if the {{block(Observation)}} is verifiable and is in accordance with the normative definitions within the MTConnect Standard.*/
        }
        private attribute deprecated [0..1] : Profile::DataTypes::boolean default false {
            doc /* indicates if the {{block(Observation)}} has any property or controlled vocabulary that has been deprecated in the MTConnect Standard.*/
        }
        private attribute extended [0..1] : Profile::DataTypes::boolean default false {
            doc /* indicates if the {{block(Observation)}} has any property or controlled vocabulary that has been extended and cannot be validated.*/
        }
        doc 
        /* ![Observations](figures/Observations.png "Observations"){: width="0.8"}
         *
         * > Note: See {{sect(Observations Schema Diagrams)}} for XML schema. The XML schema also shows differences in XML representation of certain MTConnect entities.
         *
         * {{figure(DeviceStream Example)}} shows a complete example of {{block(DeviceStream)}} for the {{block(Device)}} shown in {{package(Device Information Model)}}.
         *
         * ![DeviceStream Example](figures/DeviceStream%20Example.png "DeviceStream Example"){: width="0.8"}
         *
         * > Note: See {{lst(devicestream-example)}} for the {{term(XML)}} representation of the same example.
         *
         *
         * This section provides semantic information for the {{block(Observation)}} model.
         *
         * > Note: See {{sect(Observations Schema Diagrams)}} for XML schema of {{block(Observation)}} types.
         *
         * #### Observations made for DataItem
         *
         * {{block(Component)}} {{termplural(observe)}} {{block(DataItem)}} entities and creates {{block(Observation)}} entities for the {{block(DataItem)}} entities. See {{figure(Observations)}}.
         *
         * {{block(Observation)}} entities made by a {{block(Component)}} are organized by a {{block(ComponentStream)}} which is specifically created for that {{block(Component)}}.
         *
         * ![Observations made for DataItem Example](figures/Observations%20made%20for%20DataItem%20Example.png "Observations made for DataItem Example"){: width="0.8"}
         *
         * > Note: See {{sect(Observations made for DataItem Example)}} for how XML representation of the same example is separated into {{term(MTConnectDevices Response Document)}} and {{term(MTConnectStreams Response Document)}}.
         *
         * {{figure(Observations made for DataItem Example)}} is a subset of {{figure(DeviceStream Example)}}. It shows an example of the association between a {{block(DataItem)}} {{block(Event)}} type (`EMERGENCY_STOP`) and an {{block(Observation)}} {{block(Event)}} type (`EmergencyStop`). See {{sect(Naming Convention for Observation types)}}.
         *
         * {{figure(Observations made for DataItem Example)}} also shows example of the association between a {{block(Component)}} type (`Controller`) and related {{block(ComponentStream)}}.
         *
         * #### Naming Convention for Observation types
         *
         * The name of an {{block(Observation)}} type **MUST** derive from the associated {{property(DataItem::type)}} converted to Pascal-Case by removing underscores (_ ) and capitalizing each word. The conversion **MUST NOT** apply to the following abbreviated words: `PH`, `AC`, `DC` and `URI`. `MTCONNECT` **MUST** be converted to `MTConnect`. See {{figure(Observations made for DataItem Example)}} for an example.
         *
         * The name of an {{block(Observation)}} type reported in the {{term(MTConnectStreams Response Document)}} is extended when the {{property(DataItem::representation)}} is used to further describe that {{block(DataItem)}} in the {{term(MTConnectDevices Response Document)}}. See {{package(Representations)}} for more details.*/
    }
    part def Sample :> Observation {
        doc /* {{block(Observation)}} that is continuously changing or analog data value.
         */
        comment /* Description*/
        attribute duration [0..1] : Profile::DataTypes::SECOND {
            doc 
            /* time-period over which the data was collected.
             *
             * {{property(Sample::duration)}} **MUST** be provided when the {{property(DataItem::statistic)}} is defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute resetTriggered [0..1] : Profile::DataTypes::ResetTriggeredEnum {
            doc 
            /* identifies when a reported value has been reset and what has caused that reset to occur for those {{block(DataItem)}} entities that may be periodically reset to an initial value.
             *
             * `resetTriggered` **MUST** only be provided for the specific occurrence of a {{block(DataItem)}} reported in the {{term(MTConnectStreams Response Document)}} when the reset occurred.*/
        }
        attribute sampleRate [0..1] : Profile::DataTypes::float {
            doc /* rate at which successive samples of the value are recorded.
             */
            comment /* Description*/
            doc 
            /* {{property(Sample::sampleRate)}} is expressed in terms of samples per second.
             *
             * If {{property(Sample::sampleRate)}} is smaller than one, the number can be represented as a decimal type floating-point number. For example, a rate of 1 per 10 seconds would be 0.1 {{property(Sample::sampleRate)}} **MUST** be provided when {{property(DataItem::representation)}} defined in the {{term(MTConnectDevices Response Document)}} is `TIME_SERIES`.
             *
             * When {{property(DataItem::representation)}} is not `TIME_SERIES`, it **MUST** be assumed that the data reported is represented by a single value and {{property(Sample::sampleRate)}} **MUST NOT** be reported in the {{term(MTConnectStreams Response Document)}}.*/
        }
        attribute statistic [0..1] : Profile::DataTypes::StatisticEnum {
            doc /* type of statistical calculation defined by the {{property(DataItem::statistic)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        private ref part organizedByComponentStream : 'Observation Information Model'::ComponentStream;
        attribute result [0..1] :>> result : Profile::DataTypes::float;
        constant attribute units [1] :>> units : Profile::DataTypes::UnitEnum;
        constant attribute type [1] :>> type : Profile::DataTypes::SampleEnum :> type;
        doc 
        /*
         * It provides the information and data reported from a piece of equipment for those {{block(DataItem)}} entities defined with {{property(DataItem::category)}} as `SAMPLE` in the {{term(MTConnectDevices Response Document)}}.
         *
         * {{block(Sample)}} **MUST** always be reported in `float`.
         *
         * {{figure(Sample Example)}} shows {{block(Sample)}} type examples. It also shows an example for when the {{property(Observation::result)}} is not available (`dataItemId`=`cspeed`).
         *
         * ![Sample Example](figures/Sample%20Example.png "Sample Example"){: width="0.8"}
         *
         * > Note: See {{lst(sample-example)}} for the {{term(XML)}} representation of the same example.
         *
         * The following {{sect(Value Properties of Sample)}} lists the additional and/or updated attributes for {{block(Sample)}}.*/
    }
    part def Event :> Observation {
        doc /* {{block(Observation)}} that is a discrete piece of information from a piece of equipment.
         */
        comment /* Description*/
        attribute resetTriggered [0..1] : Profile::DataTypes::ResetTriggeredEnum {
            doc 
            /* identifies when a reported value has been reset and what has caused that reset to occur for those {{block(DataItem)}} entities that may be periodically reset to an initial value.
             *
             * `resetTriggered` **MUST** only be provided for the specific occurrence of a {{block(DataItem)}} reported in the {{term(MTConnectStreams Response Document)}} when the reset occurred.*/
        }
        private ref part organizedByComponentStream : 'Observation Information Model'::ComponentStream;
        constant attribute type [1] :>> type : Profile::DataTypes::EventEnum;
        doc 
        /*
         * It provides the information and data reported from a piece of equipment for those {{block(DataItem)}} entities defined with {{property(DataItem::category)}} as `EVENT` in the {{term(MTConnectDevices Response Document)}}.
         *
         * {{figure(Event Example)}} shows {{block(Event)}} type examples. It also shows an example for when the {{property(Observation::result)}} is not available (`dataItemId`=`d1_asset_rem`).
         *
         * ![Event Example](figures/Event%20Example.png "Event Example"){: width="0.8"}
         *
         * > Note: See {{lst(event-example)}} for the {{term(XML)}} representation of the same example.
         *
         * The following {{sect(Value Properties of Event)}} lists the additional and/or updated attributes for {{block(Event)}}.*/
    }
    part def Condition :> Observation {
        doc 
        /* {{block(Observation)}} that provides the {{term(condition)}} of a piece of equipment or a {{term(Component)}}.
         *
         */
        comment /* Description*/
        attribute nativeCode [0..1] : Profile::DataTypes::string {
            doc /* native code is the proprietary identifier designating a specific alarm, fault or warning code provided by the piece of equipment.*/
        }
        attribute nativeSeverity [0..1] : Profile::DataTypes::string {
            doc /* severity information to a client software application if the piece of equipment designates a severity level to a fault.*/
        }
        attribute qualifier [0..1] : Profile::DataTypes::QualifierEnum {
            doc 
            /* additional information regarding a {{term(condition state)}} associated with the measured value of a process variable.
             *
             * {{property(Condition::qualifier)}} defines whether the {{term(condition state)}} represented indicates a measured value that is above or below an expected value of a process variable.*/
        }
        attribute statistic [0..1] : Profile::DataTypes::StatisticEnum {
            doc 
            /* {{property(Condition::statistic)}} provides additional information describing the meaning of the {{block(Condition)}} entity.
             *
             * {{property(Condition::statistic)}} **MUST** match the {{property(DataItem::statistic)}} defined in the {{term(MTConnectDevices Response Document)}}.*/
        }
        attribute 'xs:lang' [0..1] : Profile::DataTypes::xslang {
            doc 
            /* specifies the language of the {{property(Observation::result)}} returned for the {{block(Condition)}}. 
             *
             * See {{cite(IETF RFC 4646)}} (http://www.ietf.org/rfc/rfc4646.txt).*/
        }
        private ref part organizedByComponentStream : 'Observation Information Model'::ComponentStream;
        attribute 'state' [0..1] : Profile::DataTypes::ConditionStateEnum {
            doc /* {{term(condition state)}} of the piece of equipment or {{block(Component)}}.*/
        }
        constant attribute type [1] :>> type : Profile::DataTypes::ConditionEnum;
        attribute conditionId [1] : Profile::DataTypes::string {
            doc 
            /* identifier of an individual {{term(condition activation)}} provided by a piece of equipment.
             *
             * {{property(Condition::conditionId)}} **MUST** be unique for all concurrent {{termpl(condition activation)}}.
             *
             * {{property(Condition::conditionId)}} **MUST** be maintained for all state transitions related to the same {{term(condition activation)}}.
             *
             * Multiple {{property(Condition::conditionId)}}s **MAY** exist for the same {{property(nativeCode)}}.
             *
             * If {{property(Condition::conditionId)}} is not given, the value is the {{property(Condition::nativeCode)}}. If {{property(Condition::nativeCode)}} and {{property(Condition::conditionId)}} are not given, {{property(Condition::conditionId)}} **MUST** be generated.*/
        }
        doc 
        /* It provides the information and data reported from a piece of equipment with {{property(DataItem::category)}} as `CONDITION` in the {{term(MTConnectDevices Response Document)}}.
         *
         * {{figure(Condition Example)}} shows {{block(Condition)}} type examples for various {{property(Condition::state)}}: `Normal` (`dataItemId` = `path_system`) and `Warning` (`dataItemId` = `logic_cond`). It also shows an example for when the {{property(Condition::state)}} is not available (`dataItemId` = `cont_system`).
         *
         * ![Condition Example](figures/Condition%20Example.png "Condition Example"){: width="0.8"}
         *
         * > Note: See {{lst(condition-example)}} for the {{term(XML)}} representation of the same example.
         *
         * The following {{sect(Value Properties of Condition)}} lists the additional and/or updated attributes for {{block(Condition)}}.*/
    }
    doc 
    /* The {{term(Observation Information Model)}} provides a representation of the data reported by a piece of equipment used for a manufacturing process, or used for any other purpose.  Additional descriptive information associated with the reported data is defined by the {{block(MTConnectDevices)}} entity, which is described in {{package(Device Information Model)}}.
     *
     * Information defined in the {{term(Observation Information Model)}} allows a software application to (1) determine the {{termplural(Observation)}} for {{termplural(DataItem)}} returned from a piece of equipment and (2) interpret the data associated with those {{termplural(Observation)}} with the same meaning, value, and context that it had at its original source.  To do this, the software application issues one of two HTTP requests to an {{term(agent)}} associated with a piece of equipment.  They are:
     *
     * * `sample`:  Returns a designated number of time stamped {{termplural(Observation)}} from an {{term(agent)}} associated with a piece of equipment; subject to any HTTP filtering associated with the request.  See {{block(Agent)}} in {{package(Fundamentals)}} for details on the `sample` HTTP request.
     *
     * * `current`:  Returns a snapshot of either the most recent values or the values at a given sequence number for all {{termplural(Observation)}} associated with a piece of equipment from an {{term(agent)}}; subject to any HTTP filtering associated with the request.  See {{block(Agent)}} in {{package(Fundamentals)}} for details on the `current` HTTP request.
     *
     *
     * An {{term(agent)}} responds to either the `sample` or `current` HTTP request with an {{term(MTConnectStreams Response Document)}}.  This document contains information describing {{termplural(Observation)}} reported by an {{term(agent)}} associated with a piece of equipment.   A client software application may correlate the information provided in the {{term(MTConnectStreams Response Document)}} with the physical and logical structure for that piece of equipment defined in the {{block(MTConnectDevices)}} entity to form a clear and unambiguous understanding of the information provided.  (See details on the structure for a piece of equipment described in {{package(Device Information Model)}}).
     *
     * {{block(Streams)}} for an {{block(MTConnectStreams)}} entity contains a {{block(DeviceStream)}} entity for each piece of equipment represented in the document.  Each {{block(DeviceStream)}} is comprised of two primary types of entities – {{termplural(Component)}} and {{termplural(Observation)}}.  The contents of the {{block(DeviceStream)}} container are described in detail in this document, {{package(Observation Information Model)}} of the MTConnect Standard.
     *
     * {{termplural(Component)}} are defined for both the {{block(MTConnectDevices)}} and the {{block(MTConnectStreams)}} entities.  These {{termplural(Component)}} are used to provide a logical organization of the information provided in each entity.  
     *
     * * For an {{block(MTConnectDevices)}} entity: {{termplural(Component)}} organize information that represents the physical and logical parts and sub-parts of a piece of equipment.  (See {{block(Component)}} in {{package(Device Information Model)}} for more details on {{termplural(Component)}} used in the {{block(MTConnectDevices)}} entity).  
     *
     * * For an {{block(MTConnectStreams)}} entity: {{termplural(Component)}} provide the structure to organize the data returned from a piece of equipment and establishes the proper context for that data.  The {{termplural(Component)}} specifically defined for {{block(MTConnectStreams)}} are {{block(DeviceStream)}} (see {{sect(DeviceStream)}}) and {{block(ComponentStream)}} (see {{sect(ComponentStream)}}).   
     *
     * {{block(DeviceStream)}} and {{block(ComponentStream)}} entities have a direct correlation to each of the {{term(Component)}} defined in the {{block(MTConnectDevices)}} entity.
     *
     * Within each {{block(ComponentStream)}} entity in the {{block(MTConnectStreams)}} entity, {{termplural(Observation)}} are modeled as {{block(Observation)}} entities. The three types of {{block(Observation)}} entity are {{block(Sample)}}, {{block(Event)}}, and {{block(Condition)}}.  (See {{sect(Observation Types)}} for more information on these entities.)
     */
    comment /* Observations Appendix*/
    doc 
    /* {{newpage()}} 
     *
     * ## XML Schema Diagrams
     *
     * ### Observations Schema Diagrams
     *
     * See `Streams` element in `MTConnectStreams` schema.
     *
     * See `DeviceStream` element in `MTConnectStreams` schema.
     *
     * See `ComponentStream` element in `MTConnectStreams` schema.
     *
     * See `Sample` element in `MTConnectStreams` schema.
     *
     * See `Event` element in `MTConnectStreams` schema.
     *
     * See `Condition` element in `MTConnectStreams` schema.
     *
     * ### Representation Schema Diagrams
     *
     * See `AbsTimeSeries` element in `MTConnectStreams` schema.
     *
     * See `PartCountDiscrete` element in `MTConnectStreams` schema.
     *
     * See `VariableDataSet` element in `MTConnectStreams` schema.
     *
     * See `Entry` element in `MTConnectStreams` schema.
     *
     * See `WorkOffsetTable` element in `MTConnectStreams` schema.
     *
     * ## XML Examples
     *
     * ### DeviceStream Example
     *
     * ~~~~xml
     * <Streams>
     *   <DeviceStream name="M12346" uuid="M8010W4194N">
     *     <ComponentStream component="Device" name="M12346" componentId="d1">
     *       <Events>
     *         <Availability dataItemId="avail" sequence="156" timestamp="2021-10-01T14:26:38.668505Z">AVAILABLE</Availability>
     *         <AssetChanged assetType="CuttingTool" dataItemId="d1_asset_chg" sequence="75570" timestamp="2021-10-07T05:08:53.870206Z">M8010W4194N1.120</AssetChanged>
     *         <AssetRemoved assetType="CuttingTool" dataItemId="d1_asset_rem" sequence="140" timestamp="2021-10-01T11:40:08.101461Z">UNAVAILABLE</AssetRemoved>
     *       </Events>
     *     </ComponentStream>
     *     <ComponentStream component="Controller" name="controller" componentId="cont">
     *       <Events>
     *         <EmergencyStop dataItemId="estop" sequence="159" timestamp="2021-10-01T14:26:38.66869Z">ARMED</EmergencyStop>
     *       </Events>
     *       <Samples>
     *         <AccumulatedTime dataItemId="cut_time" sequence="75437" timestamp="2021-10-07T05:08:28.221704Z">1763070.0</AccumulatedTime>
     *       </Samples>
     *       <Condition>
     *         <Unavailable dataItemId="cont_system" sequence="72" timestamp="2021-10-11T21:04:03.251999Z" type="SYSTEM"/>
     *         <Warning dataItemId="cont_system" nativecode="313" nativeSeverity="50" sequence="75573" timestamp="2021-10-07T05:08:58.518317Z" type="LOGIC_PROGRAM">PALLET ARM DOWN RS. MALF.</Warning>
     *       </Condition>
     *     </ComponentStream>
     *     <ComponentStream component="Path" name="path" componentId="path1">
     *       <Events>
     *         <Execution dataItemId="execution" name="execution" sequence="222623" timestamp="2021-10-12T06:04:32.761198Z">INTERRUPTED</Execution>
     *         <VariableDataSet count="2" dataItemId="cvars" sequence="126513" timestamp="2021-10-12T03:57:31.106559Z">
     *           <Entry key="100">66.3314</Entry>
     *           <Entry key="101">167.2</Entry>
     *         </VariableDataSet>
     *         <WorkOffsetTable count="2" dataItemId="woffset" sequence="222101" timestamp="2021-10-12T06:04:11.990531Z">
     *           <Entry key="G53.1">
     *             <Cell key="X">1</Cell>
     *             <Cell key="Y">2</Cell>
     *             <Cell key="Z">3</Cell>
     *           </Entry>
     *           <Entry key="G53.2">
     *             <Cell key="X">4</Cell>
     *             <Cell key="Y">5</Cell>
     *             <Cell key="Z">6</Cell>
     *           </Entry>
     *         </WorkOffsetTable>
     *       </Events>
     *       <Samples>
     *         <CuttingSpeed dataItemId="cspeed" sequence="112" timestamp="2021-10-07T05:08:28.221704Z" subType="ACTUAL">UNAVAILABLE</CuttingSpeed>
     *       </Samples>
     *       <Condition>
     *         <Normal dataItemId="path_system" sequence="153" timestamp="2021-10-11T21:04:03.262845Z" type="SYSTEM"/>
     *       </Condition>
     *     </ComponentStream>
     *   </DeviceStream>
     * </Streams>
     * ~~~~
     * {: caption="DeviceStream Example"}
     *
     * ### Observations made for DataItem Example
     *
     * ~~~~xml
     * <Components>
     *   <Controller id="cont" name="controller">
     *       <DataItems>
     *       <DataItem category="EVENT" id="estop" name="estop" type="EMERGENCY_STOP"/>
     *     </DataItems>
     *   </Controller>
     * </Components>
     * ~~~~
     * {: caption="MTConnectDevices Response Document"}
     *
     * ~~~~xml
     * <ComponentStream component="Controller" name="controller" componentId="cont">
     *   <Events>
     *     <EmergencyStop dataItemId="estop" sequence="159" timestamp="2021-10-01T14:26:38.66869Z">ARMED</EmergencyStop>
     *   </Events>
     * </ComponentStream>
     * ~~~~
     * {: caption="MTConnectStreams Response Document"}
     *
     * ### Sample Example
     *
     * ~~~~xml
     * <Samples>
     *   <AccumulatedTime dataItemId="cut_time" sequence="75437" timestamp="2021-10-07T05:08:28.221704Z">1763070.0</AccumulatedTime>
     *   <CuttingSpeed dataItemId="cspeed" sequence="112" timestamp="2021-10-07T05:08:28.221704Z" subType="ACTUAL">UNAVAILABLE</CuttingSpeed>
     * </Samples>
     * ~~~~
     * {: caption="Sample Example"}
     *
     * ### Event Example
     *
     * ~~~~xml
     * <Events>
     *   <Availability dataItemId="avail" sequence="156" timestamp="2021-10-01T14:26:38.668505Z">AVAILABLE</Availability>
     *   <AssetRemoved assetType="CuttingTool" dataItemId="d1_asset_rem" sequence="140" timestamp="2021-10-01T11:40:08.101461Z">UNAVAILABLE</AssetRemoved>
     * </Events>
     * ~~~~
     * {: caption="Event Example"}
     *
     * ### Condition Example
     *
     * {{block(Condition)}} types are represented differently in {{term(XML)}} when compared to {{block(Sample)}} and {{block(Event)}} types. The element name is the {{term(condition state)}} of the {{block(Condition)}} type in Pascal Case. The name of the {{block(Condition)}} type is represented by the attribute `type`.
     *
     * If the {{term(condition state)}} is unavailable then the element name is represented by `Unavailable`.
     *
     * ~~~~xml
     * <Condition>
     *   <Unavailable dataItemId="cont_system" sequence="72" timestamp="2021-10-11T21:04:03.251999Z" type="SYSTEM"/>
     *   <Normal dataItemId="path_system" sequence="153" timestamp="2021-10-11T21:04:03.262845Z" type="SYSTEM"/>
     *   <Warning dataItemId="cont_system" nativecode="313" nativeSeverity="50" sequence="75573" timestamp="2021-10-07T05:08:58.518317Z" type="LOGIC_PROGRAM">PALLET ARM DOWN RS. MALF.</Warning>
     * </Condition>
     * ~~~~
     * {: caption="Condition Example"}
     *
     * ### DataSet Example
     *
     * ~~~~xml
     * <Events>
     *   <VariableDataSet count="2" dataItemId="cvars" sequence="126513" timestamp="2021-10-12T03:57:31.106559Z">
     *     <Entry key="100">66.3314</Entry>
     *     <Entry key="101">167.2</Entry>
     *   </VariableDataSet>
     * </Events>
     * ~~~~
     * {: caption="DataSet Example"}
     *
     * ### Table Example
     *
     * ~~~~xml
     * <Events>
     *   <WorkOffsetTable count="2" dataItemId="woffset" sequence="222101" timestamp="2021-10-12T06:04:11.990531Z">
     *     <Entry key="G53.1">
     *       <Cell key="X">1</Cell>
     *       <Cell key="Y">2</Cell>
     *       <Cell key="Z">3</Cell>
     *     </Entry>
     *     <Entry key="G53.2">
     *       <Cell key="X">4</Cell>
     *       <Cell key="Y">5</Cell>
     *       <Cell key="Z">6</Cell>
     *     </Entry>
     *   </WorkOffsetTable>
     * </Events>
     * ~~~~
     * {: caption="Table Example"}*/
}
package Glossary {
    connection def {
        end :>> Glossary::'Industrial Terms'::observation::'made for' : 'MTConnect Terms'::DataItem => 'has observation'.Glossary::'MTConnect Terms'::Observation::'made for';
        end :>> Glossary::'Industrial Terms'::observable::'has observation' : 'MTConnect Terms'::Observation => 'made for'.Glossary::'MTConnect Terms'::DataItem::'has observation';
    }
    dependency 
            from 'MTConnect Terms'::'Additional Observation Terms'::'Observed Event'
            to 'MTConnect Terms'::'Additional Observation Terms'::'Observed Condition';

    connection def {
        end 'made by' : 'Industrial Terms'::'engineered system' => 'made observation'.Glossary::'MTConnect Terms'::Observation::'made by';
        end 'made observation' : 'MTConnect Terms'::Observation => 'made by'.Glossary::'Industrial Terms'::'engineered system'::'made observation';
    }
    connection def 'made by' {
        end :>> Glossary::'Industrial Terms'::observation::'made by' : 'MTConnect Terms'::Component :> Glossary::'MTConnect Terms'::Observation::'made by' => target.Glossary::'MTConnect Terms'::Observation::'made by';
        private end : 'MTConnect Terms'::Observation;
    }
    dependency from 'MTConnect Terms'::Observation to 'MTConnect Terms'::Component;
    occurrence def adapter :> application {
        doc /* optional piece of hardware or software that transforms information provided by a piece of equipment into a form that can be received by an {{term(agent)}}.*/
    }
    occurrence def agent :> application {
        doc /* software that collects data published from one or more piece(s) of equipment, organizes that data in a structured manner, and responds to requests for data from client software systems by providing a structured response in the form of a {{term(response document)}} that is constructed using the {{term(semantic data model)}} of a Standard. 
         */
    }
    occurrence def 'alarm limit' {
        doc /* limit used to trigger warning or alarm indicators.*/
    }
    occurrence def application {
        doc 
        /* software or a program that is specific to the solution of an application problem.
         * {{cite(ISO/IEC 20944-1:2013)}}*/
    }
    occurrence def archetype :> 'Industrial Terms'::asset {
        doc /* {{term(archetype)}} provides the requirements, constraints, and common properties for a type of {{term(Asset)}}.*/
    }
    occurrence def 'asset buffer' {
        doc /* {{term(buffer)}} for {{termplural(Asset)}}.*/
    }
    occurrence def attachment {
        doc /* connection by which one thing is associated with another.*/
    }
    occurrence def buffer {
        doc /* section of an {{term(agent)}} that provides storage for information published from pieces of equipment.*/
    }
    occurrence def client :> application {
        doc 
        /* {{term(application)}} that sends {{term(request)}} for information to an {{term(agent)}}.
         *
         * > Note: Examples include software applications or a function that implements the {{term(request)}} portion of an {{term(interface)}} {{term(interaction model)}}.
         *
         */
    }
    occurrence def 'controlled vocabulary' {
        doc /* restricted set of values for a given property.*/
    }
    occurrence def 'data dictionary' {
        doc /* listing of standardized terms and definitions used in {{term(MTConnect Information Model)}}.*/
    }
    occurrence def 'data model' {
        doc /* organizes elements of data and standardizes how they relate to one another and to the properties of real-world entities.*/
    }
    occurrence def 'data set' {
        doc /* {{termplural(key-value pair)}} where each entry is uniquely identified by the {{term(key)}}.*/
    }
    occurrence def 'data source' {
        doc /* piece of equipment that can produce data that is published to an {{term(agent)}}.
         */
    }
    occurrence def deprecated {
        doc /* indication that specific content in an {{term(MTConnect Document)}} is currently usable but is regarded as being obsolete or superseded. */
    }
    occurrence def 'deprecation warning' {
        doc /* indication that specific content in an {{term(MTConnect Document)}} may be changed to {{term(deprecated)}} in a future release of the standard.*/
    }
    occurrence def document {
        doc /* piece of written, printed, or electronic matter that provides information or evidence that serves as an official record.*/
    }
    occurrence def 'electric current' {
        doc /* rate of flow of electric charge.*/
    }
    occurrence def extensible {
        doc /* ability for an implementer to extend {{term(MTConnect Information Model)}} by adding content not currently addressed in the MTConnect Standard.
         */
    }
    occurrence def force {
        doc /* push or pull on a mass which results in an acceleration.*/
    }
    occurrence def implementation {
        doc /* specific instantiation of the MTConnect Standard.*/
    }
    occurrence def 'information model' {
        doc /* rules, relationships, and terminology that are used to define how information is structured.*/
    }
    occurrence def instance {
        doc /* describes a set of {{term(streaming data)}} in an {{term(agent)}}.  Each time an {{term(agent)}} is restarted with an empty {{term(buffer)}}, data placed in the {{term(buffer)}} represents a new {{term(instance)}} of the {{term(agent)}}.*/
    }
    occurrence def 'interaction model' {
        doc /* model that defines how information is exchanged across an {{term(interface)}} to enable interactions between independent systems.*/
    }
    occurrence def 'interface' {
        doc /* means by which communication is achieved between independent systems.*/
    }
    occurrence def key {
        doc /* unique identifier in a {{term(key-value pair)}} association.*/
    }
    occurrence def 'key-value pair' {
        doc /* association between an identifier referred to as the {{term(key)}} and a value which taken together create a {{term(key-value pair)}}. */
    }
    occurrence def 'lower camel case' {
        doc /* first word is lowercase and the remaining words are capitalized and all spaces between words are removed.*/
    }
    occurrence def 'lower limit' {
        doc /* lower conformance boundary for a variable.*/
    }
    occurrence def 'lower warning' {
        doc /* lower boundary indicating increased concern and supervision may be required.*/
    }
    occurrence def major {
        doc /* identifier representing a consistent set of functionalities defined by the MTConnect Standard.*/
    }
    occurrence def maximum {
        doc /* numeric upper constraint.*/
    }
    occurrence def 'message' {
        doc /* communication in writing, in speech, or by signals.*/
    }
    occurrence def 'metadata' {
        doc 
        /* data that provides information about other data.
         *
         */
    }
    occurrence def minimum {
        doc /* numeric lower constraint.*/
    }
    occurrence def minor {
        doc /* identifier representing a specific set of functionalities defined by the MTConnect Standard.*/
    }
    occurrence def nominal {
        doc /* ideal or desired value for a variable.*/
    }
    occurrence def organize {
        doc /* act of containing and owning one or more elements.*/
    }
    occurrence def organizer {
        doc /* entity that {{termplural(organize)}} one or more elements.*/
    }
    occurrence def parameter {
        doc /* variable that must be given a value during the execution of a program or a communications command.*/
    }
    occurrence def 'part' {
        doc /* discrete item that has both defined and measurable physical characteristics including mass, material, and features, and is created by applying one or more manufacturing process steps to material*/
    }
    occurrence def 'pascal case' {
        doc /* first letter of each word is capitalized and the remaining letters are in lowercase. All space is removed between letters*/
    }
    occurrence def persistence {
        doc /* method for retaining or restoring information.*/
    }
    occurrence def requester {
        doc /* entity that initiates a {{term(request)}} for information in a communications exchange.*/
    }
    occurrence def reset {
        doc 
        /* act of reverting back the accumulated value or statistic to their initial value.
         *
         * > Note: An {{term(Observation)}} with a {{term(data set)}} representation removes all {{termplural(key-value pair)}}, setting the {{term(data set)}} to an empty set.
         *
         */
    }
    occurrence def responder {
        doc /* entity that responds to a {{term(request)}} for information in a communications exchange.*/
    }
    occurrence def 'response document' :> 'Protocol Terms'::'MTConnect Response Document' {
        doc /* electronic {{term(document)}} published by an {{term(MTConnect Agent)}} in response to a {{term(probe request)}}, {{term(current request)}}, {{term(sample request)}} or {{term(asset request)}}.*/
    }
    occurrence def patch {
        doc /* supplemental identifier representing only organizational or editorial changes to a {{term(minor)}} version document with no changes in the functionality described in that document.*/
    }
    occurrence def schema {
        doc /* definition of the structure, rules, and vocabularies used to define the information published in an electronic document.*/
    }
    occurrence def 'semantic data model' {
        doc /* methodology for defining the structure and meaning for data in a specific logical way that can be interpreted by a software system. */
    }
    occurrence def 'sensing element' {
        doc /* mechanism that provides a signal or measured value.*/
    }
    occurrence def 'sequence number' {
        doc /* primary key identifier used to manage and locate a specific piece of {{term(streaming data)}} in an {{term(agent)}}.*/
    }
    occurrence def 'specification limit' {
        doc /* limit defining a range of values designating acceptable performance for a variable.*/
    }
    occurrence def spindle {
        doc 
        /* mechanism that provides rotational capabilities to a piece of equipment. 
         *
         * > Note: Typically used for either work holding, materials or cutting tools.
         *
         */
    }
    occurrence def 'standard' {
        doc /* {{term(document)}} established by consensus that provides rules, guidelines, or characteristics for activities or their results.. {{cite(ISO/IEC Guide 2:2004)}}*/
    }
    occurrence def subtype {
        doc /* secondary or subordinate type of categorization or classification of information.*/
    }
    occurrence def table {
        doc /* two dimensional set of values given by a set of {{termplural(key-value pair)}} {{termplural(table entry)}}. */
    }
    occurrence def 'table cell' {
        doc /* subdivision of a {{term(table entry)}} representing a singular value.*/
    }
    occurrence def 'table entry' {
        doc /* subdivision of a {{term(table)}} containing a set of {{termplural(key-value pair)}} representing {{termplural(table cell)}}.*/
    }
    occurrence def type {
        doc /* classification or categorization of information.*/
    }
    occurrence def 'upper limit' {
        doc /* upper conformance boundary for a variable.*/
    }
    occurrence def 'upper warning' {
        doc /* upper boundary indicating increased concern and supervision may be required.*/
