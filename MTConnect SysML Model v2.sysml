                doc /* scope is missing a property or a part.*/
            }
            DEPRECATED {
                doc /* scope has been deprecated.*/
            }
            EXTENDED {
                doc /* scope is considered an extension of the MTConnect Standard.*/
            }
            OUT_OF_RANGE {
                doc /* scope is not within the expected range.*/
            }
            DUPLICATE_ENTRY {
                doc /* scope is a duplicate or has duplicate properties or parts.*/
            }
            INVALID_FORMAT {
                doc /* scope has either an invalid format or does not conform to the expected pattern.*/
            }
        }
        enum def SeverityEnum {
            FATAL {
                doc /* exception violates compliance with the MTConnect Standard and validation can no longer continue.*/
            }
            ERROR {
                doc /* exception violates compliance with the MTConnect Standard.*/
            }
            WARNING {
                doc /* exception **MAY** violate compliance with the MTConnect Standard.*/
            }
            INFO {
                doc /* exception is considered informative.*/
            }
        }
        enum def TaskStateEnum {
            INACTIVE {
                doc /* default state when the task is created and any collaborators are yet to bind to the task*/
            }
            PREPARING {
                doc /* task state when a collaborator is ready and binds itself to the task*/
            }
            COMMITTING {
                doc /* task state when all collaborators indicate that they can participate by binding to the task*/
            }
            COMMITTED {
                doc /* task state when all collaborators commit to the task*/
            }
            COMPLETE {
                doc /* task state when collaborators successfully implement the task*/
            }
            FAIL {
                doc /* task state when collaborators are unsuccessful in implementing the task*/
            }
        }
        enum def BindingStateEnum {
            INACTIVE {
                doc /* default state when the collaborator is yet to bind to a task*/
            }
            PREPARING {
                doc /* state when a collaborator is ready and expresses interest in all tasks that require its capability*/
            }
            COMMITTED {
                doc /* state when a collaborator has successfully bound itself to a task*/
            }
        }
        enum def PartIdentifierEnum {
            UNIQUE_IDENTIFIER {
                doc /* unique serialized part identifier.*/
            }
            GROUP_IDENTIFIER {
                doc /* identifier for a group of parts or a piece of raw material that will be transformed into multiple parts*/
            }
        }
        doc /**/
    }
    package Stereotypes {
        occurrence def organizer {
            doc /* element that {{termplural(organize)}} other elements of a type.*/
            private ref occurrence base_Element;
        }
        occurrence def deprecated {
            doc /* element that has been deprecated.*/
            private ref occurrence base_Element;
            private attribute version : DataTypes::string {
                doc /* version the element was deprecated in the standard.*/
            }
        }
        occurrence def extensible {
            doc /* enumeration that can be extended.*/
            private ref occurrence base_Enumeration;
        }
        occurrence def informative {
            doc /* element that is descriptive and non-normative.*/
            private ref occurrence base_Element;
        }
        occurrence def normative {
            doc /* element that has been added to the standard.*/
            private attribute introduced [1] : DataTypes::string {
                doc /* version the element was added to the standard.*/
            }
            private attribute updated [0..*] : DataTypes::string {
                doc /* version(s) the element was updated in the standard.*/
            }
            private attribute deprecated [0..1] : DataTypes::string {
                doc /* version the element was deprecated in the standard.*/
            }
        }
        occurrence def observes {
            doc /* association in which a {{term(Component)}} makes {{termplural(Observation)}} about an observable {{term(DataItem)}}.*/
            private ref occurrence base_Association;
        }
        occurrence def satisfiedBy {
            private ref occurrence base_InstanceSpecification;
            private ref occurrence satisfiedBy [0..*];
            private ref occurrence base_UseCase;
        }
        occurrence def ImplementationFormat {
            doc /* element that has format specific representation that might be different from the element's SysML representation.*/
            private ref occurrence base_Element;
            private attribute xml [0..1] : DataTypes::string;
            private attribute json [0..1] : DataTypes::string;
        }
        occurrence def valueType {
            doc /* extends `Class`to be used as a SysML `<<ValueType>>`.*/
            private ref occurrence base_Element;
        }
        occurrence def isArray {
            doc /* datatype that is an array.*/
            private attribute size [1] : DataTypes::integer;
            private ref occurrence type [0..1];
            private ref occurrence base_DataType;
        }
        occurrence def 'MTConnect Requirement' {
            private ref occurrence base_Element;
            private attribute redmine_issue [0..*] : DataTypes::string;
            private attribute simple_requirement [0..1] : DataTypes::string;
            private attribute semantic_requirement [0..1] : DataTypes::string;
        }
    }
    doc /* MTConnect Profile is a {{term(profile)}} that extends the {{term(SysML)}} metamodel for the MTConnect domain using additional data types and {{termplural(stereotype)}}.*/
}
package 'Asset Information Model' {
    abstract part def Asset :> Glossary::'MTConnect Terms'::Asset {
        doc /* abstract {{term(Asset)}}. */
        comment /* Description*/
        attribute assetId [1] : Profile::DataTypes::ID {
            doc /* unique identifier for an {{block(Asset)}}.*/
        }
        attribute deviceUuid [0..1] : Profile::DataTypes::UUID {
            doc 
            /* associated piece of equipment's {{term(UUID)}} that supplied the {{block(Asset)}}'s data.
             *
             * It references to {{property(Device::uuid)}} defined in {{package(Device Information Model)}}.*/
        }
        attribute removed [0..1] : Profile::DataTypes::boolean {
            doc /* indicator that the {{block(Asset)}} has been removed from the piece of equipment.*/
        }
        attribute timestamp [1] : Profile::DataTypes::datetime {
            doc /* time the {{block(Asset)}} data was last modified.*/
        }
        part hasConfiguration [0..1] : 'Device Information Model'::Configurations::Configuration;
        attribute hash [0..1] : Profile::DataTypes::string {
            doc /* condensed message digest from a secure one-way hash function. {{cite(FIPS PUB 180-4)}}*/
        }
        private attribute Description [0..1] : Profile::DataTypes::string {
            doc /* textual description for {{block(Asset)}}.*/
        }
        private attribute manufacturers [0..*] : Profile::DataTypes::string;
        private attribute model [0..1] : Profile::DataTypes::string;
        private attribute serialNumber [0..1] : Profile::DataTypes::string;
        private attribute station [0..1] : Profile::DataTypes::string;
        doc 
        /* It is used in the manufacturing process, but is not permanently associated with a single piece of equipment. It can be removed from the piece of equipment without compromising its function, and can be associated with other pieces of equipment during its lifecycle.
         *
         *
         * ![Asset](figures/Asset.png "Asset"){: width="0.8"}
         *
         * > Note: See {{sect(Assets Schema Diagrams)}} for XML schema.*/
    }
    connection def Assets {
        end hasAsset : Asset => target.hasAsset;
        doc /* {{block(Assets)}} groups one or more {{block(Asset)}} types. See {{package(Asset Information Model)}} for more details.*/
        end : Fundamentals::'MTConnect Protocol'::'MTConnectAssets Response Document'::MTConnectAssets;
    }
    package 'Cutting Tool' {
        part def CuttingTool :> Asset {
            doc /* {{block(Asset)}} that physically removes the material from the workpiece by shear deformation.*/
            attribute serialNumber [1] :>> 'Asset Information Model'::Asset::serialNumber : Profile::DataTypes::string {
                doc /* unique identifier for this assembly.*/
            }
            attribute toolId [1] : Profile::DataTypes::string {
                doc /* identifier for a class of cutting tools.*/
            }
            part hasCuttingToolLifeCycle [0..1] : 'Cutting Tool Life Cycle'::CuttingToolLifeCycle;
            part hasCuttingToolArchetypeReference [0..1] : 'Asset Information Model'::'Cutting Tool'::CuttingToolArchetypeReference;
            part hasCuttingToolDefinition [0..1] : 'Asset Information Model'::'Cutting Tool'::CuttingToolDefinition {
                doc /**/
            }
        }
        connection def CuttingToolLifeCycle {
            end hasCuttingToolLifeCycle : 'Cutting Tool Life Cycle'::CuttingToolLifeCycle => target.hasCuttingToolLifeCycle;
            doc /* See {{sect(CuttingToolLifeCycle)}}.*/
            end : CuttingTool;
        }
        connection def CuttingToolArchetypeReference {
            end hasCuttingToolArchetypeReference : 'Asset Information Model'::'Cutting Tool'::CuttingToolArchetypeReference => target.hasCuttingToolArchetypeReference;
            end : CuttingTool;
        }
        connection def CuttingToolDefinition {
            end hasCuttingToolDefinition : 'Asset Information Model'::'Cutting Tool'::CuttingToolDefinition => target.hasCuttingToolDefinition;
            doc /* **DEPRECATED** in *Version 1.3.0* for {{block(CuttingTool)}}.*/
            end : CuttingTool;
        }
        part def CuttingToolArchetype :> Asset {
            doc /* {{block(Asset)}} that describes the static cutting tool geometries and nominal values as one would expect from a tool catalog.*/
            attribute serialNumber [1] :>> 'Asset Information Model'::Asset::serialNumber : Profile::DataTypes::string {
                doc /* unique identifier for this assembly.*/
            }
            attribute toolId [1] : Profile::DataTypes::string {
                doc /* identifier for a class of cutting tools.*/
            }
            part hasCuttingToolDefinition [0..1] : 'Asset Information Model'::'Cutting Tool'::CuttingToolDefinition;
            part hasCuttingToolLifeCycle [0..1] : 'Cutting Tool Life Cycle'::CuttingToolLifeCycle;
        }
        connection def CuttingToolDefinition {
            end hasCuttingToolDefinition : 'Asset Information Model'::'Cutting Tool'::CuttingToolDefinition => target.hasCuttingToolDefinition;
            doc /* **DEPRECATED** in *Version 2.1.0* for {{block(CuttingToolArchetype)}}.*/
            end : CuttingToolArchetype;
        }
        connection def CuttingToolLifeCycle {
            end hasCuttingToolLifeCycle : 'Cutting Tool Life Cycle'::CuttingToolLifeCycle => target.hasCuttingToolLifeCycle;
            doc /* See {{sect(CuttingToolLifeCycle)}}.*/
            end : CuttingToolArchetype;
        }
        part def CuttingToolArchetypeReference {
            doc /* reference information about the {{property(Asset::assetId)}} and/or the URL of the data source of {{block(CuttingToolArchetype)}}.*/
            attribute source [0..1] : Profile::DataTypes::string {
                doc /* {{term(URL)}} of the {{block(CuttingToolArchetype)}} {{term(information model)}}.*/
            }
            attribute value [0..1] : Profile::DataTypes::ID {
                doc /* `assetId` of the related {{block(CuttingToolArchetype)}}.*/
            }
        }
        part def CuttingToolDefinition {
            doc /* detailed structure of the cutting tool which is static during its lifecycle. {{cite(ISO 13399)}}.*/
            attribute format [0..1] : Profile::DataTypes::FormatTypeEnum default format::XML {
                doc /* identifies the expected representation of the enclosed data.*/
            }
            attribute value [0..*] : Profile::DataTypes::string {
                doc /* text of the {{block(CuttingToolDefinition)}} in format defined by {{property(CuttingToolDefinition::format)}}.*/
            }
        }
        connection def CutterStatus {
            end hasCutterStatus : 'Cutting Tool Life Cycle'::Status => target.hasCutterStatus;
            doc 
            /* {{block(CutterStatus)}} provides the status of the assembly and {{term(organize)}} one or more {{block(Status)}} entities. See {{sect(Status)}}.
             *
             * The following combinations of {{block(Status)}} entities **MUST NOT** occur for a {{block(CutterStatus)}}:
             *
             * * `NEW` **MUST NOT** be used with `USED`, `RECONDITIONED`, or `EXPIRED`.
             *
             * * `UNKNOWN` **MUST NOT** be used with any other status.
             *
             * * `ALLOCATED` and `UNALLOCATED` **MUST NOT** be used together.
             *
             * * `AVAILABLE` and `UNAVAILABLE` **MUST NOT** be used together.
             *
             * * If the tool is `EXPIRED`, `BROKEN`, or `NOT_REGISTERED` it **MUST NOT** be `AVAILABLE`.
             *
             * {{block(CutterStatus)}} **MUST** be defined only for the {{block(CuttingToolLifeCycle)}} of {{block(CuttingTool)}} and **MUST NOT** be defined for the {{block(CuttingToolLifeCycle)}} of {{block(CuttingToolArchetype)}}.*/
            end : 'Cutting Item'::CuttingItem;
        }
        package 'Cutting Item' {
            part def CuttingItem {
                doc /* part of of the tool that physically removes the material from the workpiece by shear deformation.*/
                attribute Description [0..1] : Profile::DataTypes::string {
                    doc /* free-form description of the cutting item.*/
                }
                attribute grade [0..1] : Profile::DataTypes::string {
                    doc /* material composition for this cutting item.*/
                }
                attribute indices [1..*] : Profile::DataTypes::string {
                    doc 
                    /* number or numbers representing the individual cutting item or items on the tool.
                     *
                     * Indices **SHOULD** start numbering with the inserts or {{block(CuttingItem)}} furthest from the gauge line and increasing in value as the items get closer to the gauge line. Items at the same distance **MAY** be arbitrarily numbered.
                     *
                     * > Note: In {{term(XML)}}, the representation **MUST** be a single number ("1") or a comma separated set of individual elements ("1,2,3,4"), or as a inclusive range of values as in ("1-10") or any combination of ranges and numbers as in "1-4,6-10,22". There **MUST NOT** be spaces or non-integer values in the text representation.*/
                }
                attribute itemId [0..1] : Profile::DataTypes::ID {
                    doc /* manufacturer identifier of this cutting item.*/
                }
                attribute Locus [0..1] : Profile::DataTypes::string {
                    doc 
                    /* free form description of the location on the cutting tool.
                     *
                     * For clarity, the words `FLUTE`, `INSERT`, and `CARTRIDGE` **SHOULD** be used to assist in noting the location of a {{block(CuttingItem)}}. {{property(CuttingItem::Locus)}} **MAY** be any free form string, but **SHOULD** adhere to the following rules:
                     *
                     * * The location numbering **SHOULD** start at the furthest {{block(CuttingItem)}} and work it’s way back to the {{block(CuttingItem)}} closest to the gauge line.
                     *
                     * * Flutes **SHOULD** be identified as such using the word `FLUTE`:. For example: `FLUTE`: 1, `INSERT`: 2 - would indicate the first flute and the second furthest insert from the end of the tool on that flute.
                     *
                     * * Other designations such as `CARTRIDGE` **MAY** be included, but should be identified using upper case and followed by a colon (:).*/
                }
                attribute manufacturers [0..*] : Profile::DataTypes::string {
                    doc 
                    /* manufacturers of the cutting item.
                     *
                     * This will reference the tool item and adaptive items specifically. The cutting items
                     * manufacturers’ will be a property of {{block(CuttingItem)}}.
                     *
                     * > Note: In {{term(XML)}}, the representation **MUST** be a comma(,) delimited list of manufacturer names. See {{sect(CuttingItem Schema Diagrams)}}.*/
                }
                attribute ProgramToolGroup [0..1] : Profile::DataTypes::string {
                    doc /* tool group this item is assigned in the part program.*/
                }
                part hasCutterStatus [1..*] : 'Cutting Tool Life Cycle'::Status;
                part hasItemLife [0..3] : 'Asset Information Model'::'Cutting Tool'::'Cutting Item'::ItemLife {
                    doc /* The tool life measured in tool wear.*/
                }
                part hasMeasurement [0..*] : 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* A collection of measurements relating to this cutting item.*/
                }
            }
            connection def ItemLife {
                end hasItemLife : 'Asset Information Model'::'Cutting Tool'::'Cutting Item'::ItemLife => target.hasItemLife;
                doc /* See {{sect(ItemLife)}}.*/
                end : CuttingItem;
            }
            connection def CuttingItems {
                end hasCuttingItem : CuttingItem => target.hasCuttingItem;
                doc /* {{block(CuttingItems)}} groups one or more {{block(CuttingItem)}} entities. See {{sect(CuttingItem)}} and {{package(Cutting Item)}} for more detail.*/
                private end : 'Cutting Tool Life Cycle'::CuttingToolLifeCycle;
                attribute count [1] : Profile::DataTypes::integer {
                    doc /* number of {{block(CuttingItem)}} organized by {{block(CuttingItems)}}.*/
                }
                part [0..*] : CuttingItem;
                part : 'Cutting Tool Life Cycle'::CuttingToolLifeCycle;
            }
            part def ItemLife {
                doc /* life of a {{block(CuttingItem)}}.*/
                attribute countDirection [1] : Profile::DataTypes::CountDirectionTypeEnum {
                    doc /* indicates if the item life counts from zero to maximum or maximum to zero.*/
                }
                attribute initial [0..1] : Profile::DataTypes::float {
                    doc /* initial life of the item when it is new.*/
                }
                attribute limit [0..1] : Profile::DataTypes::float {
                    doc /* end of life limit for this item.*/
                }
                attribute type [1] : Profile::DataTypes::ToolLifeEnum {
                    doc /* type of item life being accumulated.*/
                }
                attribute warning [0..1] : Profile::DataTypes::float {
                    doc /* point at which a item life warning will be raised.*/
                }
                attribute value [1] : Profile::DataTypes::float {
                    doc /* value of {{block(ItemLife)}}.*/
                }
            }
            connection def Measurements {
                end hasMeasurement : 'Cutting Tool Life Cycle'::ToolingMeasurement => target.hasMeasurement;
                doc /* {{block(Measurements)}} groups one or more {{block(Measurement)}} subtypes. See {{sect(Measurement)}}.*/
                private end : CuttingItem;
            }
            package 'Cutting Item Measurement Subtypes' {
                part def FunctionalLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc 
                    /* distance from the gauge plane or from the end of the shank of the cutting tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. 
                     *
                     * This measurement will be with reference to the cutting tool and **MUST NOT** exist without a cutting tool.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::LFx;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def CuttingReferencePoint :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* theoretical sharp point of the cutting tool from which the major functional dimensions are taken.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::CRP;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def CuttingEdgeLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* theoretical length of the cutting edge of a cutting item over sharp corners.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::L;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def DriveAngle :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* angle between the driving mechanism locator on a tool item and the main cutting edge.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::DRVA;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::DEGREE;
                }
                part def FlangeDiameter :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* dimension between two parallel tangents on the outside edge of a flange.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::DF;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def FunctionalWidth :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* distance between the cutting reference point and the rear backing surface of a turning tool or the axis of a boring bar.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::WF;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def IncribedCircleDiameter :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* diameter of a circle to which all edges of a equilateral and round regular insert are tangential.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::IC;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def PointAngle :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* angle between the major cutting edge and the same cutting edge rotated by 180 degrees about the tool axis.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::SIG;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::DEGREE;
                }
                part def ToolCuttingEdgeAngle :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* angle between the tool cutting edge plane and the tool feed plane measured in a plane parallel the xy-plane.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::KAPR;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::DEGREE;
                }
                part def ToolLeadAngle :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* angle between the tool cutting edge plane and a plane perpendicular to the tool feed plane measured in a plane parallel the xy-plane.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::PSIR;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::DEGREE;
                }
                part def ToolOrientation :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc 
                    /* angle of the tool with respect to the workpiece for a given process. 
                     *
                     * The value is application specific.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::'N/A';
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::DEGREE;
                }
                part def StepDiameterLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* length of a portion of a stepped tool that is related to a corresponding cutting diameter measured from the cutting reference point of that cutting diameter to the point on the next cutting edge at which the diameter starts to change.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::SDLx;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def StepIncludedAngle :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* angle between a major edge on a step of a stepped tool and the same cutting edge rotated 180 degrees about its tool axis.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::STAx;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::DEGREE;
                }
                part def WiperEdgeLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* measure of the length of a wiper edge of a cutting item.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::BS;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def CuttingDiameter :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc 
                    /* diameter of a circle on which the defined point Pk located on this cutting tool. 
                     *
                     * The normal of the machined peripheral surface points towards the axis of the cutting tool.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::DCx;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def CuttingHeight :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* distance from the basal plane of the tool item to the cutting point.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::HF;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def CornerRadius :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* nominal radius of a rounded corner measured in the X Y-plane.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::RE;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def Weight :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc 
                    /* total weight of the cutting tool in grams. 
                     *
                     * The force exerted by the mass of the cutting tool.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::WT;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::__unnamed1() {
                        calc __unnamed1 {
                            rep language "English" /* GRAM*/
                        }
                    }
                }
                part def ChamferFlatLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* flat length of a chamfer.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::BCH;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def ChamferWidth :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* width of the chamfer.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::CHW;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                part def InsertWidth :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                    doc /* W1 is used for the insert width when an inscribed circle diameter is not practical.*/
                    attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::W1;
                    attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
                }
                doc 
                /* This section lists the {{block(Measurement)}} subtypes for {{block(CuttingItem)}}.
                 *
                 * These {{block(Measurement)}} subtypes for {{block(CuttingItem)}} are specific to an individual {{block(CuttingItem)}} and **MUST NOT** be used for the {{block(Measurement)}} pertaining to an assembly. Figures below will be used to for reference for the {{block(CuttingItem)}} specific {{block(Measurement)}} types.
                 *
                 * ![Cutting Tool](figures/Cutting%20Tool.png "Cutting Tool"){: width="0.8"}
                 *
                 * ![Cutting Item](figures/Cutting%20Item.png "Cutting Item"){: width="0.8"}
                 *
                 * ![Cutting Item Measurement](figures/Cutting%20Item%20Measurement.png "Cutting Item Measurement"){: width="0.8"}
                 *
                 * ![Cutting Item Drive Angle](figures/Cutting%20Item%20Drive%20Angle.png "Cutting Item Drive Angle"){: width="0.8"}*/
            }
            doc 
            /* A {{block(CuttingItem)}} is the portion of the tool that physically removes the material from the workpiece by shear deformation. The cutting item can be either a single piece of material attached to the {{block(CuttingTool)}} or it can be one or more separate pieces of material attached to the {{block(CuttingTool)}} using a permanent or removable attachment.  A {{block(CuttingItem)}} can be comprised of one or more cutting edges. Cutting items include: replaceable inserts, brazed tips and the cutting portions of solid {{block(CuttingTools)}}.
             *
             * MTConnect Standard considers {{block(CuttingItems)}} as part of the {{block(CuttingTool)}}.  A {{block(CuttingItems)}} **MUST NOT** exist in MTConnect unless it is attached to a {{block(CuttingTool)}}.  Some of the measurements, such as {{block(FunctionalLength)}}, **MUST** be made with reference to the entire {{block(CuttingTool)}} to be meaningful.
             *
             * ![CuttingItem](figures/CuttingItem.png "CuttingItem"){: width="0.8"}
             *
             * > Note: See {{sect(CuttingItem Schema Diagrams)}} for XML schema.*/
        }
        package 'Cutting Tool Measurement Subtypes' {
            part def BodyDiameterMax :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* largest diameter of the body of a tool item.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::BDX;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def BodyLengthMax :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* distance measured along the X axis from that point of the item closest to the workpiece, including the cutting item for a tool item but excluding a protruding locking mechanism for an adaptive item, to either the front of the flange on a flanged body or the beginning of the connection interface feature on the machine side for cylindrical or prismatic shanks.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::LBX;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def DepthOfCutMax :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* maximum engagement of the cutting edge or edges with the workpiece measured perpendicular to the feed motion.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::APMX;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def CuttingDiameterMax :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc 
                /* maximum diameter of a circle on which the defined point Pk of each of the master inserts is located on a tool item. 
                 *
                 * The normal of the machined peripheral surface points towards the axis of the cutting tool.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::DC;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def FlangeDiameterMax :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* dimension between two parallel tangents on the outside edge of a flange.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::DF;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def OverallToolLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* largest length dimension of the cutting tool including the master insert where applicable.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::OAL;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def ShankDiameter :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* dimension of the diameter of a cylindrical portion of a tool item or an adaptive item that can participate in a connection.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::DMM;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def ShankHeight :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* dimension of the height of the shank.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::H;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def ShankLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* dimension of the length of the shank.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::LS;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def UsableLengthMax :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* maximum length of a cutting tool that can be used in a particular cutting operation including the non-cutting portions of the tool.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::LUX;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def ProtrudingLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc /* dimension from the yz-plane to the furthest point of the tool item or adaptive item measured in the -X direction.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::LPR;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def FunctionalLength :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc 
                /* distance from the gauge plane or from the end of the shank to the furthest point on the tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool.
                 *
                 * The {{block(CuttingTool)}} functional length will be the length of the entire tool, not a single cutting item. Each {{block(CuttingItem)}} can have an independent {{block(FunctionalLength)}} represented in its measurements. */
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::LF;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::MILLIMETER;
            }
            part def Weight :> 'Cutting Tool Life Cycle'::ToolingMeasurement {
                doc 
                /* total weight of the cutting tool in grams. 
                 *
                 * The force exerted by the mass of the cutting tool.*/
                attribute code [1] :>> code : Profile::DataTypes::CodeEnum default code::WT;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum default units::__unnamed2() {
                    calc __unnamed2 {
                        rep language "English" /* GRAM*/
                    }
                }
            }
            doc 
            /* This section lists the {{block(Measurement)}} subtypes for {{block(CuttingTool)}}.
             *
             * These {{block(Measurement)}} subtypes for {{block(CuttingTool)}} are specific to the entire assembly and **MUST NOT** be used for the {{block(Measurement)}} pertaining to a {{block(CuttingItem)}}. {{figure(Cutting Tool Measurement 1)}} and {{figure(Cutting Tool Measurement 2)}} will be used to reference the assembly specific {{block(Measurement)}} subtypes.
             *
             * ![Cutting Tool Measurement 1](figures/Cutting%20Tool%20Measurement%201.png "Cutting Tool Measurement 1"){: width="0.8"}
             *
             * ![Cutting Tool Measurement 2](figures/Cutting%20Tool%20Measurement%202.png "Cutting Tool Measurement 2"){: width="0.8"}
             */
        }
        package 'Cutting Tool Life Cycle' {
            part def CuttingToolLifeCycle {
                doc 
                /* data regarding the application or use of the tool.
                 *
                 * This data is provided by various pieces of equipment (i.e. machine tool, presetter) and statistical process control applications. Life cycle data will not remain static, but will change periodically when a tool is used or measured.*/
                attribute ConnectionCodeMachineSide [0..1] : Profile::DataTypes::string {
                    doc /* identifier for the capability to connect any component of the cutting tool together, except Assembly Items, on the machine side. Code: `CCMS`*/
                }
                attribute ProgramToolGroup [0..1] : Profile::DataTypes::string {
                    doc /* tool group this tool is assigned in the part program.*/
                }
                attribute ProgramToolNumber [0..1] : Profile::DataTypes::string {
                    doc /* number of the tool as referenced in the part program.*/
                }
                part hasProcessFeedRate [0..1] : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ProcessFeedRate;
                part hasToolLife [0..3] : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ToolLife;
                part hasProcessSpindleSpeed [0..1] : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ProcessSpindleSpeed;
                part hasCutterStatus [1..*] : Status;
                part hasCuttingItem [0..*] : 'Cutting Item'::CuttingItem;
                part hasMeasurement [0..*] : ToolingMeasurement;
                part hasReconditionCount [0..1] : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ReconditionCount;
                part hasLocation [0..1] : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::Location;
            }
            connection def CutterStatus {
                end hasCutterStatus : Status => target.hasCutterStatus;
                doc 
                /* {{block(CutterStatus)}} provides the status of the assembly and {{term(organize)}} one or more {{block(Status)}} entities. See {{sect(Status)}}.
                 *
                 * The following combinations of {{block(Status)}} entities **MUST NOT** occur for a {{block(CutterStatus)}}:
                 *
                 * * `NEW` **MUST NOT** be used with `USED`, `RECONDITIONED`, or `EXPIRED`.
                 *
                 * * `UNKNOWN` **MUST NOT** be used with any other status.
                 *
                 * * `ALLOCATED` and `UNALLOCATED` **MUST NOT** be used together.
                 *
                 * * `AVAILABLE` and `UNAVAILABLE` **MUST NOT** be used together.
                 *
                 * * If the tool is `EXPIRED`, `BROKEN`, or `NOT_REGISTERED` it **MUST NOT** be `AVAILABLE`.*/
                end : CuttingToolLifeCycle;
            }
            connection def ReconditionCount {
                end hasReconditionCount : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ReconditionCount => target.hasReconditionCount;
                doc /* See {{sect(ReconditionCount)}}.*/
                end : CuttingToolLifeCycle;
            }
            connection def ProcessSpindleSpeed {
                end hasProcessSpindleSpeed : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ProcessSpindleSpeed => target.hasProcessSpindleSpeed;
                doc /* See {{sect(ProcessSpindleSpeed)}}.*/
                end : CuttingToolLifeCycle;
            }
            connection def ProcessFeedRate {
                end hasProcessFeedRate : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ProcessFeedRate => target.hasProcessFeedRate;
                doc /* See {{sect(ProcessFeedRate)}}.*/
                end : CuttingToolLifeCycle;
            }
            connection def ToolLife {
                end hasToolLife : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::ToolLife => target.hasToolLife;
                doc /* See {{sect(ToolLife)}}.*/
                end : CuttingToolLifeCycle;
            }
            connection def Location {
                end hasLocation : 'Asset Information Model'::'Cutting Tool'::'Cutting Tool Life Cycle'::Location => target.hasLocation;
                doc /* See {{sect(Location)}} for more detail.*/
                end : CuttingToolLifeCycle;
            }
            connection def Measurements {
                end hasMeasurement : ToolingMeasurement => target.hasMeasurement;
                doc /* {{block(Measurements)}} groups one or more {{block(Measurement)}} subtypes. See {{sect(Measurement)}}.*/
                end : CuttingToolLifeCycle;
            }
            part def ToolLife {
                doc /* cutting tool life as related to the assembly.*/
                comment /* Description*/
                attribute countDirection [1] : Profile::DataTypes::CountDirectionTypeEnum {
                    doc /* indicates if the tool life counts from zero to maximum or maximum to zero.*/
                }
                attribute initial [0..1] : Profile::DataTypes::float {
                    doc /* initial life of the tool when it is new.*/
                }
                attribute limit [0..1] : Profile::DataTypes::float {
                    doc /* end of life limit for the tool.*/
                }
                attribute type [1] : Profile::DataTypes::ToolLifeEnum {
                    doc /* type of tool life being accumulated.*/
                }
                attribute warning [0..1] : Profile::DataTypes::float {
                    doc /* point at which a tool life warning will be raised.*/
                }
                attribute value [1] : Profile::DataTypes::float {
                    doc /* value of {{block(ToolLife)}}.*/
                }
                doc /* {{block(ToolLife)}} **MUST** be defined only for the {{block(CuttingToolLifeCycle)}} of {{block(CuttingTool)}} and **MUST NOT** be defined for the {{block(CuttingToolLifeCycle)}} of {{block(CuttingToolArchetype)}}.*/
            }
            part def Location {
                doc 
                /* location of the pot or spindle the cutting tool currently resides in.
                 *
                 * If {{property(Location::negativeOverlap)}} or {{property(Location::positiveOverlap)}} is provided, the tool reserves additional locations on either side, otherwise if they are not given, no additional locations are required for this tool.
                 *
                 * If the pot occupies the first or last location, a rollover to the beginning or the end of the indexable values may occur. For example, if there are 64 pots and the tool is in pot 64 with a {{property(Location::positiveOverlap)}} of 1, the first pot **MAY** be occupied as well.*/
                comment /* Description*/
                attribute negativeOverlap [0..1] : Profile::DataTypes::integer {
                    doc /* number of locations at lower index values from this location.*/
                }
                attribute positiveOverlap [0..1] : Profile::DataTypes::integer {
                    doc /* number of locations at higher index value from this location.*/
                }
                attribute type [1] : Profile::DataTypes::LocationTypeEnum {
                    doc 
                    /* type of location being identified. 
                     *
                     * When a `POT` or `STATION` type is used, {{property(Location::value)}}**MUST** be a numeric value.*/
                }
                attribute turret [0..1] : Profile::DataTypes::string {
                    doc /* turret associated with a tool.*/
                }
                attribute toolMagazine [0..1] : Profile::DataTypes::string {
                    doc /* tool magazine associated with a tool.*/
                }
                attribute toolBar [0..1] : Profile::DataTypes::string {
                    doc /* tool bar associated with a tool.*/
                }
                attribute toolRack [0..1] : Profile::DataTypes::string {
                    doc /* tool rack associated with a tool.*/
                }
                attribute automaticToolChanger [0..1] : Profile::DataTypes::string {
                    doc /* automatic tool changer associated with a tool.*/
                }
                attribute value [0..1] : Profile::DataTypes::string;
                doc /* {{block(Location)}} **MUST** be defined only for the {{block(CuttingToolLifeCycle)}} of {{block(CuttingTool)}} and **MUST NOT** be defined for the {{block(CuttingToolLifeCycle)}} of {{block(CuttingToolArchetype)}}.*/
            }
            part def ReconditionCount {
                doc /* number of times the cutter has been reconditioned.*/
                attribute maximumCount [0..1] : Profile::DataTypes::integer {
                    doc /* maximum number of times the tool may be reconditioned.*/
                }
                attribute value [0..1] : Profile::DataTypes::integer {
                    doc /* {{property(ReconditionCount::value)}} **MUST** be provided for {{block(CuttingTool::CuttingToolLifeCycle)}} and **MUST NOT** be provided for the {{block(CuttingToolArchetype::CuttingToolLifeCycle)}}.*/
                }
            }
            part def ProcessSpindleSpeed {
                doc 
                /* constrained process spindle speed for the tool in revolutions/minute.
                 *
                 * The {{property(ProcessSpindleSpeed::value)}} **MAY** contain the nominal process target spindle speed if available. If {{block(ProcessSpindleSpeed)}} is provided, at least one value of {{property(ProcessSpindleSpeed::maximum)}}, {{property(ProcessSpindleSpeed::nominal)}}, or {{property(ProcessSpindleSpeed::minimum)}} **MUST** be specified.*/
                attribute maximum [0..1] : Profile::DataTypes::float {
                    doc /* upper bound for the tool’s target spindle speed.*/
                }
                attribute minimum [0..1] : Profile::DataTypes::float {
                    doc /* lower bound for the tools spindle speed.*/
                }
                attribute nominal [0..1] : Profile::DataTypes::float {
                    doc /* nominal speed the tool is designed to operate at.*/
                }
                attribute value [0..1] : Profile::DataTypes::float;
            }
            part def ProcessFeedRate {
                doc 
                /* constrained process feed rate for the tool in mm/s.
                 *
                 * The {{property(ProcessFeedRate::value)}} **MAY** contain the nominal process target feed rate if available. If {{block(ProcessFeedRate)}} is provided, at least one value of {{property(ProcessFeedRate::maximum)}}, {{property(ProcessFeedRate::nominal)}}, or {{property(ProcessFeedRate::minimum)}} **MUST** be specified.*/
                attribute maximum [0..1] : Profile::DataTypes::float {
                    doc /* upper bound for the tool’s process target feedrate.*/
                }
                attribute minimum [0..1] : Profile::DataTypes::float {
                    doc /* lower bound for the tool's feedrate.*/
                }
                attribute nominal [0..1] : Profile::DataTypes::float {
                    doc /* nominal feedrate the tool is designed to operate at.*/
                }
                attribute value [0..1] : Profile::DataTypes::float;
            }
            part def Status {
                doc /* status of the cutting tool.*/
                attribute value [1] : Profile::DataTypes::CutterStatusTypeEnum {
                    doc /* status value of the cutting tool.*/
                }
            }
            abstract part def ToolingMeasurement :> Pallet::Measurements::Measurement {
                doc /* constrained scalar value associated with a cutting tool.*/
                comment /* Description*/
                attribute code [0..1] : Profile::DataTypes::CodeEnum {
                    doc 
                    /* shop specific code for the measurement. 
                     *
                     * ISO 13399 codes **MAY** be used for these codes as well. 
                     *
                     * See {{package(Cutting Tool Measurement Subtypes)}} and {{package(Cutting Item Measurement Subtypes)}} for details on {{block(Measurement)}} types and their respective {{property(Measurement::code)}} values.*/
                }
                doc /* A {{block(Measurement)}} is specific to the tool management policy at a particular shop. The tool zero reference point or gauge line will be different depending on the particular implementation and will be assumed to be consistent within the shop. MTConnect Standard does not standardize the manufacturing process or the definition of the zero point.*/
            }
            doc 
            /* This section provides semantic information for the {{block(CuttingToolLifeCycle)}} model.
             *
             * ![CuttingToolLifeCycle](figures/CuttingToolLifeCycle.png "CuttingToolLifeCycle"){: width="0.8"}
             *
             * > Note: See {{sect(CuttingToolLifeCycle Schema Diagrams)}} for XML schema.
             */
        }
        doc 
        /* This section provides semantic information for the {{block(CuttingTool)}} and {{block(CuttingToolArchetype)}} models.
         *
         * ![CuttingTool](figures/CuttingTool.png "CuttingTool"){: width="0.8"}
         *
         * > Note: See {{sect(CuttingTool Schema Diagrams)}} for XML schema.
         */
        comment /* Cutting Tool Asset Information Model*/
        doc 
        /* There are two {{termplural(information model)}} used to represent a cutting tool, {{block(CuttingToolArchetype)}} and {{block(CuttingTool)}}. The {{block(CuttingToolArchetype)}} represents the static cutting tool geometries and nominal values as one would expect from a tool catalog and the {{block(CuttingTool)}} represents the use or application of the tool on the shop floor with actual measured values and process data. In Version 1.3.0 of the MTConnect Standard it was decided to separate out these two concerns since not all pieces of equipment will have access to both sets of information. In this way, a generic definition of the cutting tool can coexist with a specific assembly {{term(information model)}} with minimal redundancy of data.
         *
         * MTConnect Standard will adopt the ISO 13399 structure when formulating the vocabulary for Cutting Tool geometries and structure to be represented in the {{block(CuttingToolArchetype)}}. The nominal values provided in the {{block(CuttingToolLifeCycle)}} section are only concerned with two aspects of the Cutting Tool; the Cutting Tool and the cutting item. The tool item, Adaptive Item, and Assembly Item will only be covered in the {{block(CuttingToolDefinition)}} section of this document since this section contains the full ISO 13399 information about a Cutting Tool.
         *
         * ![Cutting Tool Parts](figures/Cutting%20Tool%20Parts.png "Cutting Tool Parts"){: width="0.8"}
         *
         * The {{figure(Cutting Tool Parts)}} illustrates the parts of a Cutting Tool. The Cutting Tool is the aggregate of all the components and the cutting item is the part of the tool that removes the material from the workpiece. These are the primary focus of the MTConnect Standard.
         *
         * ![Cutting Tool Composition](figures/Cutting%20Tool%20Composition.png "Cutting Tool Composition"){: width="0.8"}
         *
         * {{figure(Cutting Tool Composition)}} provides another view of the composition of a Cutting Tool. The Adaptive Items and tool items will be used for measurements, but will not be modeled as separate entities. When we are referencing the Cutting Tool we are referring to the entirety of the assembly and when we provide data regarding the cutting item we are referencing each individual item as illustrated on the left of the previous diagram.
         *
         * ![Cutting Tool, Tool Item, and Cutting Item](figures/Cutting%20Tool,%20Tool%20Item,%20and%20Cutting%20Item.png "Cutting Tool, Tool Item, and Cutting Item"){: width="0.8"}
         *
         * ![Cutting Tool, Tool Item, and Cutting Item 2](figures/Cutting%20Tool,%20Tool%20Item,%20and%20Cutting%20Item%202.png "Cutting Tool, Tool Item, and Cutting Item 2"){: width="0.8"}
         *
         *
         * {{figure(Cutting Tool, Tool Item, and Cutting Item)}} and {{figure(Cutting Tool, Tool Item, and Cutting Item 2)}} further illustrates the components of the Cutting Tool. As we compose the tool item, cutting item, Adaptive Item, we get a Cutting Tool. The tool item, Adaptive Item, and Assembly Item will only be in the {{block(CuttingToolDefinition)}} section that will contain the full ISO 13399 information. These figures also use the ISO 13399 codes for each of the measurements. These codes will be translated into the MTConnect Standard vocabulary as illustrated below. The measurements will have a maximum, minimum, and nominal value representing the tolerance of allowable values for this dimension.
         *
         * The MTConnect Standard will not define the entire geometry of the Cutting Tool, but will provide the information necessary to use the tool in the manufacturing process. Additional information can be added to the definition of the Cutting Tool by means of schema extensions.
         *
         * Additional diagrams will reference these dimensions by their codes that will be defined in the measurement tables. The codes are consistent with the codes used in ISO 13399 and have been standardized. MTConnect Standard will use the full text name for clarity in the {{termplural(response document)}}.
         *
         *
         */
    }
    package Files {
        abstract part def AbstractFile :> Asset {
            doc /* abstract {{block(Asset)}} that contains the common properties of the {{block(File)}} and {{block(FileArchetype)}} types.*/
            attribute name [1] : Profile::DataTypes::string {
                doc /* name of the file.*/
            }
            attribute mediaType [1] : Profile::DataTypes::string {
                doc /* mime type of the file.*/
            }
            attribute applicationCategory [1] : Profile::DataTypes::ApplicationCategoryEnum {
                doc /* category of application that will use this file.*/
            }
            attribute applicationType [1] : Profile::DataTypes::ApplicationTypeEnum {
                doc /* type of application that will use this file.*/
            }
            part hasFileProperty [0..*] : FileProperty;
            part hasFileComment [0..*] : FileComment;
        }
        connection def FileComments {
            end hasFileComment : FileComment => target.hasFileComment;
            doc 
            /* {{block(FileComments)}} groups one or more {{block(FileComment)}} entities for a {{block(File)}}.
             *  See {{sect(FileComment)}}.*/
            private end : AbstractFile;
        }
        connection def FileProperties {
            end hasFileProperty : FileProperty => target.hasFileProperty;
            doc 
            /* {{block(FileProperties)}} groups one or more {{block(FileProperty)}} entities for a {{block(File)}}.
             *  See {{sect(FileProperty)}}.*/
            private end : AbstractFile;
        }
        part def File :> AbstractFile {
            doc /* {{block(AbstractFile)}} type that provides information about the {{block(File)}} instance and its {{term(URL)}}.*/
            attribute size [1] : Profile::DataTypes::integer {
                doc /* size of the file in bytes.*/
            }
            attribute versionId [1] : Profile::DataTypes::string {
                doc /* version identifier of the file.*/
            }
            attribute 'state' [1] : Profile::DataTypes::FileStateEnum {
                doc /* state of the file. */
            }
            attribute Signature [0..1] : Profile::DataTypes::x509 {
                doc /* secure hash of the file.*/
            }
            attribute PublicKey [0..1] : Profile::DataTypes::x509 {
                doc /* public key used to verify the signature.*/
            }
            attribute CreationTime [1] : Profile::DataTypes::datetime {
                doc /* time the file was created.*/
            }
            attribute ModificationTime [0..1] : Profile::DataTypes::datetime {
                doc /* time the file was modified.*/
            }
            part hasLocation [1] : 'Asset Information Model'::Files::FileLocation;
            part hasDestination [0..*] : Destination;
        }
        connection def FileLocation {
            end hasLocation : 'Asset Information Model'::Files::FileLocation => target.hasLocation;
            doc /* See {{sect(FileLocation)}}.*/
            private end : File;
        }
        connection def Destinations {
            end hasDestination : Destination => target.hasDestination;
            doc /* {{block(Destinations)}} groups one or more {{block(Destination)}} entities. See {{sect(Destination)}}.*/
            private end : File;
        }
        part def FileArchetype :> AbstractFile {
            doc /* {{block(AbstractFile)}} type that provides information common to all versions of a file.*/
        }
        part def FileProperty {
            doc /* key-value pair providing additional metadata about a {{block(File)}}.*/
            attribute name [1] : Profile::DataTypes::string {
                doc /* name of the {{block(FileProperty)}}.*/
            }
            attribute value [1] : Profile::DataTypes::string {
                doc /* The value of the {{block(FileProperty)}}.*/
            }
        }
        part def FileComment {
            doc /* remark or interpretation for human interpretation associated with a {{block(File)}} or {{block(FileArchetype)}}.*/
            attribute timestamp [1] : Profile::DataTypes::datetime {
                doc /* time the comment was made.*/
            }
            attribute value [1] : Profile::DataTypes::string {
                doc /* text of the comment about the file.*/
            }
        }
        part def FileLocation {
            doc /* {{term(URL)}} reference to the file location. */
            attribute href [1] : Profile::DataTypes::xlinkhref {
                doc 
                /* {{term(URL)}} reference to the file.
                 *
                 * `href` is of type `xlink:href` from the W3C XLink specification.*/
            }
            attribute 'xlink:type' [0..1] : Profile::DataTypes::xlinktype {
                doc 
                /* type of href for the xlink href type. 
                 *
                 * **MUST** be `locator` referring to a {{term(URL)}}
                 * .*/
            }
        }
        part def Destination {
            doc /* reference to the target {{block(Device)}} for this {{block(File)}}.*/
            attribute deviceUuid [1] : Profile::DataTypes::UUID {
                doc /* `uuid` of the target device or application.*/
            }
        }
        doc 
        /* This section provides semantic information for the {{block(File)}} model.
         *
         * ![Files](figures/Files.png "Files"){: width="0.8"}
         *
         * > Note: See {{sect(File Schema Diagrams)}} for XML schema.
         */
        comment /* Files Asset Information Model*/
        doc 
        /* Manufacturing processes require various documents, programs, setup sheets, and digital media available at the device for a given process. The {{block(File)}} and {{block(FileArchetype)}} {{block(Asset)}}s provide a mechanism to communicate specific "Files" that are relevant to a process where the media is located on a server and represented by a Universal Resource Locator (URL).
         *
         * The {{block(FileArchetype)}} contains metadata common to all {{block(File)}} {{block(Asset)}}s for a certain purpose. The {{block(File)}} {{block(Asset)}} references the file specific to a given device or set of devices. The {{block(File)}} {{block(Asset)}} does not hold the contents of the file, it contains a reference to the location (URL) used to access the information. The metadata associated with the {{block(File)}} provides semantic information about the representation (mime-type) and the application associated with the {{block(File)}}. The application of the file is an extensible controlled vocabulary with common manufacturing uses provided.*/
    }
    package 'Raw Material' {
        part def RawMaterial :> Asset {
            doc /* {{block(Asset)}} that represents {{term(raw material)}}.*/
            attribute name [0..1] : Profile::DataTypes::string {
                doc 
                /* name of the {{term(raw material)}}.
                 *
                 * Examples: `Container1` and `AcrylicContainer`.*/
            }
            attribute containerType [0..1] : Profile::DataTypes::string {
                doc 
                /* type of container holding the {{term(raw material)}}. 
                 *
                 * Examples: `Pallet`, `Canister`, `Cartridge`, `Tank`, `Bin`, `Roll`, and `Spool`.*/
            }
            attribute processKind [0..1] : Profile::DataTypes::string {
                doc 
                /* ISO process type supported by this {{term(raw material)}}. 
                 *
                 * Examples include: `VAT_POLYMERIZATION`, `BINDER_JETTING`, `MATERIAL_EXTRUSION`, `MATERIAL_JETTING`, `SHEET_LAMINATION`, `POWDER_BED_FUSION` and `DIRECTED_ENERGY_DEPOSITION`.*/
            }
            attribute serialNumber [0..1] : Profile::DataTypes::string {
                doc /* serial number of the {{term(raw material)}}.*/
            }
            attribute HasMaterial [0..1] : Profile::DataTypes::boolean {
                doc /* {{block(Material)}} has existing usable volume.*/
            }
            part hasMaterial [0..1] : Material;
            attribute Form [1] : Profile::DataTypes::FormEnum {
                doc /* form of the {{term(raw material)}}.*/
            }
            attribute ManufacturingDate [0..1] : Profile::DataTypes::datetime {
                doc /* date the {{term(raw material)}} was created.*/
            }
            attribute FirstUseDate [0..1] : Profile::DataTypes::datetime {
                doc /* date {{term(raw material)}} was first used.*/
            }
            attribute LastUseDate [0..1] : Profile::DataTypes::datetime {
                doc /* date {{term(raw material)}} was last used.*/
            }
            attribute InitialVolume [0..1] : Profile::DataTypes::CUBIC_MILLIMETER {
                doc /* amount of material initially placed in {{term(raw material)}} when manufactured.*/
            }
            attribute InitialDimension [0..3] : Profile::DataTypes::MILLIMETER {
                doc /* dimension of material initially placed in {{term(raw material)}} when manufactured.*/
            }
            attribute InitialQuantity [0..1] : Profile::DataTypes::integer {
                doc /* quantity of material initially placed in {{term(raw material)}} when manufactured.*/
            }
            attribute CurrentVolume [0..1] : Profile::DataTypes::CUBIC_MILLIMETER {
                doc /* amount of material currently in {{term(raw material)}}.*/
            }
            attribute CurrentDimension [0..3] : Profile::DataTypes::MILLIMETER {
                doc /* dimension of material currently in {{term(raw material)}}.*/
            }
            attribute CurrentQuantity [0..1] : Profile::DataTypes::integer {
                doc /* quantity of material currently in {{term(raw material)}}.*/
            }
        }
        part def Material {
            doc /* material used as the {{block(RawMaterial)}}.*/
            attribute id [0..1] : Profile::DataTypes::ID {
                doc /* unique identifier for the material.*/
            }
            attribute name [0..1] : Profile::DataTypes::string {
                doc 
                /* name of the material. 
                 *
                 * Examples: `ULTM9085`, `ABS`, `4140`.*/
            }
            attribute type [1] : Profile::DataTypes::string {
                doc 
                /* type of material. 
                 *
                 * Examples: `Metal`, `Polymer`, `Wood`, `4140`, `Recycled`, `Prestine` and `Used`.*/
            }
            attribute Lot [0..1] : Profile::DataTypes::string {
                doc /* manufacturer's lot code of the material.*/
            }
            attribute Manufacturer [0..1] : Profile::DataTypes::string {
                doc /* name of the material manufacturer.*/
            }
            attribute ManufacturingDate [0..1] : Profile::DataTypes::datetime {
                doc /* manufacturing date of the material from the material manufacturer.*/
            }
            attribute ManufacturingCode [0..1] : Profile::DataTypes::string {
                doc /* lot code of the raw feed stock for the material, from the feed stock manufacturer.*/
            }
            attribute MaterialCode [0..1] : Profile::DataTypes::string {
                doc /* {{term(ASTM)}} standard code that the material complies with.*/
            }
        }
        connection def Material {
            end hasMaterial : Material => target.hasMaterial;
            doc /* See {{sect(Material)}}.*/
            private end : RawMaterial;
        }
        doc 
        /* This section provides semantic information for the {{block(RawMaterial)}} model.
         *
         * ![RawMaterial](figures/RawMaterial.png "RawMaterial"){: width="0.5"}
         *
         * > Note: See {{sect(RawMaterial Schema Diagrams)}} for XML schema.*/
        comment /* Raw Material Asset Information Model*/
        doc 
        /* Raw material represents the source of material for immediate use and sources of material that may or may not be used during the manufacturing process.
         *
         * The {{block(RawMaterial)}} {{block(Asset)}} holds the references to the content stored in the actual {{block(RawMaterial)}} container or derived about the {{block(RawMaterial)}} by the system during operation.*/
    }
    package QIF {
        part def QIFDocument {
            doc /* QIF Document as given by the {{term(QIF)}} standard.*/
        }
        part def QIFDocumentWrapper :> Asset {
            doc /* {{block(Asset)}} that carries the QIF Document.*/
            attribute qifDocumentType [0..1] : Profile::DataTypes::QIFDocumentTypeEnum {
                doc /* contained QIF Document type as defined in the {{term(QIF)}} Standard.*/
            }
            part hasQIFDocument [1] : QIFDocument;
        }
        connection def QIFDocument {
            end hasQIFDocument : QIFDocument => target.hasQIFDocument;
            doc /**/
            private end : QIFDocumentWrapper;
        }
        doc 
        /* This section provides semantic information for the {{block(QIFDocumentWrapper)}} model.
         *
         * ![QIFDocumentWrapper](figures/QIFDocumentWrapper.png "QIFDocumentWrapper"){: width="0.8"}
         *
         * > Note: See {{sect(QIFDocumentWrapper Schema Diagrams)}} for XML schema.*/
        comment /* QIF Asset Information Model*/
        doc 
        /* The {{term(QIF)}} is an American National Standards Institute (ANSI) accredited standard developed by the Digital Metrology Standards Consortium (DMSC) standards development organization. The DMSC is an A-liaison to the International Standards Organization (ISO) Technical Committee (TC) 184. {{term(QIF)}} addresses the needs of the metrology community to have a semantic information model for the exchange of metrology data throughout the verification lifecycle from product design to execution, analysis, and reporting.
         *
         * The MTConnect {{term(QIF)}} {{term(Asset Information Model)}} provides a wrapper around a {{term(QIF)}} document (i.e., a dataset conforming to the QIF Information model) in its native XML representation. The MTConnect standard does not alter or extend the {{term(QIF)}} standard and regards the {{term(QIF)}} standard as a passthrough.
         *
         * Information about the {{term(QIF)}} standards is at the following location: https://qifstandards.org*/
    }
    connection def Configuration {
        end hasConfiguration : 'Device Information Model'::Configurations::Configuration => isConfigurationFor.hasConfiguration;
        doc /* See {{block(Configuration)}} in {{package(Device Information Model)}}.*/
        private end isConfigurationFor : Asset;
    }
    package 'Component Configuration Parameters' {
        part def ComponentConfigurationParameters :> Asset {
            doc /* set of {{block(ParameterSet)}}s that govern the functionality of the related {{block(Component)}}.*/
            part hasParameterSet [1..*] : ParameterSet;
        }
        part def ParameterSet {
            doc /* set of {{block(Parameter)}}s.*/
            attribute name [0..1] : Profile::DataTypes::string {
                doc /* name of the parameter set if more than one exists.*/
            }
            part hasParameter [1..*] : Parameter;
        }
        connection def ParameterSets {
            end hasParameterSet : ParameterSet => target.hasParameterSet;
            doc 
            /* {{block(ParameterSets)}} groups one or more {{block(ParameterSet)}} entities.
             *  See {{sect(ParameterSet)}}.*/
            private end : ComponentConfigurationParameters;
        }
        part def Parameter {
            doc /* property that determines the characteristic or behavior of an entity.*/
            attribute identifier [1] : Profile::DataTypes::string {
                doc /* internal identifier, register, or address.*/
            }
            attribute name [1] : Profile::DataTypes::string {
                doc /* descriptive name.*/
            }
            attribute minimum [0..1] : Profile::DataTypes::double {
                doc /* minimal allowed value.*/
            }
            attribute maximum [0..1] : Profile::DataTypes::double {
                doc /* maximum allowed value.*/
            }
            attribute nominal [0..1] : Profile::DataTypes::double {
                doc /* nominal value.*/
            }
            attribute value [1] : Profile::DataTypes::string {
                doc /* configured value.*/
            }
            attribute units [0..1] : Profile::DataTypes::string {
                doc 
                /* engineering units.
                 *
                 * {{property(Parameter::units)}} **SHOULD** be SI or MTConnect Units.*/
            }
        }
        connection def Parameters {
            end hasParameter : Parameter => target.hasParameter;
            doc 
            /* {{block(Parameters)}} groups one or more {{block(Parameter)}} entities.
             *  See {{sect(Parameter)}}.*/
            private end : ParameterSet;
        }
        doc 
        /* This section provides semantic information for the {{block(ComponentConfigurationParameters)}} model.
         *
         * ![ComponentConfigurationParameters](figures/ComponentConfigurationParameters.png "ComponentConfigurationParameters"){: width="0.8"}
         */
    }
    package Fixture {
        part def Fixture :> PhysicalAsset {
            private attribute FixtureId [0..1] : Profile::DataTypes::ID {
                doc /* identifier of the {{block(Pallet)}}.*/
            }
            private attribute FixtureNumber [0..1] : Profile::DataTypes::integer {
                doc /* number or sequence assigned to the {{block(Fixture)}} in a group of {{block(Fixture)}}s.*/
            }
            private attribute ClampingMethod [0..1] : Profile::DataTypes::string {
                doc /* actuation type of the {{block(Fixture)}}'s clamping mechanism.*/
            }
            private attribute MountingMethod [0..1] : Profile::DataTypes::string {
                doc /* actuation type of the {{block(Fixture)}}'s mounting mechanism.*/
            }
        }
        doc 
        /* This section provides semantic information for the {{block(Fixture)}} model.
         *
         * ![Fixture](figures/Fixture.png "Files"){: width="0.8"}*/
    }
    abstract part def PhysicalAsset :> Asset {
        doc /* abstract physical {{block(Asset)}}.*/
        private attribute ManufactureDate [0..1] : Profile::DataTypes::datetime {
            doc /* date of creation or built of the {{block(Asset)}}.*/
        }
        private attribute CalibrationDate [0..1] : Profile::DataTypes::datetime {
            doc /* date of calibration of the {{block(Asset)}}.*/
        }
        private attribute InspectionDate [0..1] : Profile::DataTypes::datetime {
            doc /* date of last inspection of the {{block(Asset)}}.*/
        }
        private attribute NextInspectionDate [0..1] : Profile::DataTypes::datetime {
            doc /* date of next inspection of the {{block(Asset)}}.*/
        }
        part hasMeasurement [0..*] : Pallet::Measurements::Measurement;
    }
    connection def Measurements {
        end hasMeasurement : Pallet::Measurements::Measurement => target.hasMeasurement;
        private end : PhysicalAsset;
    }
    package Pallet {
        part def Pallet :> PhysicalAsset {
            doc /* {{block(PhysicalAsset)}} that has a portable platform for handling, storing, or moving materials, parts, blanks etc.*/
            private attribute Type [0..1] : Profile::DataTypes::string {
                doc 
                /* type of {{block(Pallet)}}. 
                 *
                 * Common types of pallet include: Process, Warehouse, Shipping, Fixture and Machine.*/
            }
            private attribute PalletId [0..1] : Profile::DataTypes::ID {
                doc /* identifier of the {{block(Pallet)}}.*/
            }
            private attribute PalletNumber [0..1] : Profile::DataTypes::integer {
                doc /* number or sequence assigned to the {{block(Pallet)}} in a group of {{block(Pallet)}}s.*/
            }
            private attribute ClampingMethod [0..1] : Profile::DataTypes::string {
                doc /* actuation type of the {{block(Pallet)}}'s clamping mechanism.*/
            }
            private attribute MountingMethod [0..1] : Profile::DataTypes::string {
                doc /* actuation type of the {{block(Pallet)}}'s mounting mechanism.*/
            }
        }
        package Measurements {
            abstract part def Measurement {
                doc /* constrained scalar value associated with an {{block(Asset)}}*/
                attribute maximum [0..1] : Profile::DataTypes::float {
                    doc /* maximum value for the measurement. */
                }
                attribute minimum [0..1] : Profile::DataTypes::float {
                    doc /* minimum value for the measurement. */
                }
                attribute nativeUnits [0..1] : Profile::DataTypes::NativeUnitEnum {
                    doc /* units the measurement was originally recorded in. See {{package(Device Information Model)}} for the complete list of {{property(DataItem::nativeUnits)}}.*/
                }
                attribute nominal [0..1] : Profile::DataTypes::float {
                    doc /* as advertised value for the measurement.*/
                }
                attribute significantDigits [0..1] : Profile::DataTypes::integer {
                    doc /* number of significant digits in the reported value. */
                }
                attribute units [0..1] : Profile::DataTypes::UnitEnum {
                    doc /* units for the measurements. See {{package(Device Information Model)}} for the complete list of {{property(DataItem::units)}}.*/
                }
                attribute value [0..1] : Profile::DataTypes::float;
            }
            part def Weight :> Measurement {
                doc /* {{termuniversal(weight)}} of the {{block(PhysicalAsset)}}*/
            }
            part def Height :> Measurement {
                doc /* {{termuniversal(height)}} of the {{block(PhysicalAsset)}}*/
            }
            part def Width :> Measurement {
                doc /* {{termuniversal(width)}} of the {{block(PhysicalAsset)}}*/
            }
            part def Length :> Measurement {
                doc /* {{termuniversal(length)}} of the {{block(PhysicalAsset)}}*/
            }
            part def Swing :> Measurement {
                doc /* {{termuniversal(swing)}} of the {{block(PhysicalAsset)}}*/
            }
            part def LoadedWeight :> Measurement {
                doc /* loaded weight of the {{block(PhysicalAsset)}}*/
            }
            part def LoadedHeight :> Measurement {
                doc /* loaded height of the {{block(PhysicalAsset)}}*/
            }
            part def LoadedWidth :> Measurement {
                doc /* loaded width of the {{block(PhysicalAsset)}}*/
            }
            part def LoadedLength :> Measurement {
                doc /* loaded length of the {{block(PhysicalAsset)}}*/
            }
            part def LoadedSwing :> Measurement {
                doc /* loaded swing of the {{block(PhysicalAsset)}}*/
            }
            doc /* This section lists common {{block(Measurement)}} types for a {{block(PhysicalAsset)}}.*/
        }
        doc 
        /* This section provides semantic information for the {{block(Pallet)}} model.
         *
         * ![Pallet](figures/Pallet.png "Files"){: width="0.8"}*/
    }
    package Process {
        part def Process :> Asset {
            doc /* {{block(Asset)}} that is composed of a series of actions to achieve a specific outcome.*/
            private attribute revision [1] : Profile::DataTypes::string {
                doc /* identifier assigned to a process version that reflects a change*/
            }
            part hasRouting [1] : Routing;
            part hasTargets [0..*] : Target::Target;
        }
        connection def ActivityGroups {
            end hasActivityGroup : ActivityGroup => target.hasActivityGroup;
            private end : ProcessStep;
        }
        connection def Targets {
            end hasTarget : Target::TargetRef => target.hasTarget;
            private end : ProcessStep;
        }
        connection def Targets {
            end hasTarget : Target::Target => target.hasTarget;
            private end : ProcessArchetype;
        }
        part def ProcessArchetype :> Asset {
            doc /* {{block(Asset)}} that defines common data for all derived {{block(Process)}}es.*/
            private attribute revision [1] : Profile::DataTypes::string {
                doc /* identifier assigned to a process archetype version that reflects a change*/
            }
            part hasRouting [1..*] : Routing;
            part hasTarget [0..*] : Target::Target;
        }
        connection def {
            end hasActivity : Activity => target.hasActivity;
            private end : ActivityGroup;
        }
        part def Routing {
            doc /* optimal sequence of process steps*/
            private attribute precedence [0..1] : Profile::DataTypes::integer {
                doc /* priority order in which multiple routings are applied or considered for a process*/
            }
            private attribute routingId [1] : Profile::DataTypes::ID {
                doc /* identifier for the routing*/
            }
            part hasProcessStep [1..*] : ProcessStep;
        }
        part def ProcessStep {
            doc /* step involving a flow and/or transformation of material, information, energy, control, or any other element in manufacturing*/
            private attribute stepId [1] : Profile::DataTypes::ID {
                doc /* identifier of the process step*/
            }
            private attribute optional [0..1] : Profile::DataTypes::boolean default false {
                doc /* indicates if a process step is discretionary and not mandatory*/
            }
            private attribute sequence [0..1] : Profile::DataTypes::integer {
                doc /* position of a process step within the progression of process steps to be executed in order*/
            }
            private attribute Description [0..1] : Profile::DataTypes::string {
                doc /* descriptive content for process step*/
            }
            private attribute StartTime [0..1] : Profile::DataTypes::datetime {
                doc /* time when the process step was started*/
            }
            part hasTarget [0..*] : Target::TargetRef;
            part hasActivityGroup [0..*] : ActivityGroup;
            private attribute Duration [0..1] : Profile::DataTypes::float {
                doc /* length of time the process step lasted*/
            }
        }
        part def ActivityGroup {
            doc /* group of {{block(Activity)}}s organized for a common objective within a process step*/
            private attribute activityGroupId [1] : Profile::DataTypes::ID {
                doc /* identifier for the activity group*/
            }
            part hasActivity [1..*] : Activity;
            private attribute name [0..1] : Profile::DataTypes::string {
                doc /* {{termuniversal(name)}} of the activity group*/
            }
        }
        connection def Routings {
            end hasRouting : Routing => target.hasRouting;
            private end : ProcessArchetype;
        }
        connection def {
            end hasProcessStep : ProcessStep => target.hasProcessStep;
            private end : Routing;
        }
        part def Activity {
            doc /* smallest unit of task or action within a process step*/
            private attribute sequence [0..1] : Profile::DataTypes::integer {
                doc /* position of an activity within the progression of activities to be executed in order*/
            }
            private attribute activityId [1] : Profile::DataTypes::ID {
                doc /* identifier for the activity*/
            }
            private attribute precedence [0..1] : Profile::DataTypes::integer {
                doc /* priority order in which an activity should be performed relative to other activities*/
            }
            private attribute optional [0..1] : Profile::DataTypes::boolean default false {
                doc /* indicates if an activity is discretionary and not mandatory*/
            }
            private attribute Description [0..1] : Profile::DataTypes::string {
                doc /* descriptive content for the activity*/
            }
        }
        connection def {
            end hasRouting : Routing => target.hasRouting;
            private end : 'Asset Information Model'::Process::Process;
        }
        connection def Targets {
            end hasTargets : Target::Target => target.hasTargets;
            private end : 'Asset Information Model'::Process::Process;
        }
        package Target {
            abstract part def Target {
                doc 
                /* information related to a {{block(Device)}} or {{block(Component)}} that may implement a {{block(Process)}} or a {{block(Task)}}
                 *
                 */
            }
            part def TargetRef :> Target {
                doc /* reference to an existing {{block(Target)}}*/
                private attribute groupIdRef [1] : Profile::DataTypes::ID {
                    doc /* reference to the identifier provided by a {{block(TargetGroup)}}*/
                }
            }
            part def TargetDevice :> Target {
                doc 
                /* reference to a {{block(Device)}} that is required to implement a {{block(Process)}} or a {{block(Task)}}
                 *
                 */
                private attribute deviceUuid [1] : Profile::DataTypes::UUID {
                    doc /* reference to the {{property(Device::uuid)}}*/
                }
            }
            part def TargetGroup :> Target {
                doc /* reference to a group of {{block(Device)}}s that have the capability to implement a {{block(Process)}} or a {{block(Task)}}*/
                part hasTargetDevice [0..*] : TargetDevice;
                private attribute groupId [1] : Profile::DataTypes::ID {
                    doc /* identifier for a group of {{block(Device)}}s*/
                }
                part hasTargetRef [0..*] : TargetRef;
            }
            connection def {
                end hasTargetDevice : TargetDevice => target.hasTargetDevice;
                private end : TargetGroup;
            }
            part def TargetRequirementTable :> Target {
                doc /* list of requirements a {{block(Device)}} or a {{block(Component)}} **MUST** satisfy to implement a {{block(Process)}} or a {{block(Task)}}*/
                private attribute requirementId [1] : Profile::DataTypes::ID {
                    doc /* identifier for the set of target requirements*/
                }
                part hasEntry [0..*] : 'Observation Information Model'::Representations::Table::Entry;
            }
            connection def {
                end hasEntry : 'Observation Information Model'::Representations::Table::Entry => target.hasEntry;
                private end : TargetRequirementTable;
            }
            connection def {
                end hasTargetRef : TargetRef => target.hasTargetRef;
                private end : TargetGroup;
            }
        }
        doc /* This section provides semantic information for the {{block(Process)}} model.
         */
    }
    package Part {
        abstract part def Identifier {
            doc /* unique name or label for a part.*/
            private attribute type [1] : Profile::DataTypes::PartIdentifierEnum {
                doc /* {{termuniversal(type)}} of identifier*/
            }
            private attribute stepIdRef [0..1] : Profile::DataTypes::ID {
                doc /* reference to the identifier of the process step*/
            }
            private attribute timestamp [1] : Profile::DataTypes::datetime {
                doc /* time when the identifier was reported*/
            }
            private attribute value [1] : Profile::DataTypes::ID;
        }
        part def GroupIdentifier :> Identifier {
            doc /* identifier for a group of parts or a piece of raw material that will be transformed into multiple parts*/
            private attribute type [1] :>> 'Asset Information Model'::Part::Identifier::type : Profile::DataTypes::PartIdentifierEnum default type::GROUP_IDENTIFIER;
        }
        part def PartArchetype :> Asset {
            doc /* {{block(Asset)}} that defines common data for all derived {{block(Part)}}s.*/
            private attribute revision [1] : Profile::DataTypes::string {
                doc /* identifier assigned to a part archetype version that reflects a change*/
            }
            private attribute family [0..1] : Profile::DataTypes::string {
                doc /* identifier for a group of parts that share similar characteristics*/
            }
            private attribute drawing [0..1] : Profile::DataTypes::string {
                doc /* reference to the technical document like a diagram or a blueprint associated with the part archetype*/
            }
            part hasCustomer [0..*] : Customer;
        }
        part def Customer {
            doc /* {{termuniversal(customer)}} for this part*/
            private attribute customerId [0..1] : Profile::DataTypes::ID {
                doc /* identifier for the customer*/
            }
            private attribute name [0..1] : Profile::DataTypes::string {
                doc /* {{termuniversal(name)}} of the customer*/
            }
            private attribute Address [0..1] : Profile::DataTypes::string {
                doc /* {{termuniversal(address)}} of the customer*/
            }
            private attribute Description [0..1] : Profile::DataTypes::string {
                doc /* descriptive content for the customer*/
            }
        }
        connection def Customers {
            end hasCustomer : Customer => target.hasCustomer;
            private end : PartArchetype;
        }
        connection def PartIdentifiers {
            end hasPartIdentifier : Identifier => target.hasPartIdentifier;
            private end : 'Asset Information Model'::Part::Part;
        }
        part def Part :> Asset {
            doc /* {{block(Asset)}} that is a {{term(part)}}.*/
            private attribute family [0..1] : Profile::DataTypes::string {
                doc /* identifier for a group of parts that share similar characteristics*/
            }
            private attribute drawing [0..1] : Profile::DataTypes::string {
                doc /* reference to the technical document like a diagram or a blueprint associated with the part*/
            }
            private attribute revision [1] : Profile::DataTypes::string {
                doc /* identifier assigned to a part version that reflects a change*/
            }
            private attribute nativeId [0..1] : Profile::DataTypes::ID {
                doc /* native identifier for the part*/
            }
            part hasPartIdentifier [0..*] : Identifier;
        }
        part def UniqueIdentifier :> Identifier {
            doc /* unique serialized part identifier.*/
            private attribute type [1] :>> 'Asset Information Model'::Part::Identifier::type : Profile::DataTypes::PartIdentifierEnum default type::UNIQUE_IDENTIFIER;
        }
        doc /* This section provides semantic information for the {{block(Part)}} model.*/
    }
    package Task {
        part def Task :> Asset {
            doc /* {{block(Asset)}} that defines a goal that needs to be achieved*/
            attribute TaskType [1] : Profile::DataTypes::string {
                doc 
                /* semantic goal of the task
                 *
                 * Examples include `MOVE_MATERIAL` and `CHANGE_TOOL`.*/
            }
            attribute TaskState [1] : Profile::DataTypes::TaskStateEnum {
                doc /* {{termuniversal(state)}} of the task*/
            }
            private attribute ParentTaskAssetId [0..1] : Profile::DataTypes::ID {
                doc /* reference to the {{property(Task::assetId)}} of the parent task*/
            }
            part hasSubTask [0..*] : Task::Task;
            ref part hasCoordinator [1] : Collaborator;
            part hasCollaborator [1..*] : Collaborator;
            state def Task {
                item def sucess;
                item def failure;
                item def all_commit;
                item def quorum;
                item def no_commit;
                item def activated;
                item def task_created_by_subtask_coordinator;
                state States {
                    transition first create then INACTIVE;
                    transition first INACTIVE accept activated then PREPARING;
                    transition first PREPARING accept quorum then COMMITTING;
                    transition first COMMITTING accept all_commit then COMMITTED;
                    transition first COMMITTED accept sucess then COMPLETE;
                    transition first COMMITTED accept failure then FAIL;
                    // "Feature Membership -> Transition" is incompatible with textual.
                    // "Feature Membership -> Transition" is incompatible with textual.
                    transition first INACTIVE accept failure then FAIL;
                    transition first COMMITTING accept no_commit then PREPARING;
                    transition first PREPARING accept failure then FAIL;
                    transition first COMMITTING accept failure then FAIL;
                    transition first INACTIVE accept task_created_by_subtask_coordinator then COMMITTING;
                    state create :>> startShot;
                    state INACTIVE;
                    state PREPARING;
                    state COMMITTING;
                    state COMMITTED;
                    state COMPLETE;
                    state FAIL;
                }
            }
        }
        connection def SubTasks {
            end hasSubTask : 'Asset Information Model'::Task::Task => target.hasSubTask;
            doc /* group of {{block(SubTask)}}s*/
            private end : 'Asset Information Model'::Task::Task;
        }
        connection def {
            end hasCoordinator : Collaborator => target.hasCoordinator;
            private end : 'Asset Information Model'::Task::Task;
        }
        connection def Collaborators {
            end hasCollaborator : Collaborator => target.hasCollaborator;
            private end : 'Asset Information Model'::Task::Task;
        }
        package 'Task Archetype' {
            part def Collaborator {
                doc /* {{block(Device)}} or {{block(Component)}} that is required to implement a {{block(Task)}}*/
                attribute collaboratorId [1] : Profile::DataTypes::ID {
                    doc /* identifier for the collaborator*/
                }
                attribute type [0..1] : Profile::DataTypes::string {
                    doc 
                    /* {{termuniversal(type)}} of the collaborator
                     *
                     * Examples include `ROBOT`, `CNC`, `CMM` and `BUFFER`.*/
                }
                attribute optional [0..1] : Profile::DataTypes::boolean default false {
                    doc /* indicates if the collaborator is discretionary and not mandatory to implement a task*/
                }
                part hasTarget [1..*] : Process::Target::Target;
                state def Collaborator {
                    item def task_created;
                    item def commit_failure;
                    item def commit;
                    item def success;
                    item def failure;
                    item def task_created_by_subtask_coordinator;
                    state States {
                        transition first unavailable then INACTIVE;
                        transition first INACTIVE accept task_created then PREPARING;
                        transition first PREPARING accept commit then COMMITTED;
                        transition first COMMITTED accept commit_failure then PREPARING;
                        transition first COMMITTED accept success then INACTIVE;
                        transition first COMMITTED accept failure then INACTIVE;
                        transition first INACTIVE accept task_created_by_subtask_coordinator then COMMITTED;
                        state unavailable :>> startShot;
                        state INACTIVE;
                        state PREPARING;
                        state COMMITTED;
                    }
                }
                state def Coordinator {
                    item def create_and_bind_to_task;
                    item def success;
                    item def failure;
                    state States {
                        transition first unavailable then INACTIVE;
                        transition first INACTIVE accept create_and_bind_to_task then COMMITTED;
                        transition first COMMITTED accept success then INACTIVE;
                        transition first COMMITTED accept failure then INACTIVE;
                        state unavailable :>> startShot;
                        state INACTIVE;
                        state COMMITTED;
                    }
                }
                exhibit state : Collaborator;
            }
            connection def Targets {
                end hasTarget : Process::Target::Target => target.hasTarget;
                private end : Collaborator;
            }
            part def TaskArchetype :> Asset {
                doc /* {{block(Asset)}} that defines common data for all derived {{block(Task)}}s*/
                ref part hasCollaborator [1..*] : Collaborator;
                ref part hasCoordinator [1] : Collaborator;
                attribute TaskType [1] : Profile::DataTypes::string {
                    doc 
                    /* semantic goal of the task
                     *
                     * Examples include `MOVE_MATERIAL` and `CHANGE_TOOL`.*/
                }
                ref part isSubTaskOf [0..1] : TaskArchetype;
                part hasSubTask [0..*] : TaskArchetype;
                private attribute Priority [0..1] : Profile::DataTypes::integer {
                    doc /* relative importance that determines the order in which a task should be performed*/
                }
                part hasTarget [0..*] : Process::Target::Target;
            }
            connection def SubTaskRef {
                end taskArchetype2 : TaskArchetype => taskArchetype3.isSubTaskOf;
                end taskArchetype3 : TaskArchetype => taskArchetype2.hasSubTask;
                attribute 'parallel' [0..1] : Profile::DataTypes::boolean default false {
                    doc /* indication signifying that subtasks can be executed simultaneously*/
                }
                attribute group [0..1] : Profile::DataTypes::string {
                    doc /* identifier to a set of subtasks organized to be treated collectively within the parent task*/
                }
                attribute order [1] : Profile::DataTypes::integer {
                    doc /* position of a subtask within an explicit arrangement where one subtask follows another*/
                }
                attribute optional [0..1] : Profile::DataTypes::boolean default false {
                    doc /* indicates if a subtask is discretionary and not mandatory*/
                }
                private attribute value [0..1] : Profile::DataTypes::string;
            }
            connection def Coordinator {
                end hasCoordinator : Collaborator => target.hasCoordinator;
                private end : TaskArchetype;
            }
            connection def Targets {
                end hasTarget : Process::Target::Target => target.hasTarget;
                private end : TaskArchetype;
            }
            connection def Collaborators {
                end hasCollaborator : Collaborator => target.hasCollaborator;
                private end : TaskArchetype;
            }
            doc /* This section provides semantic information for the {{block(TaskArchetype)}} model.
             */
        }
        part def Collaborator {
            doc /* {{block(Device)}} or {{block(Component)}} that is required to implement a {{block(Task)}}*/
            attribute collaboratorId [1] : Profile::DataTypes::ID {
                doc /* identifier for the collaborator*/
            }
            attribute type [0..1] : Profile::DataTypes::string {
                doc 
                /* {{termuniversal(type)}} of the collaborator
                 *
                 * Examples include `ROBOT`, `CNC`, `CMM` and `BUFFER`.*/
            }
            private attribute collaboratorDeviceUuid [1] : Profile::DataTypes::ID {
                doc /* reference to the {{block(Device::uuid)}} of the collaborating device*/
            }
            private attribute requirementId [0..1] : Profile::DataTypes::ID {
                doc /* reference to the identifier of the target requirements that the collaborator satisfies*/
            }
            state def Collaborator {
                item def task_created;
                item def commit_failure;
                item def commit;
                item def success;
                item def failure;
                item def task_created_by_subtask_coordinator;
                state States {
                    transition first unavailable then INACTIVE;
                    transition first INACTIVE accept task_created then PREPARING;
                    transition first PREPARING accept commit then COMMITTED;
                    transition first COMMITTED accept commit_failure then PREPARING;
                    transition first COMMITTED accept success then INACTIVE;
                    transition first COMMITTED accept failure then INACTIVE;
                    transition first INACTIVE accept task_created_by_subtask_coordinator then COMMITTED;
                    state unavailable :>> startShot;
                    state INACTIVE;
                    state PREPARING;
                    state COMMITTED;
                }
            }
            state def Coordinator {
                item def create_and_bind_to_task;
                item def success;
                item def failure;
                state States {
                    transition first unavailable then INACTIVE;
                    transition first INACTIVE accept create_and_bind_to_task then COMMITTED;
                    transition first COMMITTED accept success then INACTIVE;
                    transition first COMMITTED accept failure then INACTIVE;
                    state unavailable :>> startShot;
                    state INACTIVE;
                    state COMMITTED;
                }
            }
            exhibit state : Collaborator;
        }
        doc /* This section provides semantic information for the {{block(Task)}} model.
         */
    }
    doc 
    /* The MTConnect Standard supports a simple distributed storage mechanism that allows applications and equipment to share and exchange complex information models in a similar way to a distributed data store.  The {{term(Asset Information Model)}} associates each {{block(MTConnectAssets)}} entity with a unique identifier and allows for some predefined mechanisms to find, create, request, update, and delete these electronic documents in a way that provides for consistency across multiple pieces of equipment.
     *
     * The protocol provides a limited mechanism of accessing {{termplural(Asset)}} using the following properties: {{property(Asset::assetId)}}, {{term(asset)}} type (element name of {{term(asset)}} root), and the piece of equipment associated with the {{term(asset)}}.  These access strategies will provide the following services and answer the following questions: What {{termplural(asset)}} are from a particular piece of equipment?  What are the {{termplural(asset)}} of a particular type? What {{term(asset)}} is stored for a given {{property(Asset::assetId)}}?
     *
     * Although these mechanisms are provided, an {{term(agent)}} should not be considered a data store or a system of reference.  The {{term(agent)}} is providing an ephemeral storage capability that will temporarily manage the data for applications wishing to communicate and manage data as needed by the various processes.  An application cannot rely on an {{term(agent)}} for long term persistence or durability since the {{term(agent)}} is only required to temporarily store the {{term(asset)}} data and may require another system to provide the source data upon initialization.  An {{term(agent)}} is always providing the best-known equipment centric view of the data given the limitations of that piece of equipment.
     *
     * The MTConnect Standard has two data item types to support change notification when an {{term(Asset)}} is added, updated or removed. {{block(AssetChanged)}} states the {{property(Asset::assetId)}} of the {{term(Asset)}} that has been added or updated. {{block(AssetRemoved)}} states the {{property(Asset::assetId)}} of the {{term(Asset)}} that has been removed. See {{package(Observation Information Model)}} for more details.*/
    comment /* Assets Appendix*/
    doc 
    /* {{newpage()}}
     *
     * ## XML Schema Diagrams
     *
     * See XML schemas for the MTConnect standard here: {{url(https://schemas.mtconnect.org/)}}.
     *
     * ### Assets Schema Diagrams
     *
     * See `Asset` element in `MTConnectAssets` schema.
     *
     * See `Description` element in `MTConnectAssets` schema.
     *
     * ### CuttingTool Schema Diagrams
     *
     * See `CuttingTool` element in `MTConnectAssets` schema.
     *
     * See `CuttingToolDefinition` element in `MTConnectAssets` schema.
     *
     * See `CuttingToolArchetypeReference` element in `MTConnectAssets` schema.
     *
     * ### CuttingToolLifeCycle Schema Diagrams
     *
     * See `CuttingToolLifeCycle` element in `MTConnectAssets` schema.
     *
     * See `CutterStatus` element in `MTConnectAssets` schema.
     *
     * See `Location` element in `MTConnectAssets` schema.
     *
     * See `Measurement` element in `MTConnectAssets` schema.
     *
     * See `ProcessFeedRate` element in `MTConnectAssets` schema.
     *
     * See `ProcessSpindleSpeed` element in `MTConnectAssets` schema.
     *
     * See `ReconditionCount` element in `MTConnectAssets` schema.
     *
     * See `ToolLife` element in `MTConnectAssets` schema.
     *
     * ### CuttingItem Schema Diagrams
     *
     * See `CuttingItems` element in `MTConnectAssets` schema.
     *
     * See `CuttingItem` element in `MTConnectAssets` schema.
     *
     * See `ItemLife` element in `MTConnectAssets` schema.
     *
     * ### ISO 13399 Diagrams
     *
     * #### Measurement Diagrams
     *
     * ![Cutting Tool Measurement 3](figures/Cutting%20Tool%20Measurement%203.png "Cutting Tool Measurement 3"){: width="0.8"}
     *
     * ![Cutting Tool Measurement 4](figures/Cutting%20Tool%20Measurement%204.png "Cutting Tool Measurement 4"){: width="0.8"}
     *
     * ![Cutting Tool Measurement 5](figures/Cutting%20Tool%20Measurement%205.png "Cutting Tool Measurement 5"){: width="0.8"}
     *
     * ![Cutting Tool Measurement 6](figures/Cutting%20Tool%20Measurement%206.png "Cutting Tool Measurement 6"){: width="0.8"}
     *
     * ![Cutting Tool Measurement 7](figures/Cutting%20Tool%20Measurement%207.png "Cutting Tool Measurement 7"){: width="0.8"}
     *
     * ![Cutting Tool Measurement 8](figures/Cutting%20Tool%20Measurement%208.png "Cutting Tool Measurement 8"){: width="0.8"}
     *
     * ### Cutting Tool Examples
     *
     * #### Shell Mill
     *
     * ![Shell Mill Side View](figures/Shell%20Mill%20Side%20View.png "Shell Mill Side View"){: width="0.8"}
     *
     * ![Indexable Insert Measurements](figures/Indexable%20Insert%20Measurements.png "Indexable Insert Measurements"){: width="0.8"}
     *
     * ~~~~xml
     * <?xml version="1.0" encoding="UTF-8"?>
     * <MTConnectAssets 
     * xmlns:m="urn:mtconnect.org:MTConnectAssets:1.2" 
     * xmlns="urn:mtconnect.org:MTConnectAssets:1.2" 
     * xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
     * xsi:schemaLocation="urn:mtconnect.org:MTConnectAssets:1.2
     * http://mtconnect.org/schemas/MTConnectAssets\_1.2.xsd">
     *   <Header creationTime="2011-05-11T13:55:22" 
     *   assetBufferSize="1024" sender="localhost"
     *   assetCount="2" version="1.2" instanceId="1234"/>
     *   <Assets>
     *   <CuttingTool serialNumber="1" toolId="KSSP300R4SD43L240" 
     *   timestamp="2011-05-11T13:55:22" assetId="KSSP300R4SD43L240.1" 
     *   manufacturers="KMT,Parlec">
     *     <CuttingToolLifeCycle>
     *     <CutterStatus><Status>NEW</Status></CutterStatus>
     *     <ProcessSpindleSpeed maximum="13300" 
     *     nominal="605">10000</ProcessSpindleSpeed>
     *     <ProcessFeedRate
     *     nominal="9.22">9.22</ProcessSpindleSpeed>
     *     <ConnectionCodeMachineSide>CV50
     *     </ConnectionCodeMachineSide>
     *     <Measurements>
     *       <BodyDiameterMax code="BDX">73.25
     *       </BodyDiameterMax>
     *       <OverallToolLength nominal="222.25" 
     *         minimum="221.996" maximum="222.504" 
     *         code="OAL">222.25</OverallToolLength>
     *       <UsableLengthMax code="LUX" nominal="82.55">82.55
     *       </UsableLengthMax>
     *       <CuttingDiameterMax code="DC" nominal="76.2" 
     *         maximum="76.213" minimum="76.187">76.2
     *       </CuttingDiameterMax>
     *       <BodyLengthMax code="LF" nominal="120.65" 
     *         maximum="120.904" minimum="120.404">120.65
     *       </BodyLengthMax>
     *       <DepthOfCutMax code="APMX" 
     *       nominal="60.96">60.95</DepthOfCutMax>
     *       <FlangeDiameterMax code="DF" 
     *         nominal="98.425">98.425</FlangeDiameterMax>
     *     </Measurements>
     *     <CuttingItems count="24">
     *       <CuttingItem indices="1-24" itemId="SDET43PDER8GB" 
     *         manufacturers="KMT" grade="KC725M">
     *         <Measurements>
     *           <CuttingEdgeLength code="L" nominal="12.7" 
     *             minimum="12.675" maximum="12.725">12.7
     *           </CuttingEdgeLength>
     *         <WiperEdgeLength code="BS" nominal=
     *           "2.56">2.56</WiperEdgeLength>
     *         <IncribedCircleDiameter code="IC"
     *           nominal="12.7">12.7
     *         </IncribedCircleDiameter>
     *         <CornerRadius code="RE" nominal="0.8">
     *           0.8</CornerRadius>
     *       </Measurements>
     *       </CuttingItem>
     *     </CuttingItems>
     *     </CuttingToolLifeCycle>
     *     </CuttingTool>
     *   </Assets>
     * </MTConnectAssets>
     * ~~~~
