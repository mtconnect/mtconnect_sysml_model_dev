        }
    }
}
package 'WIP: Use Cases' {
    package 'Machine Monitoring' {
        part def 'Manufacturing Equipment' {
            include use case : 'What is the Device Utilization?';
            include use case : 'Monitor Operational States' {
                subject ;
            }
        }
        requirement <monitoring_req> 'Machine Monitoring' {
            doc /* Requirements for Machine Monitoring Use Case*/
        }
        #ModelingMetadata::refinement dependency from 'Machine Monitoring' to 'Monitor Operational States';
        use case def 'What is the Device Utilization?';
        use case def 'Monitor Operational States' {
            subject ;
            actor : Actors::Operator;
            include use case : 'What is the Device Utilization?';
        }
    }
    package Actors {
        part def Operator;
    }
    package 'Power Source' {
        part def 'Manufacturing Equipment' {
            include use case : 'What is the active power source?';
            include use case : 'Look up the power source configuration.' {
                subject ;
            }
        }
        use case def 'What is the active power source?';
        use case def 'Look up the power source configuration.' {
            subject ;
            actor : Actors::Operator;
            include use case : 'What is the active power source?';
        }
        requirement <power_config_req> 'Power Configuration Lookup' {
            doc /* Requirements for Power Configuration Lookup Use Case*/
        }
        #ModelingMetadata::refinement dependency from 'Power Configuration Lookup' to 'Look up the power source configuration.';
    }
}
