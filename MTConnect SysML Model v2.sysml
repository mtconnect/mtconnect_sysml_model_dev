            OPEN {
                doc /* position of the {{block(Composition)}} is open to the point of a positive confirmation.*/
            }
            UNLATCHED {
                doc 
                /* position of the {{block(Composition)}} is not open to the
                 * point of a positive confirmation and is not closed to the point of a positive confirmation. 
                 *
                 * It is in an intermediate position.*/
            }
            CLOSED {
                doc /* position of the {{block(Composition)}} is closed to the point of a positive confirmation.*/
            }
        }
        enum def ActuatorStateEnum {
            ACTIVE {
                doc /* {{block(Actuator)}} is operating.*/
            }
            INACTIVE {
                doc /* {{block(Actuator)}} is not operating.*/
            }
        }
        enum def ConnectionStatusEnum {
            CLOSED {
                doc /* no connection at all.*/
            }
            LISTEN {
                doc /* {{term(agent)}} is waiting for a connection request from an {{term(adapter)}}.*/
            }
            ESTABLISHED {
                doc 
                /* open connection.
                 *
                 * The normal state for the data transfer phase of the connection.*/
            }
        }
        enum def RoleTypeEnum {
            SYSTEM {
                doc /* associated element performs the functions of a {{block(System)}} for this element.*/
            }
            AUXILIARY {
                doc /* associated element performs the functions as an `Auxiliary` for this element.*/
            }
        }
        enum def PathModeEnum {
            INDEPENDENT {
                doc /* path is operating independently and without the influence of another path.*/
            }
            MASTER {
                doc /* path provides information or state values that influences the operation of other {{block(DataItem)}} of similar type.*/
            }
            SYNCHRONOUS {
                doc /* physical or logical parts which are not physically connected to each other but are operating together.*/
            }
            MIRROR {
                doc /* axes associated with the path are mirroring the motion of the `MASTER` path.*/
            }
        }
        enum def CompositionStateActionEnum {
            ACTIVE {
                doc /* {{block(Composition)}} is operating.*/
            }
            INACTIVE {
                doc /* {{block(Composition)}} is not operating.*/
            }
        }
        private attribute def MILLIMETER :> unit {
            doc /* float that represents measurement in millimeter.*/
        }
        enum def PartProcessingStateEnum {
            NEEDS_PROCESSING {
                doc 
                /* part occurrence is not actively being processed, but the processing has not ended. 
                 *
                 * Processing requirements exist that have not yet been fulfilled. This is the default entry state when the part occurrence is originally received. In some cases, the part occurrence may return to this state while it waits for additional processing to be performed.*/
            }
            IN_PROCESS {
                doc /* part occurrence is actively being processed.*/
            }
            PROCESSING_ENDED {
                doc 
                /* part occurrence is no longer being processed. 
                 *
                 * A general state when the reason for termination is unknown.*/
            }
            PROCESSING_ENDED_COMPLETE {
                doc /* part occurrence has completed processing successfully.*/
            }
            PROCESSING_ENDED_STOPPED {
                doc 
                /* process has been stopped during the processing. 
                 *
                 * The part occurrence will require special treatment.*/
            }
            PROCESSING_ENDED_ABORTED {
                doc /* processing of the part occurrence has come to a premature end.*/
            }
            PROCESSING_ENDED_LOST {
                doc /* terminal state when the part occurrence has been removed from the equipment by an external entity and it no longer exists at the equipment.*/
            }
            PROCESSING_ENDED_SKIPPED {
                doc /* part occurrence has been skipped for processing on the piece of equipment.*/
            }
            PROCESSING_ENDED_REJECTED {
                doc /* part occurrence has been processed completely. However, the processing may have a problem.*/
            }
            WAITING_FOR_TRANSIT {
                doc /* part occurrence is waiting for transit.*/
            }
            IN_TRANSIT {
                doc /* part occurrence is being transported to its destination.*/
            }
            TRANSIT_COMPLETE {
                doc /* part occurrence has been placed at its designated destination.*/
            }
        }
        enum def ControllerModeEnum {
            AUTOMATIC {
                doc /* {{block(Controller)}} is configured to automatically execute a program.*/
            }
            MANUAL {
                doc 
                /* {{block(Controller)}} is not executing an active program. 
                 *
                 * It is capable of receiving instructions from an external source – typically an operator. The {{block(Controller)}} executes operations based on the instructions received from the external source.*/
            }
            MANUAL_DATA_INPUT {
                doc 
                /* operator can enter a series of operations for the {{block(Controller)}} to perform.
                 *
                 * The {{block(Controller)}} will execute this specific series of operations and then stop.*/
            }
            SEMI_AUTOMATIC {
                doc /* {{block(Controller)}} is operating in a mode that restricts the active program from processing its next process step without operator intervention.*/
            }
            EDIT {
                doc /* {{block(Controller)}} is currently functioning as a programming device and is not capable of executing an active program.*/
            }
            FEED_HOLD {
                doc /* axes of the device are commanded to stop, but the spindle continues to function.*/
            }
        }
        enum def DirectionLinearEnum {
            POSITIVE {
                doc /* linear position is increasing.*/
            }
            NEGATIVE {
                doc /* linear position is decreasing.*/
            }
            NONE {
                doc /* no direction.*/
            }
        }
        enum def EndOfBarEnum {
            YES {
                doc /* {{block(EndOfBar)}} has been reached.*/
            }
            NO {
                doc /* {{block(EndOfBar)}} has not been reached.*/
            }
        }
        enum def LocationTypeEnum {
            doc /* Enumeration for Location types*/
            POT {
                doc /* number of the pot in the tool handling system.*/
            }
            STATION {
                doc /* tool location in a horizontal turning machine.*/
            }
            CRIB {
                doc /* location with regard to a tool crib.*/
            }
            SPINDLE {
                doc /* location associated with a {{term(spindle)}}.*/
            }
            TRANSFER_POT {
                doc /* location for a tool awaiting transfer from a tool magazine to spindle or a turret.*/
            }
            RETURN_POT {
                doc /* location for a tool removed from a {{term(spindle)}} or turret and awaiting return to a tool magazine.*/
            }
            STAGING_POT {
                doc /* location for a tool awaiting transfer to a tool magazine or turret from outside of the piece of equipment.*/
            }
            REMOVAL_POT {
                doc /* location for a tool removed from a tool magazine or turret awaiting transfer to a location outside of the piece of equipment.*/
            }
            EXPIRED_POT {
                doc /* location for a tool that is no longer usable and is awaiting removal from a tool magazine or turret.*/
            }
            END_EFFECTOR {
                doc /* location associated with an end effector.*/
            }
        }
        enum def ValveStateEnum {
            OPEN {
                doc 
                /* {{block(ValveState)}} where flow is allowed and the aperture is static.
                 *
                 * > Note: For a binary value, `OPEN` indicates the valve has the maximum possible aperture.*/
            }
            OPENING {
                doc /* valve is transitioning from a `CLOSED` state to an `OPEN` state.*/
            }
            CLOSED {
                doc /* {{block(ValveState)}} where flow is not possible, the aperture is static, and the valve is completely shut.*/
            }
            CLOSING {
                doc /* valve is transitioning from an `OPEN` state to a `CLOSED` state.*/
            }
        }
        enum def CodeEnum {
            BDX {
                doc /* largest diameter of the body of a tool item.*/
            }
            LBX {
                doc /* distance measured along the X axis from that point of the item closest to the workpiece, including the cutting item for a tool item but excluding a protruding locking mechanism for an adaptive item, to either the front of the flange on a flanged body or the beginning of the connection interface feature on the machine side for cylindrical or prismatic shanks.*/
            }
            APMX {
                doc /* maximum engagement of the cutting edge or edges with the workpiece measured perpendicular to the feed motion.*/
            }
            DC {
                doc /* maximum diameter of a circle on which the defined point Pk of each of the master inserts is located on a tool item. The normal of the machined peripheral surface points towards the axis of the cutting tool.*/
            }
            DF {
                doc /* dimension between two parallel tangents on the outside edge of a flange.*/
            }
            OAL {
                doc /* largest length dimension of the cutting tool including the master insert where applicable.*/
            }
            DMM {
                doc /* dimension of the diameter of a cylindrical portion of a tool item or an adaptive item that can participate in a connection.*/
            }
            H {
                doc /* dimension of the height of the shank.*/
            }
            LS {
                doc /* dimension of the length of the shank.*/
            }
            LUX {
                doc /* maximum length of a cutting tool that can be used in a particular cutting operation including the non-cutting portions of the tool.*/
            }
            LPR {
                doc /* dimension from the yz-plane to the furthest point of the tool item or adaptive item measured in the -X direction.*/
            }
            WT {
                doc 
                /* total weight of the cutting tool in grams. 
                 *
                 * The force exerted by the mass of the cutting tool.*/
            }
            LF {
                doc 
                /* distance from the gauge plane or from the end of the shank to the furthest point on the tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. 
                 *
                 * The {{block(CuttingTool)}} functional length will be the length of the entire tool, not a single cutting item. Each {{block(CuttingItem)}} can have an independent {{block(FunctionalLength)}} represented in its measurements. */
            }
            CRP {
                doc /* theoretical sharp point of the cutting tool from which the major functional dimensions are taken.*/
            }
            L {
                doc /* theoretical length of the cutting edge of a cutting item over sharp corners.*/
            }
            DRVA {
                doc /* angle between the driving mechanism locator on a tool item and the main cutting edge.*/
            }
            WF {
                doc /* distance between the cutting reference point and the rear backing surface of a turning tool or the axis of a boring bar.*/
            }
            IC {
                doc /* diameter of a circle to which all edges of a equilateral and round regular insert are tangential.*/
            }
            SIG {
                doc /* angle between the major cutting edge and the same cutting edge rotated by 180 degrees about the tool axis.*/
            }
            KAPR {
                doc /* angle between the tool cutting edge plane and the tool feed plane measured in a plane parallel the xy-plane.*/
            }
            PSIR {
                doc /* angle between the tool cutting edge plane and a plane perpendicular to the tool feed plane measured in a plane parallel the xy-plane.*/
            }
            'N/A' {
                doc 
                /* angle of the tool with respect to the workpiece for a given process. 
                 *
                 * The value is application specific.*/
            }
            BS {
                doc /* measure of the length of a wiper edge of a cutting item.*/
            }
            SDLx {
                doc /* length of a portion of a stepped tool that is related to a corresponding cutting diameter measured from the cutting reference point of that cutting diameter to the point on the next cutting edge at which the diameter starts to change.*/
            }
            STAx {
                doc /* angle between a major edge on a step of a stepped tool and the same cutting edge rotated 180 degrees about its tool axis.*/
            }
            DCx {
                doc 
                /* diameter of a circle on which the defined point Pk located on this cutting tool.
                 *
                 * The normal of the machined peripheral surface points towards the axis of the cutting tool.*/
            }
            HF {
                doc /* distance from the basal plane of the tool item to the cutting point.*/
            }
            RE {
                doc /* nominal radius of a rounded corner measured in the X Y-plane.*/
            }
            LFx {
                doc 
                /* distance from the gauge plane or from the end of the shank of the cutting tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. 
                 *
                 * This measurement will be with reference to the cutting tool and **MUST NOT** exist without a cutting tool.*/
            }
            BCH {
                doc /* flat length of a chamfer.*/
            }
            CHW {
                doc /* width of the chamfer.*/
            }
            W1 {
                doc /* insert width when an inscribed circle diameter is not practical.*/
            }
        }
        enum def ApplicationCategoryEnum {
            ASSEMBLY {
                doc /* files regarding the fully assembled product.*/
            }
            DEVICE {
                doc /* device related files.*/
            }
            HANDLING {
                doc /* files relating to the handling of material.*/
            }
            MAINTENANCE {
                doc /* files relating to equipment maintenance.*/
            }
            PART {
                doc /* files relating to a part.*/
            }
            PROCESS {
                doc /* files related to the manufacturing process.*/
            }
            INSPECTION {
                doc /* files related to the quality inspection.*/
            }
            SETUP {
                doc /* files related to the setup of a process.*/
            }
        }
        enum def CutterStatusTypeEnum {
            doc /* Enumeration for CutterStatus values.*/
            NEW {
                doc 
                /* new tool that has not been used or first use. 
                 *
                 * Marks the start of the tool history.*/
            }
            AVAILABLE {
                doc 
                /* tool is available for use. 
                 *
                 * If this is not present, the tool is currently not ready to be used.*/
            }
            UNAVAILABLE {
                doc /* tool is unavailable for use in metal removal. */
            }
            ALLOCATED {
                doc /* tool is has been committed to a piece of equipment for use and is not available for use in any other piece of equipment.*/
            }
            UNALLOCATED {
                doc /* tool has not been committed to a process and can be allocated.*/
            }
            MEASURED {
                doc /* tool has been measured.*/
            }
            RECONDITIONED {
                doc /* tool has been reconditioned.*/
            }
            USED {
                doc /* tool is in process and has remaining tool life.*/
            }
            EXPIRED {
                doc /* tool has reached the end of its useful life.*/
            }
            BROKEN {
                doc /* premature tool failure.*/
            }
            NOT_REGISTERED {
                doc /* tool cannot be used until it is entered into the system.*/
            }
            UNKNOWN {
                doc /* tool is an indeterminate state. This is the default value.*/
            }
        }
        enum def CompositionStateLateralEnum {
            RIGHT {
                doc /* position of the {{block(Composition)}} is oriented to the right to the point of a positive confirmation.*/
            }
            LEFT {
                doc /* position of the {{block(Composition)}} is oriented to the left to the point of a positive confirmation.*/
            }
            TRANSITIONING {
                doc 
                /* position of the {{block(Composition)}} is not oriented to the right to the point of a positive confirmation and is not oriented to the left to the point of a positive confirmation. 
                 *
                 * It is in an intermediate position.*/
            }
        }
        enum def PartDetectEnum {
            PRESENT {
                doc /* part or work piece is detected or is present.*/
            }
            NOT_PRESENT {
                doc /* part or work piece is not detected or is not present.*/
            }
        }
        enum def ExecutionEnum {
            READY {
                doc 
                /* {{block(Component)}} is ready to execute instructions.
                 *
                 * It is currently idle.*/
            }
            ACTIVE {
                doc /* {{block(Component)}} is actively executing an instruction.*/
            }
            INTERRUPTED {
                doc 
                /* {{block(Component)}} suspends the execution of the program due to an external signal.
                 *
                 * Action is required to resume execution.*/
            }
            FEED_HOLD {
                doc /* motion of the active axes are commanded to stop at their current position.*/
            }
            STOPPED {
                doc /* {{block(Component)}} program is not `READY` to execute.*/
            }
            OPTIONAL_STOP {
                doc 
                /* command from the program has intentionally interrupted execution.
                 *
                 * The {{block(Component)}} **MAY** have another state that indicates if the execution is interrupted or the execution ignores the interrupt instruction.*/
            }
            PROGRAM_STOPPED {
                doc 
                /* command from the program has intentionally interrupted execution.
                 *
                 * Action is required to resume execution.*/
            }
            PROGRAM_COMPLETED {
                doc /* program completed execution.*/
            }
            WAIT {
                doc 
                /* {{block(Component)}} suspends execution while a secondary operation executes.
                 *
                 * Execution resumes automatically once the secondary operation completes.*/
            }
            PROGRAM_OPTIONAL_STOP {
                doc 
                /* program has been intentionally optionally stopped using an M01 or similar code.
                 *
                 * **DEPRECATED** in *version 1.4* and replaced with `OPTIONAL_STOP`.*/
            }
        }
        private attribute def DEGREE :> unit {
            doc /* float that represents angle in degrees.*/
