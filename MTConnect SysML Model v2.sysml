                part hasHeader [1] : Fundamentals::'MTConnect Protocol'::'MTConnectDevices Response Document'::Header;
                part hasDevice [1..*] : 'Device Information Model'::Device;
            }
            connection def Devices {
                end hasDevice : 'Device Information Model'::Device => target.hasDevice;
                doc /* {{block(Devices)}} groups one or more {{block(Device)}} entities. See {{package(Device Information Model)}} for more detail.*/
                private end : MTConnectDevices;
            }
            connection def AssetCounts {
                end hasAssetCount : AssetCount => target.hasAssetCount;
                doc /* {{block(AssetCounts)}} groups {{block(AssetCount)}} entities.*/
                private end : Fundamentals::'MTConnect Protocol'::'MTConnectDevices Response Document'::Header;
            }
            connection def Header {
                end hasHeader : Fundamentals::'MTConnect Protocol'::'MTConnectDevices Response Document'::Header => target.hasHeader;
                private end : MTConnectDevices;
