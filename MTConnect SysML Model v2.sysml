library package Profile {
    package DataTypes {
        enum def CoordinateSystemEnum {
            MACHINE {
                doc /* unchangeable coordinate system that has machine zero as its origin.*/
            }
            WORK {
                doc 
                /* coordinate system that represents the working area for a particular workpiece whose origin is shifted within the `MACHINE` coordinate system.
                 *
                 * If the `WORK` coordinates are not currently defined in the piece of equipment, the `MACHINE` coordinates will be used.*/
            }
        }
        enum def ResetTriggerEnum {
            ACTION_COMPLETE {
                doc /* {{term(observation)}} of the {{block(DataItem)}} that is measuring an action or operation is to be reset upon completion of that action or operation.*/
            }
            ANNUAL {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset at the end of a 12-month period.*/
            }
            DAY {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset at the end of a 24-hour period.*/
            }
            LIFE {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is not reset and accumulates for the entire life of the piece of equipment.*/
            }
            MAINTENANCE {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset upon completion of a maintenance event.*/
            }
            MONTH {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset at the end of a monthly period.*/
            }
            POWER_ON {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset when power was applied to the piece of equipment after a planned or unplanned interruption of power has occurred.*/
            }
            SHIFT {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset at the end of a work shift.*/
            }
            WEEK {
                doc /* {{term(observation)}} of the {{block(DataItem)}} is to be reset at the end of a 7-day period.*/
            }
        }
        enum def StatisticEnum {
            AVERAGE {
                doc /* mathematical average value calculated for the data item during the calculation period.*/
            }
            KURTOSIS {
                doc /* **DEPRECATED** in *Version 1.6*. ~~A measure of the "peakedness" of a probability distribution; i.e., the shape of the distribution curve.~~*/
            }
            MAXIMUM {
                doc /* maximum or peak value recorded for the data item during the calculation period.*/
            }
            MEDIAN {
                doc /* middle number of a series of numbers.*/
            }
            MINIMUM {
                doc /* minimum value recorded for the data item during the calculation period.*/
            }
            MODE {
                doc /* number in a series of numbers that occurs most often.*/
            }
            RANGE {
                doc /* difference between the maximum and minimum value of a data item during the calculation period. Also represents Peak-to-Peak measurement in a waveform.*/
            }
            ROOT_MEAN_SQUARE {
                doc /* mathematical Root Mean Square (RMS) value calculated for the data item during the calculation period.*/
            }
            STANDARD_DEVIATION {
                doc /* statistical Standard Deviation value calculated for the data item during the calculation period.*/
            }
        }
        enum def UnitEnum {
            AMPERE {
                doc /* electric current in ampere.*/
            }
            CELSIUS {
                doc /* temperature in degree Celsius.*/
            }
            COUNT {
                doc /* count of something.*/
            }
            DECIBEL {
                doc /* sound level in decibel.*/
            }
            DEGREE {
                doc /* angle in degree.*/
            }
            DEGREE_3D {
                doc 
                /* space-delimited, floating-point representation of the angular rotation in degrees around the X, Y, and Z axes relative to a cartesian coordinate system respectively in order as A, B, and C. 
                 *
                 * If any of the rotations is not known, it **MUST** be zero (0).*/
            }
            'DEGREE/SECOND' {
                doc /* angular velocity in degree per second.*/
            }
            'DEGREE/SECOND^2' {
                doc /* angular acceleration in degree per second squared.*/
            }
            HERTZ {
                doc /* frequency in cycles per second.*/
            }
            JOULE {
                doc /* energy in joule.*/
            }
            KILOGRAM {
                doc /* mass in kilogram.*/
            }
            LITER {
                doc /* volume in liter.*/
            }
            'LITER/SECOND' {
                doc /* volumetric flow in liter per second.*/
            }
            MICRO_RADIAN {
                doc /* tilt in micro radian.*/
            }
            MILLIMETER {
                doc /* length in millimeter.*/
            }
            MILLIMETER_3D {
                doc /* point in space identified by X, Y, and Z positions and represented by a space-delimited set of numbers each expressed in millimeters.*/
            }
            'MILLIMETER/REVOLUTION' {
                doc /* feedrate per revolution in millimeter per revolution.*/
            }
            'MILLIMETER/SECOND' {
                doc /* speed in millimeter per second.*/
            }
            'MILLIMETER/SECOND^2' {
                doc /* acceleration in millimeter per second squared.*/
            }
            NEWTON {
                doc /* force in newton.*/
            }
            NEWTON_METER {
                doc /* torque in newton-meter.*/
            }
            OHM {
                doc /* electrical resistance in ohm.*/
            }
            PASCAL {
                doc /* pressure or stress in pascal.*/
            }
            PASCAL_SECOND {
                doc /* viscosity in pascal-second.*/
            }
            PERCENT {
                doc /* amount in or for every hundred.*/
            }
            PH {
                doc /* acidity or alkalinity of a solution in pH.*/
            }
            'REVOLUTION/MINUTE' {
                doc /* rotational velocity in revolution per minute.*/
            }
            SECOND {
                doc /* time in second.*/
            }
            'SIEMENS/METER' {
                doc /* electrical conductivity in siemens per meter.*/
            }
            VOLT {
                doc /* electric potential, electric potential difference or electromotive force in volt.*/
            }
            VOLT_AMPERE {
                doc /* apparent power in an electrical circuit, equal to the product of root-mean-square (RMS) voltage and RMS current (commonly referred to as VA) in volt-ampere.*/
            }
            VOLT_AMPERE_REACTIVE {
                doc /* reactive power in an AC electrical circuit (commonly referred to as VAR) in volt-ampere-reactive.*/
            }
            WATT {
                doc /* power in watt.*/
            }
            WATT_SECOND {
                doc /* electrical energy in watt-second*/
            }
            'GRAM/CUBIC_METER' {
                doc /* density in gram per cubic meter.*/
            }
            CUBIC_MILLIMETER {
                doc /* geometric volume in millimeter.*/
            }
            'CUBIC_MILLIMETER/SECOND' {
                doc /* change of geometric volume per second.*/
            }
            'CUBIC_MILLIMETER/SECOND^2' {
                doc /* change in geometric volume per second squared.*/
            }
            MILLIGRAM {
                doc /* mass in milligram.*/
            }
            'MILLIGRAM/CUBIC_MILLIMETER' {
                doc /* density in milligram per cubic millimeter.*/
            }
            MILLILITER {
                doc /* volume in milliliter.*/
            }
            'COUNT/SECOND' {
                doc /* frequency in count per second.*/
            }
            'PASCAL/SECOND' {
                doc /* pressurization rate in pascal per second.*/
            }
            UNIT_VECTOR_3D {
                doc 
                /* 3D Unit Vector.
                 *
                 * Space delimited list of three floating point numbers.*/
            }
            'REVOLUTION/SECOND^2' {
                doc /* rotational acceleration in revolution per second squared.*/
            }
            'REVOLUTION/SECOND' {
                doc /* rotational velocity in revolution per second.*/
            }
            GRAM {
                doc /* mass in gram.*/
            }
            'METER/SECOND^2' {
                doc /* acceleration in meter per second squared.*/
            }
            COULOMB {
                doc /* electric charge in coulomb.*/
            }
            CUBIC_METER {
                doc /* geometric volume in meter.*/
            }
            SQUARE_MILLIMETER {
                doc /* geometric area in millimeter.*/
            }
            OHM_METER {
                doc /* resistivity in ohm-meter.*/
            }
            'MILLIGRAM/LITER' {
                doc /* concentration of a dissolved substance in milligram per liter*/
            }
        }
        enum def DataItemTypeEnum;
        enum def CategoryEnum {
            SAMPLE {
                doc 
                /* continuously variable or analog data value. 
                 *
                 * A continuous value can be measured at any point-in-time and will always produce a result.*/
            }
            EVENT {
                doc /* discrete piece of information from the piece of equipment.*/
            }
            CONDITION {
                doc /* information about the health of a piece of equipment and its ability to function.*/
            }
        }
        enum def DataItemSubTypeEnum {
            ABSOLUTE {
                doc /* relating to or derived in the simplest manner from the fundamental units or measurements.*/
            }
            ACTION {
                doc /* indication of the operating state of a mechanism.*/
            }
            ACTUAL {
                doc /* reported value of an {{term(observation)}}.*/
            }
            ALL {
                doc /* all actions, items, or activities being counted independent of the outcome.*/
            }
            ALTERNATING {
                doc 
                /* measurement of alternating voltage or current. If not specified further in statistic, defaults to RMS voltage. 
                 *
                 * **DEPRECATED** in *Version 1.6*.*/
            }
            A_SCALE {
                doc /* A-Scale weighting factor on the frequency scale.*/
            }
            AUXILIARY {
                doc /* when multiple locations on a piece of bar stock being feed by a bar feeder are referenced as the indication of whether the end of that piece of bar stock has been reached.*/
            }
            BAD {
                doc /* actions, items, or activities being counted that do not conform to specification or expectation.*/
            }
            BRINELL {
                doc /* scale to measure the resistance to deformation of a surface.*/
            }
            B_SCALE {
                doc /* B-Scale weighting factor on the frequency scale.*/
            }
            COMMANDED {
                doc /* directive value including adjustments such as an offset or overrides.*/
            }
            CONSUMED {
                doc /* amount of material consumed from an object or container during a manufacturing process.*/
            }
            CONTROL {
                doc /* state of the enabling signal or control logic that enables or disables the function or operation of the entity.*/
            }
            C_SCALE {
                doc /* C-Scale weighting factor on the frequency scale.*/
            }
            DELAY {
                doc /* elapsed time of a temporary halt of action.*/
            }
            DIRECT {
                doc 
                /* DC current or voltage.
                 *
                 * **DEPRECATED** in *Version 1.6*.*/
            }
            DRY_RUN {
                doc /* setting or operator selection used to execute a test mode to confirm the execution of machine functions.*/
            }
            D_SCALE {
                doc /* D-Scale weighting factor on the frequency scale.*/
            }
            EXPIRATION {
                doc /* relating to the expiration or end of useful life for a material or other physical item.*/
            }
            FIRST_USE {
                doc /* relating to the first use of a material or other physical item.*/
            }
            GOOD {
                doc /* actions, items, or activities being counted that conform to specification or expectation.*/
            }
            INCREMENTAL {
                doc /* relating to or derived from the last {{term(observation)}}.*/
            }
            JOG {
                doc 
                /* relating to momentary activation of a function or a movement.
                 *
                 * **DEPRECATION WARNING**: May be deprecated in the future.*/
            }
            LATERAL {
                doc /* indication of the position of a mechanism that may move in a lateral direction.*/
            }
            LEEB {
                doc /* scale to measure the elasticity of a surface.*/
            }
            LENGTH {
                doc /* reference to a length type tool offset variable.*/
            }
            LINE {
                doc /* state of the power source.*/
            }
            LINEAR {
                doc /* direction of motion of a linear motion.*/
            }
            LOADED {
                doc /* indication that the subparts of a piece of equipment are under load.*/
            }
            MACHINE_AXIS_LOCK {
                doc /* setting or operator selection that changes the behavior of the controller on a piece of equipment.*/
            }
            MAIN {
                doc /* relating to the primary logic or motion program currently being executed.*/
            }
            MAINTENANCE {
                doc /* relating to maintenance on the piece of equipment.*/
            }
            MANUAL_UNCLAMP {
                doc /* indication of the state of an operator controlled interlock that can inhibit the ability to initiate an unclamp action of an electronically controlled chuck.*/
            }
            MANUFACTURE {
                doc /* related to the production of a material or other physical item.*/
            }
            MAXIMUM {
                doc /* maximum value.*/
            }
            MINIMUM {
                doc /* minimum value.*/
            }
            MOHS {
                doc /* scale to measure the resistance to scratching of a surface.*/
            }
            MOTION {
                doc /* indication of the open or closed state of a mechanism.*/
            }
            NO_SCALE {
                doc /* no weighting factor on the frequency scale.*/
            }
            OPERATING {
                doc /* piece of equipment that is powered or performing any activity.*/
            }
            OPERATOR {
                doc /* relating to the person currently responsible for operating the piece of equipment.*/
            }
            OPTIONAL_STOP {
                doc /* setting or operator selection that changes the behavior of the controller on a piece of equipment. */
            }
            OVERRIDE {
                doc /* overridden value.*/
            }
            POWERED {
                doc /* piece of equipment is powered and functioning or {{block(Component)}} that are required to remain on are powered.*/
            }
            PRIMARY {
                doc /* main or principle.*/
            }
            PROBE {
                doc 
                /* position provided by a measurement probe.
                 *
                 * **DEPRECATION WARNING**: May be deprecated in the future.*/
            }
            PROCESS {
                doc /* relating to production of a part or product on a piece of equipment.*/
            }
            PROGRAMMED {
                doc /* directive value without offsets and adjustments.*/
            }
            RADIAL {
                doc /* reference to a radial type tool offset variable.*/
            }
            RAPID {
                doc /* performing an operation faster or in less time than nominal rate.*/
            }
            REMAINING {
                doc /* remaining measure or count of an action, object or activity.*/
            }
            ROCKWELL {
                doc /* scale to measure the resistance to deformation of a surface.*/
            }
            ROTARY {
                doc /* direction of a rotary motion using the right hand rule convention.*/
            }
            SCHEDULE {
                doc /* identity of a control program that is used to specify the order of execution of other programs.*/
            }
            SET_UP {
                doc /* relating to the preparation of a piece of equipment for production or restoring the piece of equipment to a neutral state after production.*/
            }
            SHORE {
                doc /* scale to measure the resistance to deformation of a surface.*/
            }
            SINGLE_BLOCK {
                doc /* setting or operator selection that changes the behavior of the controller on a piece of equipment. */
            }
            STANDARD {
                doc /* standard measure of an object or an action.*/
            }
            START {
                doc /* boundary when an activity or an event commences.*/
            }
            SWITCHED {
                doc /* indication of the activation state of a mechanism represented by a {{block(Composition)}}.*/
            }
            TARGET {
                doc /* goal of the operation or process.*/
            }
            TARGET_COMPLETION {
                doc /* relating to the end or completion of an activity or event.*/
            }
            TOOL_CHANGE_STOP {
                doc /* setting or operator selection that changes the behavior of the controller on a piece of equipment.*/
            }
            USEABLE {
                doc /* remaining usable measure of an object or action.*/
            }
            VERTICAL {
                doc /* indication of the position of a mechanism that may move in a vertical direction.*/
            }
            VICKERS {
                doc /* scale to measure the resistance to deformation of a surface.*/
            }
            WORKING {
                doc /* piece of equipment performing any activity, the equipment is active and performing a function under load or not.*/
            }
            IPV4_ADDRESS {
                doc /* IPV4 network address of the {{block(Component)}}.*/
            }
            IPV6_ADDRESS {
                doc /* IPV6 network address of the {{block(Component)}}.*/
            }
            GATEWAY {
                doc /* Gateway for the {{block(Component)}} network.*/
            }
            SUBNET_MASK {
                doc /* SubNet mask for the {{block(Component)}} network.*/
            }
            VLAN_ID {
                doc /* layer2 Virtual Local Network (VLAN) ID for the {{block(Component)}} network.*/
            }
            MAC_ADDRESS {
                doc /* Media Access Control Address. The unique physical address of the network hardware.*/
            }
            WIRELESS {
                doc /* identifies whether the connection type is wireless.*/
            }
            LICENSE {
                doc /* license code to validate or activate the hardware or software.*/
            }
            VERSION {
                doc /* version of the hardware or software.*/
            }
            RELEASE_DATE {
                doc /* date the hardware or software was released for general use.*/
            }
            INSTALL_DATE {
                doc /* date the hardware or software was installed.*/
            }
            MANUFACTURER {
                doc /* corporate identity for the maker of the hardware or software.*/
            }
            UUID {
                doc /* universally unique identifier as specified in ISO 11578 or RFC 4122.*/
            }
            SERIAL_NUMBER {
                doc /* serial number that uniquely identifies a specific part.*/
            }
            RAW_MATERIAL {
                doc /* material that is used to produce parts.*/
            }
            LOT {
                doc /* group of parts tracked as a lot.*/
            }
            BATCH {
                doc /* group of parts produced in a batch.*/
            }
            HEAT_TREAT {
                doc /* material heat number.*/
            }
            PART_NUMBER {
                doc /* particular part design or model.*/
            }
            PART_FAMILY {
                doc /* group of parts having similarities in geometry, manufacturing process, and/or functions.*/
            }
            PART_NAME {
                doc /* word or set of words by which a part is known, addressed, or referred to.*/
            }
            PROCESS_STEP {
                doc /* step in the process plan that this occurrence corresponds to. */
            }
            PROCESS_PLAN {
                doc /* process plan that a process occurrence belongs to.*/
            }
            ORDER_NUMBER {
                doc /* authorization of a process occurrence.*/
            }
            PROCESS_NAME {
                doc /* word or set of words by which a process being executed (process occurrence) by the device is known, addressed, or referred to.*/
            }
            ISO_STEP_EXECUTABLE {
                doc /* reference to a ISO 10303 Executable.*/
            }
            COMPLETE {
                doc /* associated with the completion of an activity or event.*/
            }
            ACTIVE {
                doc /* relating to logic or motion program currently executing.*/
            }
            FAILED {
                doc /* actions or activities that were attempted , but failed to complete or resulted in an unexpected or unacceptable outcome.*/
            }
            ABORTED {
                doc /* actions or activities that were attempted, but terminated before they could be completed.*/
            }
            ENDED {
                doc /* boundary when an activity or an event terminates.*/
            }
            WASTE {
                doc /* amount discarded.*/
            }
            PART {
                doc /* amount included in the {{term(part)}}.*/
            }
            REQUEST {
                doc /* {{term(request)}} by an {{block(Interface)}} for a task.*/
            }
            RESPONSE {
                doc /* {{term(response)}} by an {{block(Interface)}} to a {{term(request)}} for a task.*/
            }
            ACTIVITY {
                doc /* phase or segment of a recipe or program.*/
            }
            SEGMENT {
                doc /* phase of a recipe process.*/
            }
            RECIPE {
                doc /* process as part of product production; can be a subprocess of a larger process.*/
            }
            OPERATION {
                doc /* step of a discrete manufacturing process.*/
            }
            BINARY {
                doc /* observed as a binary data type.*/
            }
            BOOLEAN {
                doc /* observed as a boolean data type.*/
            }
            ENUMERATED {
                doc 
                /* observed as a set containing a restricted number of discrete values where each discrete value is named and unique.
                 * {{cite(ISO 21961:2003, 013)}}*/
            }
            DETECT {
                doc /* indicated by the presence or existence of something.*/
            }
            MODEL {
                doc /* model info of the hardware or software.*/
            }
            MEASURED {
                doc /* {{def(DataItemSubType::ACTUAL)}} that has {{term(uncertainty)}}.*/
            }
            GAS {
                doc /* fluid that has no definite shape or volume.*/
            }
            LIQUID {
                doc /* fluid that has a definite volume but no definite shape.*/
            }
            SOLID {
                doc /* matter that has a definite shape and a definite volume.*/
            }
            ELECTRODE {
                doc /* component used for many electrical discharge manufacturing processes like welding*/
            }
            FILLER {
                doc /* material used to fill a gap or space*/
            }
            PLUNGE {
                doc /* move with a rush or sudden impulse into or out of*/
            }
            PECK {
                doc /* move suddenly or in a jerking motion*/
            }
            CUT {
                doc /* engagement of a tool edge in material*/
            }
            LAYER {
                doc /* sheet, quantity, or thickness of material, typically one of several, covering a surface or body*/
            }
        }
        enum def NativeUnitEnum :> UnitEnum {
            CENTIPOISE {
                doc /* viscosity in centipoise.*/
            }
            'DEGREE/MINUTE' {
                doc /* rotational velocity in degree per minute.*/
            }
            FAHRENHEIT {
                doc /* temperature in Fahrenheit.*/
            }
            FOOT {
                doc /* length in foot.*/
            }
            'FOOT/MINUTE' {
                doc /* speed in foot per minute.*/
            }
            'FOOT/SECOND' {
                doc /* speed in foot per second.*/
            }
            'FOOT/SECOND^2' {
                doc /* acceleration in foot per second squared.*/
            }
            FOOT_3D {
                doc /* point in space identified by X, Y, and Z positions and represented by a space-delimited set of numbers each expressed in feet.*/
            }
            'GALLON/MINUTE' {
                doc /* volumetric flow in gallon per minute.*/
            }
            HOUR {
                doc /* time in hour.*/
            }
            INCH {
                doc /* length in inch.*/
            }
            'INCH/MINUTE' {
                doc /* speed in inch per minute.*/
            }
            'INCH/SECOND' {
                doc /* speed in inch per second.*/
            }
            'INCH/SECOND^2' {
                doc /* acceleration in inch per second squared.*/
            }
            INCH_POUND {
                doc /* torque in inch pound.*/
            }
            INCH_3D {
                doc /* point in space identified by X, Y, and Z positions and represented by a space-delimited set of numbers each expressed in inches.*/
            }
            KELVIN {
                doc /* temperature in Kelvin.*/
            }
            KILOWATT {
                doc /* power in kilowatt.*/
            }
            KILOWATT_HOUR {
                doc /* energy in kilowatt-hour.*/
            }
            'LITER/MINUTE' {
                doc /* volumetric flow in liter per minute.*/
            }
            'MILLIMETER/MINUTE' {
                doc /* speed in millimeter per minute.*/
            }
            MINUTE {
                doc /* time in minute.*/
            }
            OTHER {
                doc /* unsupported unit.*/
            }
            POUND {
                doc /* mass in pound.*/
            }
            'POUND/INCH^2' {
                doc /* pressure in pound per square inch (PSI).*/
            }
            RADIAN {
                doc /* angle in radian.*/
            }
            'RADIAN/MINUTE' {
                doc /* angular velocity in radian per minute.*/
            }
            'RADIAN/SECOND' {
                doc /* angular velocity in radian per second.*/
            }
            'RADIAN/SECOND^2' {
                doc /* angular acceleration in radian per second squared.*/
            }
            BAR {
                doc /* pressure in bar.*/
            }
            TORR {
                doc /* pressure in torr.*/
            }
            MILLIMETER_MERCURY {
                doc /* pressure in millimeter of mercury (mmHg).*/
            }
            'PASCAL/MINUTE' {
                doc /* pressurization rate in pascal per minute.*/
            }
            GRAVITATIONAL_FORCE {
                doc /* `MASS` times `GRAVITATIONAL_ACCELERATION`  (g).*/
            }
            GRAVITATIONAL_ACCELERATION {
                doc 
                /* acceleration relative to earth's gravity given in meter per second squared.
                 *
                 * > Note 1 to entry: At different points on Earth's surface, the free-fall acceleration ranges from 9.764 to 9.834 m/s2 (Wikipedia: Gravitational Acceleration). The constant can be customized depending on the location in the universe.
                 *
                 * > Note 2 to entry: In the standard, it is assumed that Earth's average value of gravitational acceleration is 9.90665 m/s2.*/
            }
            AMPERE_HOUR {
                doc /* electric charge in ampere hour.*/
            }
            'CUBIC_FOOT/HOUR' {
                doc /* change of geometric volume in cubic foot per hour.*/
            }
            'CUBIC_FOOT/MINUTE' {
                doc /* change of geometric volume in cubic foot per minute.*/
            }
            SQUARE_INCH {
                doc /* geometric area in inch squared.*/
            }
            CUBIC_FOOT {
                doc /* geometric volume in cubic foot.*/
            }
            'INCH/REVOLUTION' {
                doc /* feedrate per revolution in inch per revolution.*/
            }
            MICROMETER {
                doc /* length in micrometer.*/
            }
            RANKINE {
                doc /* temperature in Rankine.*/
            }
            MICROTORR {
                doc /* pressure in microtorr.*/
            }
        }
        enum def FilterEnum {
            MINIMUM_DELTA {
                doc 
                /* new value **MUST NOT** be reported for a data item unless the measured value has changed from the last reported value by at least the delta given as the value of this element.
                 *
                 * The value of {{block(Filter)}} **MUST** be an absolute value using the same units as the reported data.*/
            }
            PERIOD {
                doc 
                /* data reported for a data item is provided on a periodic basis. The `PERIOD` for reporting data is defined in the value of the {{block(Filter)}}.
                 *
                 * The value of {{block(Filter)}} **MUST** be an absolute value reported in seconds representing the time between reported samples of the value of the data item.*/
            }
        }
        enum def RepresentationEnum {
            TIME_SERIES {
                doc 
                /* series of sampled data.
                 *
                 * The data is reported for a specified number of samples and each sample is reported with a fixed period.*/
            }
            VALUE {
                doc 
                /* measured value of the sample data.
                 *
                 * If no {{property(DataItem::representation)}} is specified for a data item, the {{property(DataItem::representation)}} **MUST** be determined to be `VALUE`.*/
            }
            DATA_SET {
                doc 
                /* reported value(s) are represented as a set of {{termplural(key-value pair)}}.
                 *
                 * Each reported value in the {{term(data set)}} **MUST** have a unique key.*/
            }
            DISCRETE {
                doc /* **DEPRECATED** as {{property(DataItem::representation)}} type in *MTConnect Version 1.5*. Replaced by the {{property(DataItem::discrete)}}.*/
            }
            TABLE {
                doc 
                /* two dimensional set of {{termplural(key-value pair)}} where the {{block(Entry)}} represents a row, and the value is a set of {{term(key-value pair)}} {{block(Cell)}} elements. 
                 *
                 * A {{term(table)}} follows the same behavior as the {{term(data set)}} for change tracking, clearing, and history. When an {{block(Entry)}} changes, all {{block(Cell)}} elements update as a single unit following the behavior of a {{term(data set)}}.
                 *
                 * > Note: It is best to use {{block(Variable)}} if the {{block(Cell)}} entities represent multiple semantic types.
                 *
                 * Each {{block(Entry)}} in the {{term(table)}} **MUST** have a unique key. Each {{block(Cell)}} of each {{block(Entry)}} in the {{term(table)}} **MUST** have a unique key.
                 *
                 * See {{block(Representation)}} in {{package(Observation Information Model)}}, for a description of {{block(Entry)}} and {{block(Cell)}} elements.*/
            }
        }
        attribute def boolean :> NOT_COMPATIBLE_WITH_TEXTUAL {
            doc /* primitive type.*/
        }
        attribute def ID :> string {
            doc /* string that represents an {{term(ID)}}.*/
        }
        attribute def string :> NOT_COMPATIBLE_WITH_TEXTUAL {
            doc /* primitive type.*/
        }
        attribute def float :> NOT_COMPATIBLE_WITH_TEXTUAL {
            doc /* primitive type.*/
        }
        attribute def datetime :> string {
            doc /* string that represents timestamp in ISO 8601 format.*/
        }
        attribute def integer :> NOT_COMPATIBLE_WITH_TEXTUAL {
            doc /* primitive type.*/
        }
        attribute def xlinktype :> string {
            doc /* string that represents the type of an XLink element. See {{url(https://www.w3.org/TR/xlink11/)}}.*/
        }
        attribute def xslang :> string {
            doc /* string that represents a language tag. See {{url(http://www.ietf.org/rfc/rfc4646.txt)}}.*/
        }
        attribute def SECOND :> unit {
            doc /* float that represents time in seconds.*/
        }
        attribute def xlinkhref :> string {
            doc /* string that represents the locator attribute of an XLink element. See {{url(https://www.w3.org/TR/xlink11/)}}.*/
        }
        enum def ResetTriggeredEnum {
            ACTION_COMPLETE {
                doc /* {{property(Observation::result)}} is measuring an action or operation was reset upon completion of that action or operation.*/
            }
            ANNUAL {
                doc /* {{property(Observation::result)}} was reset at the end of a 12-month period.*/
            }
            DAY {
                doc /* {{property(Observation::result)}} was reset at the end of a 24-hour period.*/
            }
            MAINTENANCE {
                doc /* {{property(Observation::result)}} was reset upon completion of a maintenance event.*/
            }
            MANUAL {
                doc /* {{property(Observation::result)}} was reset based on a physical reset action.*/
            }
            MONTH {
                doc /* {{property(Observation::result)}} was reset at the end of a monthly period.*/
            }
            POWER_ON {
                doc /* {{property(Observation::result)}} was reset when power was applied to the piece of equipment after a planned or unplanned interruption of power has occurred.*/
            }
            SHIFT {
                doc /* {{property(Observation::result)}} was reset at the end of a work shift.*/
            }
            WEEK {
                doc /* {{property(Observation::result)}} was reset at the end of a 7-day period.*/
            }
        }
        enum def QualifierEnum {
            HIGH {
                doc /* measured value is greater than the expected value for a process variable.*/
            }
            LOW {
                doc /* measured value is less than the expected value for a process variable.*/
            }
        }
        enum def SampleEnum :> DataItemTypeEnum {
            ACCELERATION {
                doc /* positive rate of change of velocity.*/
            }
            ACCUMULATED_TIME {
                doc /* accumulated time for an activity or event.*/
            }
            AMPERAGE {
                doc 
                /* strength of electrical current.
                 *
                 * **DEPRECATED** in *Version 1.6*. Replaced by `AMPERAGE_AC` and `AMPERAGE_DC`.*/
            }
            ANGLE {
                doc /* angular position.*/
            }
            ANGULAR_ACCELERATION {
                doc /* positive rate of change of angular velocity.*/
            }
            ANGULAR_VELOCITY {
                doc /* rate of change of angular position.*/
            }
            AXIS_FEEDRATE {
                doc /* feedrate of a linear axis.*/
            }
            CAPACITY_FLUID {
                doc /* maximum amount of fluid that can be held by a container.*/
            }
            CAPACITY_SPATIAL {
                doc /* maximum amount of material that can be held by a container.*/
            }
            CONCENTRATION {
                doc /* percentage of one component within a mixture of components.*/
            }
            CONDUCTIVITY {
                doc /* ability of a material to conduct electricity.*/
            }
            CUTTING_SPEED {
                doc /* speed difference (relative velocity) between the cutting mechanism and the surface of the workpiece it is operating on.*/
            }
            DENSITY {
                doc /* volumetric mass of a material per unit volume of that material.*/
            }
            DEPOSITION_ACCELERATION_VOLUMETRIC {
                doc /* rate of change in spatial volume of material deposited in an additive manufacturing process.*/
            }
            DEPOSITION_DENSITY {
                doc /* density of the material deposited in an additive manufacturing process per unit of volume.*/
            }
            DEPOSITION_MASS {
                doc /* mass of the material deposited in an additive manufacturing process.*/
            }
            DEPOSITION_RATE_VOLUMETRIC {
                doc /* rate at which a spatial volume of material is deposited in an additive manufacturing process.*/
            }
            DEPOSITION_VOLUME {
                doc /* spatial volume of material to be deposited in an additive manufacturing process.*/
            }
            DISPLACEMENT {
                doc /* change in position of an object.*/
            }
            ELECTRICAL_ENERGY {
                doc /* {{block(Wattage)}} used or generated by a component over an interval of time.*/
            }
            EQUIPMENT_TIMER {
                doc /* amount of time a piece of equipment or a sub-part of a piece of equipment has performed specific activities.*/
            }
            FILL_LEVEL {
                doc /* amount of a substance remaining compared to the planned maximum amount of that substance.*/
            }
            FLOW {
                doc /* rate of flow of a fluid.*/
            }
            FREQUENCY {
                doc /* number of occurrences of a repeating event per unit time.*/
            }
            GLOBAL_POSITION {
                doc 
                /* position in three-dimensional space.
                 *
                 * **DEPRECATED** in Version 1.1.*/
            }
            LENGTH {
                doc /* length of an object.*/
            }
            LEVEL {
                doc 
                /* level of a resource.
                 *
                 * **DEPRECATED** in *Version 1.2*.  See `FILL_LEVEL`.*/
            }
            LINEAR_FORCE {
                doc /* {{term(force)}} applied to a mass in one direction only.*/
            }
            LOAD {
                doc /* actual versus the standard rating of a piece of equipment.*/
            }
            MASS {
                doc /* mass of an object(s) or an amount of material.*/
            }
            PATH_FEEDRATE {
                doc /* feedrate for the axes, or a single axis, associated with a {{block(Path)}} component.*/
            }
            PATH_FEEDRATE_PER_REVOLUTION {
                doc /* feedrate for the axes, or a single axis.*/
            }
            PATH_POSITION {
                doc /* position of a control point associated with a {{block(Controller)}} or a {{block(Path)}}.*/
            }
            PH {
                doc /* acidity or alkalinity of a solution.*/
            }
            POSITION {
                doc /* point along an axis in a {{term(cartesian coordinate system)}}.*/
            }
            POWER_FACTOR {
                doc /* ratio of real power flowing to a load to the apparent power in that AC circuit.*/
            }
            PRESSURE {
                doc 
                /* force per unit area measured relative to atmospheric pressure. 
                 *
                 * Commonly referred to as gauge pressure.*/
            }
            PROCESS_TIMER {
                doc /* amount of time a piece of equipment has performed different types of activities associated with the process being performed at that piece of equipment.*/
            }
            RESISTANCE {
                doc /* degree to which a substance opposes the passage of an electric current.*/
            }
            ROTARY_VELOCITY {
                doc /* rotational speed of a rotary axis.*/
            }
            SOUND_LEVEL {
                doc /* sound level or sound pressure level relative to atmospheric pressure.*/
            }
            SPINDLE_SPEED {
                doc 
                /* rotational speed of the rotary axis.
                 *
                 * **DEPRECATED** in *Version 1.2*.  Replaced by `ROTARY_VELOCITY`.*/
            }
            STRAIN {
                doc /* amount of deformation per unit length of an object when a load is applied.*/
            }
            TEMPERATURE {
                doc /* degree of hotness or coldness measured on a definite scale.*/
            }
            TENSION {
                doc /* force that stretches or elongates an object.*/
            }
            TILT {
                doc /* angular displacement.*/
            }
            TORQUE {
                doc /* turning force exerted on an object or by an object.*/
            }
            VELOCITY {
                doc /* rate of change of position of a {{block(Component)}}.*/
            }
            VISCOSITY {
                doc /* fluid's resistance to flow.*/
            }
            VOLTAGE {
                doc 
                /* electrical potential between two points.
                 *
                 * **DEPRECATED** in *Version 1.6*. Replaced by `VOLTAGE_AC` and `VOLTAGE_DC`.*/
            }
            VOLT_AMPERE {
                doc /* apparent power in an electrical circuit, equal to the product of root-mean-square (RMS) voltage and RMS current (commonly referred to as VA).*/
            }
            VOLT_AMPERE_REACTIVE {
                doc /* reactive power in an AC electrical circuit (commonly referred to as VAR).*/
            }
            VOLUME_FLUID {
                doc /* fluid volume of an object or container.*/
            }
            VOLUME_SPATIAL {
                doc /* geometric volume of an object or container.*/
            }
            WATTAGE {
                doc /* power flowing through or dissipated by an electrical circuit or piece of equipment.*/
            }
            AMPERAGE_AC {
                doc /* electrical current that reverses direction at regular short intervals.*/
            }
            AMPERAGE_DC {
                doc /* electric current flowing in one direction only.*/
            }
            VOLTAGE_AC {
                doc /* electrical potential between two points in an electrical circuit in which the current periodically reverses direction.*/
            }
            VOLTAGE_DC {
                doc /* electrical potential between two points in an electrical circuit in which the current is unidirectional.*/
            }
            X_DIMENSION {
                doc /* dimension of an entity relative to the X direction of the referenced coordinate system.*/
            }
            Y_DIMENSION {
                doc /* dimension of an entity relative to the Y direction of the referenced coordinate system.*/
            }
            Z_DIMENSION {
                doc /* dimension of an entity relative to the Z direction of the referenced coordinate system.*/
            }
            DIAMETER {
                doc /* dimension of a diameter.*/
            }
            ORIENTATION {
                doc /* angular position of a plane or vector relative to a {{term(cartesian coordinate system)}}*/
            }
            HUMIDITY_RELATIVE {
                doc /* amount of water vapor present expressed as a percent to reach saturation at the same temperature.*/
            }
            HUMIDITY_ABSOLUTE {
                doc /* amount of water vapor expressed in grams per cubic meter.*/
            }
            HUMIDITY_SPECIFIC {
                doc /* ratio of the water vapor present over the total weight of the water vapor and air present expressed as a percent.*/
            }
            OBSERVATION_UPDATE_RATE {
                doc /* average rate of change of values for data items in the MTConnect streams. The average is computed over a rolling window defined by the implementation.*/
            }
            ASSET_UPDATE_RATE {
                doc 
                /* average rate of change of values for assets in the MTConnect streams. 
                 *
                 * The average is computed over a rolling window defined by the implementation.*/
            }
            PRESSURIZATION_RATE {
                doc /* change of pressure per unit time.*/
            }
            DECELERATION {
                doc /* negative rate of change of velocity.*/
            }
            ANGULAR_DECELERATION {
                doc /* negative rate of change of angular velocity.*/
            }
            PRESSURE_ABSOLUTE {
                doc /* force per unit area measured relative to a vacuum.*/
            }
            OPENNESS {
                doc /* percentage open where 100% is fully open and 0% is fully closed.*/
            }
            DEW_POINT {
                doc /* temperature at which moisture begins to condense, corresponding to saturation for a given absolute humidity.*/
            }
            GRAVITATIONAL_FORCE {
                doc /* force relative to earth's gravity.*/
            }
            GRAVITATIONAL_ACCELERATION {
                doc /* acceleration relative to Earth's gravity of 9.80665 `METER/SECOND^2`.*/
            }
            BATTERY_CAPACITY {
                doc /* maximum rated charge a battery is capable of maintaining based on the battery discharging at a specified current over a specified time period.*/
            }
            DISCHARGE_RATE {
                doc /* value of current being drawn from the {{block(Component)}}.*/
            }
            CHARGE_RATE {
                doc /* value of the current being supplied to the {{block(Component)}} for the purpose of charging.*/
            }
            BATTERY_CHARGE {
                doc /* value of the battery's present capacity expressed as a percentage of the battery's maximum rated capacity.*/
            }
            SETTLING_ERROR {
                doc /* difference between actual and commanded position at the end of a motion.*/
            }
            FOLLOWING_ERROR {
                doc /* difference between actual and commanded position at any specific point in time during a motion.*/
            }
            SETTLING_ERROR_LINEAR {
                doc /* difference between the commanded encoder/resolver position, and the actual encoder/resolver position when motion is complete.*/
            }
            SETTLING_ERROR_ANGULAR {
                doc /* angular difference between the commanded encoder/resolver position, and the actual encoder/resolver position when motion is complete.*/
            }
            FOLLOWING_ERROR_LINEAR {
                doc /* difference between the commanded encoder/resolver position and the actual encoder/resolver position at any specified point in time during a motion.*/
            }
            FOLLOWING_ERROR_ANGULAR {
                doc /* angular difference between the commanded encoder/resolver position and the actual encoder/resolver position at any specified point in time during a motion.*/
            }
            DISPLACEMENT_LINEAR {
                doc /* absolute value of the change in position along a vector.*/
            }
            DISPLACEMENT_ANGULAR {
                doc /* absolute value of the change in angular position around a vector*/
            }
            POSITION_CARTESIAN {
                doc /* point in a {{term(cartesian coordinate system)}}.*/
            }
            RESISTIVITY {
                doc /* inability of a material to conduct electricity.*/
            }
            FILL_HEIGHT {
                doc /* amount of a substance in a container.*/
            }
            PARTICLE_COUNT {
                doc /* number of particles counted by their size or other characteristics.*/
            }
            PARTICLE_SIZE {
                doc /* size of particles counted by their size or other characteristics.*/
            }
            WATER_HARDNESS {
                doc /* concentration of calcium carbonate (CaCO3) in water*/
            }
        }
        enum def EventEnum :> DataItemTypeEnum {
            doc /**/
            ACTIVE_AXES {
                doc /* set of axes currently associated with a {{block(Path)}} or {{block(Controller)}}.*/
            }
            ACTUATOR_STATE {
                doc /* operational state of an apparatus for moving or controlling a mechanism or system.*/
            }
            ALARM {
                doc /* **DEPRECATED:** Replaced with `CONDITION` category data items in Version 1.1.0.*/
            }
            ASSET_CHANGED {
                doc /* {{property(Asset::assetId)}} of the {{block(Asset)}} that has been changed.*/
            }
            ASSET_REMOVED {
                doc /* {{property(Asset::assetId)}} of the {{block(Asset)}} that has been removed.*/
            }
            AVAILABILITY {
                doc /* {{term(agent)}}'s ability to communicate with the data source.*/
            }
            AXIS_COUPLING {
                doc 
                /* describes the way the axes will be associated to each other. 
                 *   
                 * This is used in conjunction with `COUPLED_AXES` to indicate the way they are interacting.*/
            }
            AXIS_FEEDRATE_OVERRIDE {
                doc /* value of a signal or calculation issued to adjust the feedrate of an individual linear type axis.*/
            }
            AXIS_INTERLOCK {
                doc /* state of the axis lockout function when power has been removed and the axis is allowed to move freely.*/
            }
            AXIS_STATE {
                doc /* state of a {{block(Linear)}} or {{block(Rotary)}} component representing an axis.*/
            }
            BLOCK {
                doc /* line of code or command being executed by a {{block(Controller)}} entity.*/
            }
            BLOCK_COUNT {
                doc /* total count of the number of blocks of program code that have been executed since execution started.*/
            }
            CHUCK_INTERLOCK {
                doc /* state of an interlock function or control logic state intended to prevent the associated {{block(Chuck)}} component from being operated.*/
            }
            CHUCK_STATE {
                doc 
                /* operating state of a mechanism that holds a part or stock material during a manufacturing process. 
                 *
                 * It may also represent a mechanism that holds any other mechanism in place within a piece of equipment.*/
            }
            CODE {
                doc 
                /* programmatic code being executed.
                 *
                 * **DEPRECATED** in *Version 1.1*.*/
            }
            COMPOSITION_STATE {
                doc /* operating state of a mechanism represented by a {{block(Composition)}} entity.*/
            }
            CONTROLLER_MODE {
                doc /* current mode of the {{block(Controller)}} component.*/
            }
            CONTROLLER_MODE_OVERRIDE {
                doc /* setting or operator selection that changes the behavior of a piece of equipment.*/
            }
            COUPLED_AXES {
                doc /* set of associated axes.*/
            }
            DATE_CODE {
                doc /* time and date code associated with a material or other physical item.*/
            }
            DEVICE_UUID {
                doc /* identifier of another piece of equipment that is temporarily associated with a component of this piece of equipment to perform a particular function.*/
            }
            DIRECTION {
                doc /* direction of motion.*/
            }
            DOOR_STATE {
                doc /* operational state of a {{block(Door)}} component or composition element.*/
            }
            EMERGENCY_STOP {
                doc /* state of the emergency stop signal for a piece of equipment, controller path, or any other component or subsystem of a piece of equipment.*/
            }
            END_OF_BAR {
                doc /* indication of whether the end of a piece of bar stock being feed by a bar feeder has been reached.*/
            }
            EQUIPMENT_MODE {
                doc /* indication that a piece of equipment, or a sub-part of a piece of equipment, is performing specific types of activities.*/
            }
            EXECUTION {
                doc /* operating state of a {{block(Component)}}.*/
            }
            FUNCTIONAL_MODE {
                doc /* current intended production status of the {{block(Component)}}.*/
            }
            HARDNESS {
                doc /* hardness of a material.*/
            }
            LINE {
                doc 
                /* current line of code being executed.
                 *
                 * **DEPRECATED** in *Version 1.4.0*.*/
            }
            LINE_LABEL {
                doc /* identifier for a {{block(Block)}} of code in a {{block(Program)}}.*/
            }
            LINE_NUMBER {
                doc /* position of a block of program code within a control program.*/
            }
            MATERIAL {
                doc /* identifier of a material used or consumed in the manufacturing process*/
            }
            MATERIAL_LAYER {
                doc /* identifies the layers of material applied to a part or product as part of an additive manufacturing process.*/
            }
            MESSAGE {
                doc /* information to be transferred from a piece of equipment to a client software application.*/
            }
            OPERATOR_ID {
                doc /* identifier of the person currently responsible for operating the piece of equipment.*/
            }
            PALLET_ID {
                doc /* identifier for a pallet.*/
            }
            PART_COUNT {
                doc /* aggregate count of parts.*/
            }
            PART_DETECT {
                doc /* indication designating whether a part or work piece has been detected or is present.*/
            }
            PART_ID {
                doc /* identifier of a part in a manufacturing operation.*/
            }
            PART_NUMBER {
                doc 
                /* identifier of a part or product moving through the manufacturing process.
                 *
                 * **DEPRECATED** in *Version 1.7*. `PART_NUMBER` is now a `subType` of `PART_KIND_ID`.*/
            }
            PATH_FEEDRATE_OVERRIDE {
                doc /* value of a signal or calculation issued to adjust the feedrate for the axes associated with a {{block(Path)}} component that may represent a single axis or the coordinated movement of multiple axes.*/
            }
            PATH_MODE {
                doc /* describes the operational relationship between a {{block(Path)}} entity and another {{block(Path)}} entity for pieces of equipment comprised of multiple logical groupings of controlled axes or other logical operations.*/
            }
            POWER_STATE {
                doc /* indication of the status of the source of energy for an entity to allow it to perform its intended function or the state of an enabling signal providing permission for the entity to perform its functions.*/
            }
            POWER_STATUS {
                doc 
                /* status of the {{block(Component)}}.
                 *
                 * **DEPRECATED** in *Version 1.1.0*.*/
            }
            PROCESS_TIME {
                doc /* time and date associated with an activity or event.*/
            }
            PROGRAM {
                doc /* name of the logic or motion program being executed by the {{block(Controller)}} component.*/
            }
            PROGRAM_COMMENT {
                doc /* comment or non-executable statement in the control program.*/
            }
            PROGRAM_EDIT {
                doc 
                /* indication of the status of the {{block(Controller)}} components program editing mode.
                 *
                 * A program may be edited while another is executed.*/
            }
            PROGRAM_EDIT_NAME {
                doc 
                /* name of the program being edited. 
                 *
                 * This is used in conjunction with {{block(ProgramEdit)}} when in `ACTIVE` state. */
            }
            PROGRAM_HEADER {
                doc /* non-executable header section of the control program.*/
            }
            PROGRAM_LOCATION {
                doc /* {{term(URI)}} for the source file associated with {{block(Program)}}.*/
            }
            PROGRAM_LOCATION_TYPE {
                doc /* defines whether the logic or motion program defined by {{block(Program)}} is being executed from the local memory of the controller or from an outside source.*/
            }
            PROGRAM_NEST_LEVEL {
                doc /* indication of the nesting level within a control program that is associated with the code or instructions that is currently being executed.*/
            }
            ROTARY_MODE {
                doc /* current operating mode for a {{block(Rotary)}} type axis.*/
            }
            ROTARY_VELOCITY_OVERRIDE {
                doc /* percentage change to the velocity of the programmed velocity for a {{block(Rotary)}} axis.*/
            }
            SERIAL_NUMBER {
                doc /* serial number associated with a {{block(Component)}}, {{block(Asset)}}, or {{block(Device)}}.*/
            }
            SPINDLE_INTERLOCK {
                doc /* indication of the status of the spindle for a piece of equipment when power has been removed and it is free to rotate.*/
            }
            TOOL_ASSET_ID {
                doc /* identifier of an individual tool asset.*/
            }
            TOOL_GROUP {
                doc /* identifier for the tool group associated with a specific tool. Commonly used to designate spare tools.*/
            }
            TOOL_ID {
                doc 
                /* identifier of the tool currently in use for a given `Path`.
                 *
                 * **DEPRECATED** in *Version 1.2.0*.   See `TOOL_NUMBER`.*/
            }
            TOOL_NUMBER {
                doc /* identifier assigned by the {{block(Controller)}} component to a cutting tool when in use by a piece of equipment.*/
            }
            TOOL_OFFSET {
                doc /* reference to the tool offset variables applied to the active cutting tool.*/
            }
            USER {
                doc /* identifier of the person currently responsible for operating the piece of equipment.*/
            }
            VARIABLE {
                doc /* data whose meaning may change over time due to changes in the operation of a piece of equipment or the process being executed on that piece of equipment.*/
            }
            WAIT_STATE {
                doc /* indication of the reason that {{block(Execution)}} is reporting a value of `WAIT`.*/
            }
            WIRE {
                doc /* identifier for the type of wire used as the cutting mechanism in Electrical Discharge Machining or similar processes.*/
            }
            WORKHOLDING_ID {
                doc 
                /* identifier for the current workholding or part clamp in use by a piece of equipment.
                 *
                 * **DEPRECATION WARNING**: Recommend using `FIXTURE_ID` instead.*/
            }
            WORK_OFFSET {
                doc /* reference to offset variables for a work piece or part.*/
            }
            OPERATING_SYSTEM {
                doc /* Operating System (OS) of a {{block(Component)}}.*/
            }
            FIRMWARE {
                doc 
                /* embedded software of a {{block(Component)}}
                 * .*/
            }
            APPLICATION {
                doc /* application on a {{block(Component)}}.*/
            }
            LIBRARY {
                doc /* software library on a {{block(Component)}}*/
            }
            HARDWARE {
                doc /* hardware of a {{block(Component)}}.*/
            }
            NETWORK {
                doc /* network details of a {{block(Component)}}.*/
            }
            ROTATION {
                doc /* three space angular displacement of an object or coordinate system relative to a {{term(cartesian coordinate system)}}.*/
            }
            TRANSLATION {
                doc /* three space linear displacement of an object or coordinate system relative to a {{term(cartesian coordinate system)}}.*/
            }
            DEVICE_ADDED {
                doc /* {{term(UUID)}} of new device added to an {{term(MTConnect Agent)}}.*/
            }
            DEVICE_REMOVED {
                doc /* {{term(UUID)}} of a device removed from an {{term(MTConnect Agent)}}.*/
            }
            DEVICE_CHANGED {
                doc /* {{term(UUID)}} of the device whose {{term(metadata)}} has changed.*/
            }
            CONNECTION_STATUS {
                doc /* status of the connection between an {{term(adapter)}} and an {{term(agent)}}.*/
            }
            ADAPTER_SOFTWARE_VERSION {
                doc /* originator’s software version of the {{term(adapter)}}.*/
            }
            ADAPTER_URI {
                doc /* {{term(URI)}} of the {{term(adapter)}}.*/
            }
            MTCONNECT_VERSION {
                doc /* reference version of the MTConnect Standard supported by the {{term(adapter)}}.*/
            }
            SENSOR_ATTACHMENT {
                doc /* {{term(attachment)}} between a sensor and an entity.*/
            }
            PART_STATUS {
                doc /* state or condition of a part.*/
            }
            PROCESS_OCCURRENCE_ID {
                doc /* identifier of a process being executed by the device.*/
            }
            PROCESS_AGGREGATE_ID {
                doc /* identifier given to link the individual occurrence to a group of related occurrences, such as a process step in a process plan.*/
            }
            PROCESS_KIND_ID {
                doc /* identifier given to link the individual occurrence to a class of processes or process definition.*/
            }
            PART_GROUP_ID {
                doc /* identifier given to a collection of individual parts. */
            }
            PART_KIND_ID {
                doc /* identifier given to link the individual occurrence to a class of parts, typically distinguished by a particular part design.*/
            }
            PART_UNIQUE_ID {
                doc /* identifier given to a distinguishable, individual part. */
            }
            CONTROL_LIMIT {
                doc 
                /* set of limits used to indicate whether a process variable is stable and in control.
                 *
                 * **DEPRECATED** in *Version 2.5*. Replaced by `CONTROL_LIMITS`.*/
            }
            SPECIFICATION_LIMIT {
                doc 
                /* set of limits defining a range of values designating acceptable performance for a variable.
                 *
                 * **DEPRECATED** in *Version 2.5*. Replaced by  `SPECIFICATION_LIMITS`.*/
            }
            ALARM_LIMIT {
                doc 
                /* set of limits used to trigger warning or alarm indicators.
                 *
                 * **DEPRECATED** in *Version 2.5*. Replaced by  `ALARM_LIMITS`.*/
            }
            LOAD_COUNT {
                doc /* accumulation of the number of times an operation has attempted to, or is planned to attempt to, load materials, parts, or other items.*/
            }
            UNLOAD_COUNT {
                doc /* accumulation of the number of times an operation has attempted to, or is planned to attempt to, unload materials, parts, or other items.*/
            }
            TRANSFER_COUNT {
                doc /* accumulation of the number of times an operation has attempted to, or is planned to attempt to, transfer materials, parts, or other items from one location to another.*/
            }
            ACTIVATION_COUNT {
                doc /* accumulation of the number of times a function has attempted to, or is planned to attempt to, activate or be performed.*/
            }
            DEACTIVATION_COUNT {
                doc /* accumulation of the number of times a function has attempted to, or is planned to attempt to, deactivate or cease.*/
            }
            CYCLE_COUNT {
                doc /* accumulation of the number of times a cyclic function has attempted to, or is planned to attempt to execute.*/
            }
            VALVE_STATE {
                doc /* state of a valve is one of open, closed, or transitioning between the states.*/
            }
            LOCK_STATE {
                doc /* state or operating mode of a {{block(Lock)}}.*/
            }
            PROCESS_STATE {
                doc /* particular condition of the process occurrence at a specific time.*/
            }
            PART_PROCESSING_STATE {
                doc /* particular condition of the part occurrence at a specific time.*/
            }
            OPERATING_MODE {
                doc /* state of {{block(Component)}} or {{block(Composition)}} that describes the automatic or manual operation of the entity.*/
            }
            ASSET_COUNT {
                doc /* {{term(data set)}} of the number of {{termplural(Asset)}} of a given type for a {{term(Device)}}.*/
            }
            MAINTENANCE_LIST {
                doc /* actions or activities to be performed in support of a piece of equipment.*/
            }
            FIXTURE_ID {
                doc /* identifier for the current workholding or part clamp in use by a piece of equipment.*/
            }
            PART_COUNT_TYPE {
                doc /* interpretation of `PART_COUNT`.*/
            }
            CLOCK_TIME {
                doc /* time provided by a timing device at a specific point in time.*/
            }
            HOST_NAME {
                doc /* name of the host computer supplying data.*/
            }
            NETWORK_PORT {
                doc /* number of the TCP/IP or UDP/IP port for the connection endpoint.*/
            }
            LEAK_DETECT {
                doc /* indication designating whether a leak has been detected.*/
            }
            BATTERY_STATE {
                doc /* present status of the battery.*/
            }
            FEATURE_PERSISTENT_ID {
                doc /* {{term(UUID)}} of a {{term(feature)}}. {{cite(ISO 10303 AP 242/239)}}.*/
            }
            SENSOR_STATE {
                doc /* detection result of a sensor.*/
            }
            COMPONENT_DATA {
                doc /* {{block(Event)}} that represents a {{block(Component)}} where the {{block(EntryDefinition)}} identifies the {{block(Component)}} and the {{block(CellDefinition)}}s define the {{block(Component)}}'s observed {{block(DataItem)}}s.*/
            }
            WORK_OFFSETS {
                doc /* properties of each addressable work offset.*/
            }
            TOOL_OFFSETS {
                doc /* properties of each addressable tool offset.*/
            }
            FEATURE_MEASUREMENT {
                doc /* assessing elements of a {{term(feature)}}.*/
            }
            CHARACTERISTIC_PERSISTENT_ID {
                doc /* {{term(UUID)}} of the {{term(characteristic)}}.*/
            }
            MEASUREMENT_TYPE {
                doc /* class of measurement being performed. {{cite(QIF 3:2018 Section 6.3)}}*/
            }
            MEASUREMENT_VALUE {
                doc /* measurement based on the measurement type.*/
            }
            MEASUREMENT_UNITS {
                doc /* engineering units of the measurement.*/
            }
            CHARACTERISTIC_STATUS {
                doc /* pass/fail result of the measurement.*/
            }
            UNCERTAINTY_TYPE {
                doc /* method used to compute {{term(standard uncertainty)}}.*/
            }
            UNCERTAINTY {
                doc /* {{term(uncertainty)}} specified by {{block(UncertaintyType)}}.*/
            }
            SPECIFICATION_LIMITS {
                doc /* set of limits defining a range of values designating acceptable performance for a variable.*/
            }
            CONTROL_LIMITS {
                doc /* set of limits used to indicate whether a process variable is stable and in control.*/
            }
            ALARM_LIMITS {
                doc /* set of limits used to trigger warning or alarm indicators.*/
            }
            TOOL_CUTTING_ITEM {
                doc /* references the {{block(CuttingToolLifeCycle)}} {{block(CuttingItem)}} index related to the {{property(CuttingItem::indices)}} of the currently active cutting tool edge.*/
            }
            LOCATION_ADDRESS {
                doc /* structured information that allows the unambiguous determination of an object for purposes of identification and location. {{cite(ISO 19160-4:2017)}}*/
            }
            ACTIVE_POWER_SOURCE {
                doc /* active energy source for the {{block(Component)}}.*/
            }
            LOCATION_NARRATIVE {
                doc /* textual description of the location of an object or activity.*/
            }
            THICKNESS {
                doc /* dimension between two surfaces of an object, usually the dimension of smallest measure, for example an additive layer, or a depth of cut.*/
            }
            LOCATION_SPATIAL_GEOGRAPHIC {
                doc /* absolute geographic location defined by two coordinates, longitude and latitude and an elevation.*/
            }
            PART_INDEX {
                doc /* sequence of a part in a group of parts.*/
            }
            ASSOCIATED_ASSET_ID {
                doc /* {{property(Asset::assetId)}} of the {{block(Asset)}}s associated with a {{block(Component)}}.*/
            }
            ASSET_ADDED {
                doc /* {{property(Asset::assetId)}} of the {{block(Asset)}} that has been added.*/
            }
            TASK_ASSET_ID {
                doc /* {{property(Task::assetId)}} of the {{block(Task)}} that the {{block(Component)}} binds to*/
            }
            BINDING_STATE {
                doc /* state of the binding process when {{block(Component)}} participates in a task as a collaborator*/
            }
            SWING_ANGLE {
                doc /* angular range over which the object is designed to move about a fixed axis or pivot*/
            }
            SWING_RADIUS {
                doc /* maximal linear distance from the pivot or axis to the furthest point reached by the object’s swing*/
            }
            SWING_DIAMETER {
                doc /* maximal linear width (diameter) of the area described by the object’s movement about an axis*/
            }
            DEPTH {
                doc /* dimension or distance as measured downwards from the top*/
            }
            FIXTURE_ASSET_ID {
                doc /* {{property(Fixture::assetId)}} of the {{block(Fixture)}} that is associated with a {{block(Component)}}*/
            }
        }
        enum def ConditionEnum :> SampleEnum, EventEnum {
            COMMUNICATIONS {
                doc /* indication that the piece of equipment has experienced a communications failure.*/
            }
            DATA_RANGE {
                doc /* indication that the value of the data associated with a measured value or a calculation is outside of an expected range.*/
            }
            LOGIC_PROGRAM {
                doc /* indication that an error occurred in the logic program or programmable logic controller (PLC) associated with a piece of equipment.*/
            }
            MOTION_PROGRAM {
                doc /* indication that an error occurred in the motion program associated with a piece of equipment.*/
            }
            SYSTEM {
                doc /* general purpose indication associated with an electronic component of a piece of equipment or a controller that represents a fault that is not associated with the operator, program, or hardware.*/
            }
            ACTUATOR {
                doc /* indication of a fault associated with an actuator.*/
            }
        }
        enum def MotionActuationTypeEnum {
            DIRECT {
                doc /* movement is initiated by the component.*/
            }
            VIRTUAL {
                doc /* motion is computed and is used for expressing an imaginary movement.*/
            }
            NONE {
                doc 
                /* no actuation of this axis.
                 *
                 * > Note: Actuation of `NONE` can be either a derived `REVOLUTE` or `PRISMATIC` motion or static `FIXED` relationship.*/
            }
        }
        enum def MotionTypeEnum {
            PRISMATIC {
                doc /* sliding linear motion along an axis with a fixed range of motion.*/
            }
            CONTINUOUS {
                doc /* revolves around an axis with a continuous range of motion.*/
            }
            REVOLUTE {
                doc /* rotates around an axis with a fixed range of motion.*/
            }
            FIXED {
                doc /* axis does not move.*/
            }
        }
        enum def CoordinateSystemTypeEnum {
            WORLD {
                doc 
                /* stationary coordinate system referenced to earth, which is independent of the robot motion. {{cite(ISO 9787:2013)}}
                 *
                 * For non-robotic devices, stationary coordinate system referenced to earth, which is independent of the motion of a piece of equipment.*/
            }
            BASE {
                doc 
                /* coordinate system referenced to the base mounting surface. {{cite(ISO 9787:2013)}}
                 *
                 * A base mounting surface is a connection surface between the arm and its supporting structure.{{cite(ISO 9787:2013)}}
                 *
                 * For non-robotic devices, it is the connection surface between the device and its supporting structure.*/
            }
            OBJECT {
                doc /* coordinate system referenced to the object. {{cite(ISO 9787:2013)}}*/
            }
            TASK {
                doc /* coordinate system referenced to the site of the task. {{cite(ISO 9787:2013)}}*/
            }
            MECHANICAL_INTERFACE {
                doc /* coordinate system referenced to the mechanical interface. {{cite(ISO 9787:2013)}}*/
            }
            TOOL {
                doc /* coordinate system referenced to the tool or to the end effector attached to the mechanical interface. {{cite(ISO 9787:2013)}}*/
            }
            MOBILE_PLATFORM {
                doc /* coordinate system referenced to one of the components of a mobile platform. {{cite(ISO 8373:2012)}}*/
            }
            MACHINE {
                doc /* coordinate system referenced to the home position and orientation of the primary axes of a piece of equipment.*/
            }
            CAMERA {
                doc /* coordinate system referenced to the sensor which monitors the site of the task. {{cite(ISO 9787:2013)}}*/
            }
        }
