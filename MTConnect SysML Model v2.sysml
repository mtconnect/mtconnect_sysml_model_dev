        enum def WaitStateEnum {
            POWERING_UP {
                doc /* execution is waiting while the equipment is powering up and is not currently available to begin producing parts or products.*/
            }
            POWERING_DOWN {
                doc /* execution is waiting while the equipment is powering down but has not fully reached a stopped state.*/
            }
            PART_LOAD {
                doc /* execution is waiting while one or more discrete workpieces are being loaded.*/
            }
            PART_UNLOAD {
                doc /* execution is waiting while one or more discrete workpieces are being unloaded.*/
            }
            TOOL_LOAD {
                doc /* execution is waiting while a tool or tooling is being loaded.*/
            }
            TOOL_UNLOAD {
                doc /* execution is waiting while a tool or tooling is being unloaded.*/
            }
            MATERIAL_LOAD {
                doc /* execution is waiting while material is being loaded.*/
            }
            MATERIAL_UNLOAD {
                doc /* execution is waiting while material is being unloaded.*/
            }
            SECONDARY_PROCESS {
                doc /* execution is waiting while another process is completed before the execution can resume.*/
            }
            PAUSING {
                doc /* execution is waiting while the equipment is pausing but the piece of equipment has not yet reached a fully paused state.*/
            }
            RESUMING {
                doc /* execution is waiting while the equipment is resuming the production cycle but has not yet resumed execution.*/
            }
        }
