        enum def FormatTypeEnum {
            doc /* Enumeration for CuttingToolDefinition format values.*/
            EXPRESS {
                doc /* document will confirm to the ISO 10303 Part 21 standard.*/
            }
            TEXT {
                doc /* document will be a text representation of the tool data.*/
            }
            UNDEFINED {
                doc /* document will be provided in an undefined format.*/
            }
            XML {
                doc /* default value for the definition. The content will be an {{term(XML)}} document.*/
            }
        }
        enum def CompositionTypeEnum {
            ACTUATOR {
                doc 
                /* {{block(Composition)}} composed of a mechanism that moves or controls a mechanical part of a piece of equipment.
                 *
                 * It takes energy usually provided by air, electric current, or liquid and converts the energy into some kind of motion. */
            }
            AMPLIFIER {
                doc /* {{block(Composition)}} composed of an electronic component or circuit that amplifies power, electric current, or voltage.*/
            }
            BALLSCREW {
                doc /* {{block(Composition)}} composed of a mechanical structure that transforms rotary motion into linear motion.*/
            }
            BELT {
                doc /* {{block(Composition)}} composed of an endless flexible band that transmits motion for a piece of equipment or conveys materials and objects.*/
            }
            BRAKE {
                doc /* {{block(Composition)}} composed of a mechanism that slows down or stops a moving object by the absorption or transfer of the energy of momentum, usually by means of friction, electrical force, or magnetic force.*/
            }
            CHAIN {
                doc /* {{block(Composition)}} composed of an interconnected series of objects that band together and transmit motion for a piece of equipment or to convey materials and objects.*/
            }
            CHOPPER {
                doc /* {{block(Composition)}} composed of a mechanism that breaks material into smaller pieces.*/
            }
            CHUCK {
                doc /* {{block(Composition)}} composed of a mechanism that holds a part, stock material, or any other item in place.*/
            }
            CHUTE {
                doc /* {{block(Composition)}} composed of an inclined channel that conveys material.*/
            }
            CIRCUIT_BREAKER {
                doc /* {{block(Composition)}} composed of a mechanism that interrupts an electric circuit.*/
            }
            CLAMP {
                doc /* {{block(Composition)}} composed of a mechanism that strengthens, supports, or fastens objects in place.*/
            }
            COMPRESSOR {
                doc /* {{block(Composition)}} composed of a pump or other mechanism that reduces volume and increases pressure of gases in order to condense the gases to drive pneumatically powered pieces of equipment.*/
            }
            DOOR {
                doc /* {{block(Composition)}} composed of a mechanical mechanism or closure that covers a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.*/
            }
            DRAIN {
                doc /* {{block(Composition)}} composed of a mechanism that allows material to flow for the purpose of drainage from, for example, a vessel or tank.*/
            }
            ENCODER {
                doc /* {{block(Composition)}} composed of a mechanism that measures rotary position.*/
            }
            EXPOSURE_UNIT {
                doc /* {{block(Composition)}} composed of a mechanism that emits a type of radiation.*/
            }
            EXTRUSION_UNIT {
                doc /* {{block(Composition)}} composed of a mechanism that dispenses liquid or powered materials.*/
            }
            FAN {
                doc /* {{block(Composition)}} composed of a mechanism that produces a current of air.*/
            }
            FILTER {
                doc /* {{block(Composition)}} composed of a substance or structure that allows liquids or gases to pass through to remove suspended impurities or to recover solids.*/
            }
            GALVANOMOTOR {
                doc /* {{block(Composition)}} composed of an electromechanical actuator that produces deflection of a beam of light or energy in response to electric current through its coil in a magnetic field.*/
            }
            GRIPPER {
                doc /* {{block(Composition)}} composed of a mechanism that holds a part, stock material, or any other item in place.*/
            }
            HOPPER {
                doc /* {{block(Composition)}} composed of a chamber or bin that stores materials temporarily, typically being filled through the top and dispensed through the bottom.*/
            }
            LINEAR_POSITION_FEEDBACK {
                doc /* {{block(Composition)}} composed of a mechanism that measures linear motion or position.*/
            }
            MOTOR {
                doc /* {{block(Composition)}} composed of a mechanism that converts electrical, pneumatic, or hydraulic energy into mechanical energy.*/
            }
            OIL {
                doc /* {{block(Composition)}} composed of a viscous liquid.*/
            }
            POWER_SUPPLY {
                doc /* {{block(Composition)}} composed of a unit that provides power to electric mechanisms.*/
            }
            PULLEY {
                doc /* {{block(Composition)}} composed of a mechanism or wheel that turns in a frame or block and serves to change the direction of or to transmit force.*/
            }
            PUMP {
                doc /* {{block(Composition)}} composed of an apparatus that raises, drives, exhausts, or compresses fluids or gases by means of a piston, plunger, or set of rotating vanes.*/
            }
            REEL {
                doc /* {{block(Composition)}} composed of a rotary storage unit for material.*/
            }
            SENSING_ELEMENT {
                doc /* {{block(Composition)}} composed of a mechanism that provides a signal or measured value.*/
            }
            SPREADER {
                doc /* {{block(Composition)}} composed of a mechanism that flattens or spreads materials.*/
            }
            STORAGE_BATTERY {
                doc /* {{block(Composition)}} composed of one or more cells that converts chemical energy to electricity and serves as a source of power. */
            }
            SWITCH {
                doc /* {{block(Composition)}} composed of a mechanism that turns on or off an electric current or makes or breaks a circuit.*/
            }
            TABLE {
                doc /* {{block(Composition)}} composed of a surface that holds an object or material.*/
            }
            TANK {
                doc /* {{block(Composition)}} composed of a receptacle or container that holds material.*/
            }
            TENSIONER {
                doc /* {{block(Composition)}} composed of a mechanism that provides or applies a stretch or strain to another mechanism.*/
            }
            TRANSFORMER {
                doc /* {{block(Composition)}} composed of a mechanism that transforms electric energy from a source to a secondary circuit.*/
            }
            VALVE {
                doc /* {{block(Composition)}} composed of a mechanism that halts or controls the flow of a liquid, gas, or other material through a passage, pipe, inlet, or outlet.*/
            }
            VAT {
                doc /* {{block(Composition)}} composed of a container for liquid or powdered materials.*/
            }
            WATER {
                doc /* {{block(Composition)}} composed of a fluid.*/
            }
            WIRE {
                doc /* {{block(Composition)}} composed of a string like piece or filament of relatively rigid or flexible material provided in a variety of diameters.*/
            }
            WORKPIECE {
                doc /* {{block(Composition)}} composed of an object or material on which a form of work is performed.*/
            }
            COOLING_TOWER {
                doc /* {{block(Composition)}} composed of a heat exchange system that uses a fluid to transfer heat to the atmosphere.*/
            }
            POT {
                doc /* {{block(Composition)}} composed of a tool storage location associated with a {{block(ToolMagazine)}} or {{block(AutomaticToolChanger)}}.*/
            }
            STATION {
                doc /* {{block(Composition)}} composed of a storage or mounting location for a tool associated with a {{block(Turret)}}, {{block(GangToolBar)}}, or {{block(ToolRack)}}.*/
            }
            TRANSFER_ARM {
                doc /* {{block(Composition)}} composed of a mechanism that physically moves a tool from one location to another.*/
            }
            TRANSFER_POT {
                doc /* {{block(Pot)}} for a tool awaiting transfer from a {{block(ToolMagazine)}} to {{term(spindle)}} or {{block(Turret)}}.*/
            }
            RETURN_POT {
                doc /* {{block(Pot)}} for a tool removed from {{term(spindle)}} or {{block(Turret)}} and awaiting for return to a {{block(ToolMagazine)}}.*/
            }
            STAGING_POT {
                doc /* {{block(Pot)}} for a tool awaiting transfer to a {{block(ToolMagazine)}} or {{block(Turret)}} from outside of the piece of equipment.*/
            }
            REMOVAL_POT {
                doc /* {{block(Pot)}} for a tool to be removed from a {{block(ToolMagazine)}} or {{block(Turret)}} to a location outside of the piece of equipment.*/
            }
            EXPIRED_POT {
                doc /* {{block(Pot)}} for a tool that is no longer usable for removal from a {{block(ToolMagazine)}} or {{block(Turret)}}.*/
            }
        }
