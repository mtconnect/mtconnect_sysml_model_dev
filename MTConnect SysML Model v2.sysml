            }
            CuttingToolArchetype;
            FileArchetype;
        }
        enum def ChuckStateEnum {
            OPEN {
                doc /* {{block(Chuck)}} is open to the point of a positive confirmation.*/
            }
            CLOSED {
                doc /* {{block(Chuck)}} is closed to the point of a positive confirmation.*/
            }
            UNLATCHED {
                doc 
                /* {{block(Chuck)}} is not closed to the point of a positive confirmation and not open to the point of a positive confirmation. 
                 *
                 * It is in an intermediate position.*/
            }
        }
        enum def AxisCouplingEnum {
            TANDEM {
                doc /* axes are physically connected to each other and operate as a single unit.*/
            }
            SYNCHRONOUS {
                doc /* axes are not physically connected to each other but are operating together in lockstep.*/
            }
            MASTER {
                doc /* axis is the master of the {{block(CoupledAxes)}}.*/
            }
            SLAVE {
                doc /* axis is a slave to the {{block(CoupledAxes)}}.*/
            }
