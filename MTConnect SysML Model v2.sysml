                doc /* element indicating the floor or level on which a delivery point is located in a multi-story building.*/
            }
            attribute Door [0..1] : string {
                doc /* element indicating the apartment, room or office in, at or adjacent to which a delivery point, situated within a building, is located.*/
            }
            attribute Thoroughfare [0..1] : string {
                doc /* element which identifies the road or part of a road or other access route along which a delivery point can be accessed, either directly or via a secondary or tertiary road or access route.*/
            }
            attribute PremiseIdentifier [0..1] : string {
                doc /* element designating the area or the object on an area, adjacent to thoroughfare, in which the delivery point or delivery point access is located.*/
            }
            attribute Town [0..1] : string {
                doc /* element indicating the name of the populated place in which a delivery point is located, or the populated.*/
            }
            attribute Region [0..1] : string {
                doc /* element specifying the geographic or administrative area of the country in which the town is situated.*/
            }
            attribute District [0..1] : string {
                doc /* element indicating the name of the area within or adjacent to the town in which a delivery point is located, or via which it is accessed.*/
            }
            attribute CountryName [0..1] : string {
                doc /* element designating the country, dependency or area of geopolitical interest, in which a delivery point is located or via which the delivery point is accessed.*/
            }
            attribute CountryCode [0..1] : string {
                doc /* interest, in which a delivery point is located or via which the delivery point is accessed.*/
            }
            attribute PostCode [0..1] : string {
                doc /* element designating the code used for the sorting of mail.*/
            }
        }
