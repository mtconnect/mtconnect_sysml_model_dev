package 'Development Process' {
    action def 'Development Process' {
        first startShot then 'New Issue (WG)';
        succession 'Consider for Next Release' first 'New Issue (WG)' then 'In Discussion (WG)';
        succession 'Completed Content' first 'In Discussion (WG)' then 'Reviewing (RB)';
        first 'Reviewing (RB)' then 'Review Complete ';
        succession 'Needs more work' first 'Review Complete ' then 'In Discussion (WG)';
        succession 'Content Accepted' first 'Review Complete ' then 'Models and Docs (DM)';
        first 'Models and Docs (DM)' then 'Final Review (WG)';
        first 'Final Review (WG)' then __unnamed49;
        succession 'documentation needs correction' first __unnamed49 then 'Models and Docs (DM)';
        succession 'content is correct' first __unnamed49 then 'EC Review (EC)';
        first 'EC Review (EC)' then __unnamed50;
        succession 'issues with content' first __unnamed50 then 'In Discussion (WG)';
        succession 'IP or Copyright Issues' first __unnamed51 then 'In Discussion (WG)';
        succession 'content is good' first __unnamed50 then '90 Day Review (SC)';
        first '90 Day Review (SC)' then __unnamed51;
        succession 'No issues' first __unnamed51 then 'Vote (SC)';
        first 'Vote (SC)' then __unnamed52;
        succession Released first __unnamed52 then Public;
        succession Rejected first __unnamed52 then 'EC Review (EC)';
        action Public terminate;
        action 'New Issue (WG)';
        action 'In Discussion (WG)';
        decide 'Review Complete ';
        action 'Reviewing (RB)';
        action 'Models and Docs (DM)';
        action 'Final Review (WG)';
        decide __unnamed49;
        action 'EC Review (EC)';
        decide __unnamed50;
        action '90 Day Review (SC)';
        action 'Vote (SC)';
        decide __unnamed51;
        decide __unnamed52;
    }
}
