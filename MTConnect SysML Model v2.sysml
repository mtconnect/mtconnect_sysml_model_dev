                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Oil :> Component {
                doc /* leaf {{block(Component)}} composed of a viscous liquid.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Table :> Component {
                doc /* leaf {{block(Component)}} composed of a surface for holding an object or material.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Chopper :> Component {
                doc /* leaf {{block(Component)}} that breaks material into smaller pieces.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Valve :> Component {
                doc /* leaf {{block(Component)}} that halts or controls the flow of a liquid, gas, or other material through a passage, pipe, inlet, or outlet.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Pot :> Component {
                doc /* leaf {{block(Component)}} composed of a tool storage location associated with a {{block(ToolMagazine)}} or {{block(AutomaticToolChanger)}}.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Transformer :> Component {
                doc /* leaf {{block(Component)}} that transforms electric energy from a source to a secondary circuit.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def ExposureUnit :> Component {
                doc /* leaf {{block(Component)}} that emits a type of radiation.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Tank :> Component {
                doc /* leaf {{block(Component)}} generally composed of an enclosed container.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Encoder :> Component {
                doc /* leaf {{block(Component)}} that measures position.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def StorageBattery :> Component {
                doc /* leaf {{block(Component)}} composed of one or more cells in which chemical energy is converted into electricity and used as a source of power. */
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def CircuitBreaker :> Component {
                doc /* leaf {{block(Component)}} that interrupts an electric circuit.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Motor :> Component {
                doc /* leaf {{block(Component)}} that converts electrical, pneumatic, or hydraulic energy into mechanical energy.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def ExtrusionUnit :> Component {
                doc /* leaf {{block(Component)}} that dispenses liquid or powered materials.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Galvanomotor :> Component {
                doc /* leaf {{block(Component)}} composed of an electromechanical actuator that produces deflection of a beam of light or energy in response to electric current through its coil in a magnetic field.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Pump :> Component {
                doc /* leaf {{block(Component)}} that raises, drives, exhausts, or compresses fluids or gases by means of a piston, plunger, or set of rotating vanes.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Clamp :> Component {
                doc /* leaf {{block(Component)}} that strengthens, support, or fastens objects in place.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def LinearPositionFeedback :> Component {
                doc 
                /* leaf {{block(Component)}} that measures linear motion or position.
                 *
                 * **DEPRECATION WARNING** : May be deprecated in the future. Recommend using {{block(Encoder)}}.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def Workpiece :> Component {
                doc /* leaf {{block(Component)}} composed of an object or material on which a form of work is performed.*/
                part hasComposition [0] :>> hasComposition : 'Device Information Model'::Compositions::Composition;
                part hasComponent [0] :>> hasComponent : Component;
            }
            part def WorkEnvelope :> System {
                doc /* {{block(System)}} composed of the physical process execution space within a piece of equipment.*/
                comment /* Description*/
                doc /* {{block(WorkEnvelope)}} **MAY** provide information regarding the physical workspace and the conditions within that workspace.*/
            }
            part def FeatureOccurrence :> PartOccurrence {
                doc /* {{block(Component)}} that provides information related to an individual {{term(feature)}}.*/
                part observesFeaturePersisitentId [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::FeaturePersisitentId;
                part observesFeatureMeasurement [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::FeatureMeasurement;
                part observesMeasurementType [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::MeasurementType;
                part observesCharacteristicPersistentId [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::CharacteristicPersistentId;
                part observesCharacteristicStatus [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::CharacteristicStatus;
                part observesUncertainty [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::Uncertainty;
                part observesUncertaintyType [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::UncertaintyType;
                part observesMeasurementUnits [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::MeasurementUnits;
                part observesMeasurementValue [0..1] : 'Observation Information Model'::'Observation Types'::'Event Types'::MeasurementValue;
            }
            connection def {
                end observesFeaturePersisitentId : 'Observation Information Model'::'Observation Types'::'Event Types'::FeaturePersisitentId => target.observesFeaturePersisitentId;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesFeatureMeasurement : 'Observation Information Model'::'Observation Types'::'Event Types'::FeatureMeasurement => target.observesFeatureMeasurement;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesMeasurementType : 'Observation Information Model'::'Observation Types'::'Event Types'::MeasurementType => target.observesMeasurementType;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesCharacteristicPersistentId : 'Observation Information Model'::'Observation Types'::'Event Types'::CharacteristicPersistentId => target.observesCharacteristicPersistentId;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesCharacteristicStatus : 'Observation Information Model'::'Observation Types'::'Event Types'::CharacteristicStatus => target.observesCharacteristicStatus;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesUncertainty : 'Observation Information Model'::'Observation Types'::'Event Types'::Uncertainty => target.observesUncertainty;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesUncertaintyType : 'Observation Information Model'::'Observation Types'::'Event Types'::UncertaintyType => target.observesUncertaintyType;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesMeasurementUnits : 'Observation Information Model'::'Observation Types'::'Event Types'::MeasurementUnits => target.observesMeasurementUnits;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesMeasurementValue : 'Observation Information Model'::'Observation Types'::'Event Types'::MeasurementValue => target.observesMeasurementValue;
                private end : FeatureOccurrence;
            }
            connection def {
                end observesEmergencyStop : 'Observation Information Model'::'Observation Types'::'Event Types'::EmergencyStop => target.observesEmergencyStop;
                private end : Controller;
            }
            connection def {
                end observesSystemCondition : 'Observation Information Model'::'Observation Types'::'Condition Types'::System => target.observesSystemCondition;
                private end : Controller;
            }
            connection def {
                end observesControllerMode : 'Observation Information Model'::'Observation Types'::'Event Types'::ControllerMode => target.observesControllerMode;
                private end : Controller;
            }
            part def AirHandler :> System {
                doc /* system that circulates air or regulates airflow without altering temperature or humidity.*/
            }
            part def Electrode :> Auxiliary {
                doc /* {{block(Auxiliary)}} that is used for many electrical discharge manufacturing processes like welding.*/
            }
            part def CuttingTorch :> Auxiliary {
                doc /* {{block(Auxiliary)}} that employs a concentrated flame to both sever materials through cutting and fuse them together in joining processes.*/
            }
            part def ToolHolder :> System {
                doc /* {{block(System)}} that securely interfaces a {{block(Component)}} with a {{block(Device)}}*/
                comment /* Description*/
                doc /* It is the part of a piece of equipment that interacts with the manufacturing process.*/
            }
            part def PinTool :> System {
                doc /* {{block(System)}} composed of a tool that performs the work for a Friction Stir Welding process*/
                comment /* Description*/
                doc /* It is the part of a piece of equipment that interacts with the manufacturing process.*/
            }
            doc 
            /* This section provides semantic information for the types of {{block(Component)}}. 
             *
             * > Note: In the {{term(XML)}} representation, {{block(Component)}} entities are defined into two major categories:
             *
             * > * {{term(top level)}} {{block(Component)}} entities that {{termplural(organize)}} the most significant physical or logical functions of a piece of equipment (see {{sect(Part Properties of Device)}}).  They **MAY** also be used as {{term(lower level)}} {{block(Component)}} entities; as required. See {{package(Component Organizer Types)}}.
             *
             * > * {{term(lower level)}} {{block(Component)}} entities composed of the sub-parts of the parent {{block(Component)}} to provide more clarity and granularity to the physical or logical structure of the {{term(top level)}} {{block(Component)}} entities.
             *
             * This section provides guidance for the most common relationships between {{block(Component)}} types.  However, all {{block(Component)}} types **MAY** be used in any configuration, as required, to fully describe a piece of equipment.
             *
             * As described in {{package(Components)}}, {{block(Component)}} is an abstract entity and will be always realized by a specific {{block(Component)}} type.*/
        }
        connection def Description {
            end hasDescription : Description => target.hasDescription;
            doc /* See {{sect(Description)}}.*/
            private end : Component;
        }
        connection def Compositions {
            end isCompositionOf : Component => hasComposition.'Device Information Model'::Compositions::Composition::isCompositionOf;
            end hasComposition : 'Device Information Model'::Compositions::Composition => isCompositionOf.hasComposition;
            doc /* {{block(Compositions)}} groups one or more {{block(Composition)}} entities. See {{package(Compositions)}}.*/
        }
        connection def Components {
            end hasComponent : Component => isComponentOf.hasComponent;
            end isComponentOf : Component => hasComponent.'Device Information Model'::Components::Component::isComponentOf;
            doc /* {{block(Components)}} groups one or more {{block(Component)}} entities.*/
        }
        connection def Configuration {
            end isConfigurationFor : Component => hasConfiguration.'Device Information Model'::Configurations::Configuration::isConfigurationFor;
            end hasConfiguration : Configurations::Configuration => isConfigurationFor.hasConfiguration;
            doc /* See {{package(Configurations)}}.*/
        }
        connection def DataItems {
            end isObservedBy : Component => observes.'Device Information Model'::DataItems::DataItem::isObservedBy;
            end observes : 'Device Information Model'::DataItems::DataItem => isObservedBy.observes;
            doc /* {{block(DataItems)}} groups one or more {{block(DataItem)}} entities. See {{package(DataItems)}}.*/
        }
        connection def References {
            end hasReference : 'Device Information Model'::References::Reference => target.hasReference;
            doc /* {{block(References)}} groups one or more {{block(Reference)}} entities associated with the {{block(Component)}}. See {{package(References)}}.*/
            private end : Component;
        }
        package Devices {
            part def Agent :> Device {
                doc /* {{block(Device)}} composed of an {{term(MTConnect Agent)}} and all its connected data sources.*/
                comment /* Description*/
                doc 
                /* An {{block(Agent)}} **MUST** be provided by all {{term(MTConnect Agent)}} implementations.
                 *
                 * An {{block(Agent)}} **MUST** provide notifications when devices are added or changed.
                 *
                 * An {{block(Agent)}} **MUST** provide connection information for each data source currently supplying data to the {{term(MTConnect Agent)}}.
                 *
                 * An {{block(Agent)}} **MAY** provide information about telemetry relating to data sources.
                 *
                 * An {{block(Agent)}} **MAY** provide information about the {{term(MTConnect Agent)}} resource utilization.
                 */
            }
            doc /* This section provides semantic information for the {{block(Device)}} types.*/
        }
        connection def ComponentStream {
            end isOrganizerFor : Component => hasComponentStream.'Observation Information Model'::ComponentStream::isOrganizerFor;
            end hasComponentStream : 'Observation Information Model'::ComponentStream => isOrganizerFor.hasComponentStream;
            doc 
            /* {{block(ComponentStream)}} {{termplural(organize)}} the {{block(Observation)}} entities associated with the {{block(Component)}}.
             *
             * See {{package(Observation Information Model)}} for the {{block(ComponentStream)}} model.
             *
             * > Note 1 to entry: In the {{term(XML)}} representation, {{block(ComponentStream)}} entities **MUST NOT** appear in the {{term(MTConnectDevices Response Document)}}.
             *
             * > Note 2 to entry: In the {{term(XML)}} representation, {{block(ComponentStream)}} entities **MUST** appear only in the {{term(MTConnectStreams Response Document)}}.*/
        }
        doc 
        /* This section provides semantic information for the {{block(Component)}} entity. {{figure(Components)}} shows the {{block(Component)}} model. 
         *
         * ![Components](figures/Components.png "Components"){: width="0.8"}
         *
         * > Note: See {{sect(Components Schema Diagrams)}} for XML schema.
         */
        comment /* Components Model*/
        doc 
        /* {{block(MTConnectDevices)}} provides the physical and logical architecture of a piece of equipment. {{figure(Device Entity Hierarchy Example)}} provides an overview of the entities used in an example of an {{block(MTConnectDevices)}} entity.
         *
         * ![Device Entity Hierarchy Example](figures/Device%20Entity%20Hierarchy%20Example.png "Device Entity Hierarchy Example"){: width="0.8"}
         *
         * > Note 1 to entry: See {{lst(device-entity-hierarchy-example)}} for the {{term(XML)}} representation of the same example.
         *
         * > Note 2 to entry: Example above only shows the {{block(Component)}} and {{block(Composition)}} level hierarchy. For a complete semantics on each kind see {{package(Components)}} and {{package(Compositions)}}.
         *
         * A variety of entities are defined to describe a piece of equipment.  Some of these entities **MUST** always be defined for an {{block(MTConnectDevices)}} entity, while others are optional and **MAY** be used, as required, to provide additional structure.
         *
         * The first, or highest level, entity defined for an {{block(MTConnectDevices)}} entity is {{block(Devices)}}. {{block(Devices)}} is used to group one or more pieces of equipment into a single document.  {{block(Devices)}} **MUST** always be defined for an {{block(MTConnectDevices)}} entity.
         *
         * {{block(Device)}} is the next entity defined for the {{block(MTConnectDevices)}} entity. A separate {{block(Device)}} entity is used to identify each piece of equipment for an {{block(MTConnectDevices)}} entity. Each {{block(Device)}} provides information on the physical and logical structure of the piece of equipment and the data associated with that equipment. {{block(Device)}} can also represent any logical grouping of pieces of equipment that function as a unit or any other data source that provides data through an {{term(agent)}}.
         *
         * One or more {{block(Device)}} entities **MUST** always be defined for an {{block(MTConnectDevices)}} entity.
         *
         * {{block(Components)}} is the next entity defined for the {{block(MTConnectDevices)}} entity. {{block(Components)}} is used to group information describing lower level physical parts or logical functions of a piece of equipment.
         *
         * {{block(Component)}} is the next level of entity defined for the {{block(MTConnectDevices)}} entity. {{block(Component)}} is both an abstract type entity and an {{term(organizer)}} type entity. 
         *
         * As an abstract entity, {{block(Component)}} will always be realized by a specific {{block(Component)}} type defined in {{package(Component Types)}}. Each {{block(Component)}} can also be used to organize information describing {{term(lower level)}} entities or {{termplural(DataItem)}} associated with the {{block(Component)}}.
         *
         * If {{term(lower level)}} entities are described, these entities are by definition child {{block(Component)}} entities of a parent {{block(Component)}}. At this next level, the {{term(lower level)}} child {{block(Component)}} entities are grouped by {{block(Components)}}.
         *
         * A {{block(Component)}} **MAY** be further decomposed into {{block(Composition)}} entities that are grouped by {{block(Compositions)}}. These describe the lowest level basic structural or functional building blocks contained within a {{block(Component)}}. Data provided for a {{block(Component)}} provides more specific meaning when it is associated with one of the {{block(Composition)}} entities of the {{block(Component)}}. The different {{block(Composition)}} types that **MAY** be defined for the {{block(MTConnectDevices)}} entity are defined in {{package(Compositions)}}.
         *
         * This parent-child relationship can continue to any depth required to fully define a piece of equipment.
         *
         * > Note: See {{figure(Device Entity Hierarchy Example)}} for an example.
         */
    }
    package Compositions {
        connection def Description {
            end hasDescription : Components::Description => target.hasDescription;
            doc /* See {{sect(Description)}}.*/
            private end : Composition;
        }
        connection def Configuration {
            end hasConfiguration : Configurations::Configuration => isConfigurationFor.hasConfiguration;
            end isConfigurationFor : Composition => hasConfiguration.'Device Information Model'::Configurations::Configuration::isConfigurationFor;
            doc /* See {{sect(Configurations Model)}}.*/
        }
        abstract part def Composition {
            doc /* functional part of a piece of equipment contained within a {{block(Component)}}.*/
            comment /* Description*/
            private ref part isCompositionOf : Components::Component;
            part hasDescription [0..1] : Components::Description;
            part hasConfiguration [0..1] : Configurations::Configuration;
            attribute id [1] : Profile::DataTypes::ID {
                doc /* unique identifier for the {{block(Composition)}} element.*/
            }
            attribute type [1] : Profile::DataTypes::CompositionTypeEnum {
                doc /* type of {{block(Composition)}}.*/
            }
            attribute name [0..1] : Profile::DataTypes::string {
                doc /* name of the {{block(Composition)}} element.*/
            }
            attribute uuid [0..1] : Profile::DataTypes::UUID {
                doc /* universally unique identifier for the {{block(Composition)}}.*/
            }
            doc /* {{block(Composition)}} **MUST NOT** have child {{block(Component)}}, {{block(Composition)}}, or {{block(DataItems)}} elements.*/
        }
        doc 
        /* This section provides semantic information for the {{block(Composition)}} entity.
         *
         * See {{figure(Components)}} for the {{block(Composition)}} model diagram.
         *
         * ![Component with Compositions Example](figures/Component%20with%20Compositions%20Example.png "Component with Compositions Example"){: width="0.8"}
         *
         * > Note: See {{lst(component-with-compositions-example)}} for the {{term(XML)}} representation of the same example.*/
        comment /* Compositions Model*/
        doc 
        /* {{block(Composition)}} entities are used to describe the lowest level physical building blocks of a piece of equipment contained within a {{block(Component)}}. By referencing a specific {{block(Composition)}} entity, further clarification and meaning to data associated with a specific {{block(Component)}} can be achieved.
         *
         * Both {{block(Component)}} and {{block(Composition)}} entities are {{term(lower level)}} entities representing the sub-parts of the parent {{block(Component)}}.  However, there are distinct differences between {{block(Component)}} and {{block(Composition)}} type entities.
         *
         * {{block(Component)}} entities may be further defined with {{term(lower level)}} {{block(Component)}} entities and may have associated {{termplural(DataItem)}}.
         *
         * {{block(Composition)}} entities represent the lowest level physical part of a piece of equipment.  They **MUST NOT** be further defined with {{term(lower level)}} {{block(Component)}} entities and they **MUST NOT** have {{termplural(DataItem)}} directly associated with them.   They do provide additional information that can be used to enhance the specificity of {{termplural(DataItem)}} associated with the parent {{block(Component)}}.*/
    }
    package DataItems {
        package 'DataItem Types' {
            abstract part def Event :> DataItem {
                doc /* abstract {{block(DataItem)}} that is a discrete piece of information from a piece of equipment. It does not have intermediate values that vary over time.
                 */
                comment /* Description*/
                attribute category [1] :>> category : Profile::DataTypes::CategoryEnum default "EVENT";
                attribute type [1] :>> type : Profile::DataTypes::EventEnum;
                doc /* An {{block(Event)}} is information that, when provided at any specific point in time, represents the current state of the piece of equipment.*/
            }
            abstract part def Sample :> DataItem {
                doc /* abstract {{block(DataItem)}} that is continuously changing or analog data value.
                 */
                comment /* Description*/
                attribute category [1] :>> category : Profile::DataTypes::CategoryEnum default "SAMPLE";
                attribute type [1] :>> type : Profile::DataTypes::SampleEnum;
                attribute units [1] :>> units : Profile::DataTypes::UnitEnum;
                doc /* This data can be measured at any point-in-time and will always produce a result.*/
            }
            abstract part def Condition :> DataItem {
                doc /* abstract {{block(DataItem)}} that is about an entity's status regarding its ability to operate or it provides an indication whether the data reported for the entity is within an expected range.*/
                comment /* Description*/
                attribute category [1] :>> category : Profile::DataTypes::CategoryEnum default "CONDITION";
                attribute type [1] :>> type : Profile::DataTypes::ConditionEnum;
                doc 
                /* {{block(Condition)}} is reported differently than {{block(Sample)}} or {{block(Event)}}.  {{block(Condition)}} **MUST** be reported as {{block(Normal)}}, {{block(Warning)}}, or {{block(Fault)}}.
                 *
                 * All {{block(Sample)}}s **MAY** have associated {{block(Condition)}} states.  {{block(Condition)}} states indicate whether the value for the data is within an expected range and **MUST** be reported as {{block(Normal)}}, or the value is unexpected or out of tolerance for the data and a {{block(Warning)}} or {{block(Fault)}} **MUST** be provided.*/
            }
            doc 
            /* This section provides semantic information for the types of a {{block(DataItem)}}.
             *
             * In the MTConnect Standard, {{block(DataItem)}} are defined and organized based upon the {{property(DataItem::category)}} and {{property(DataItem::type)}}.  The {{property(DataItem::category)}} provides a high level grouping for {{block(DataItem)}}s based on the kind of information that is reported by the data item.
             *
             * These categories are:
             *
             * * `SAMPLE`: A `SAMPLE` reports a continuously variable or analog data value. 
             *
             * * `EVENT`: An `EVENT` reports information representing a functional state, with two or more discrete values, associated with a component or it contains a message.  The data provided may be a numeric value or text.
             *
             * * `CONDITION`: A `CONDITION` reports information about the health of a piece of equipment and its ability to function.
             *
             * The {{property(DataItem::type)}} specifies the specific kind of data that is reported.   For some types of data items, a {{property(DataItem::subType)}} may also be used to differentiate between multiple data items of the same {{property(DataItem::type)}} where the information reported by the data item has a different, but related, meaning.
             *
             * Many types of data items provide two forms of data: a value (reported as either a `SAMPLE` or `EVENT`) and a health status (reported as a `CONDITION`).  These {{block(DataItem)}} types **MAY** be defined in more than one {{property(DataItem::category)}} based on the data that they report.
             */
        }
        part def DataItem {
            doc /* information reported about a piece of equipment.*/
            attribute category [1] : Profile::DataTypes::CategoryEnum {
                doc /* specifies the kind of information provided by a data item.*/
            }
            attribute compositionId [0..1] : Profile::DataTypes::ID {
                doc /* identifier attribute of the {{block(Composition)}} that the reported data is most closely associated.*/
            }
            attribute coordinateSystem [0..1] : Profile::DataTypes::CoordinateSystemEnum {
                doc 
                /* for measured values relative to a coordinate system like {{block(Position)}}, the coordinate system used may be reported.
                 *
                 * **DEPRECATED** in *Version 2.0*. Replaced by {{property(Component::coordinateSystemIdRef)}}. */
            }
            attribute discrete [1] : Profile::DataTypes::boolean default false {
                doc 
                /* indication signifying whether each value reported for the {{term(Observation)}} is significant and whether duplicate values are to be suppressed.
                 *
                 * If a value is not defined for {{property(DataItem::discrete)}}, the default value **MUST** be `false`.*/
            }
            attribute id [1] : Profile::DataTypes::ID {
                doc /* unique identifier for this data item.*/
            }
            attribute name [0..1] : Profile::DataTypes::string {
                doc /* name of the data item.*/
            }
            attribute nativeScale [0..1] : Profile::DataTypes::integer {
                doc /* used to convert the reported value to represent the original measured value.*/
            }
            attribute nativeUnits [0..1] : Profile::DataTypes::NativeUnitEnum {
                doc /* native units of measurement for the reported value of the data item.*/
            }
            attribute sampleRate [0..1] : Profile::DataTypes::float {
                doc /* rate at which successive samples of a data item are recorded by a piece of equipment.*/
            }
            attribute significantDigits [0..1] : Profile::DataTypes::integer {
                doc /* number of significant digits in the reported value.*/
            }
            attribute statistic [0..1] : Profile::DataTypes::StatisticEnum {
                doc /* type of statistical calculation performed on a series of data samples to provide the reported data value.*/
            }
            attribute subType [0..1] : Profile::DataTypes::DataItemSubTypeEnum {
                doc /* sub-categorization of the {{property(DataItem::type)}}.*/
            }
            attribute type [1] : Profile::DataTypes::DataItemTypeEnum {
                doc /* type of data being measured. See {{package(DataItem Types)}}.*/
            }
            attribute units [0..1] : Profile::DataTypes::UnitEnum {
                doc /* unit of measurement for the reported value of the data item.*/
            }
            private ref part isObservedBy [1] : Components::Component;
            attribute representation [0..1] : Profile::DataTypes::RepresentationEnum {
                doc 
                /* description of a means to interpret data consisting of multiple data points or samples reported as a single value.  
                 *
                 * If {{property(DataItem::representation)}} is not specified, it **MUST** be determined to be `VALUE`.
                 */
            }
            part hasSource [0..1] : 'Properties of DataItem'::Source;
            part hasConstraint [0..1] : 'Properties of DataItem'::Constraints;
            part hasFilter [0..*] : 'Properties of DataItem'::Filter;
            part hasInitialValue [0..1] : 'Properties of DataItem'::InitialValue;
            part hasResetTrigger [0..1] : 'Properties of DataItem'::ResetTrigger;
            ref part hasObservation [0..*] : 'Observation Information Model'::Observation;
            part hasDefinition [0..1] : 'Properties of DataItem'::Definition;
            attribute coordinateSystemIdRef [0..1] : Profile::DataTypes::ID {
                doc /* associated {{block(CoordinateSystem)}} context for the {{block(DataItem)}}.*/
            }
            part hasRelationship [0..*] : 'Properties of DataItem'::'Relationship Types for DataItem'::AbstractDataItemRelationship;
        }
        connection def Filters {
            end hasFilter : 'Properties of DataItem'::Filter => target.hasFilter;
            doc /* {{block(Filters)}} groups one or more {{block(Filter)}} entities associated with the {{block(DataItem)}}. */
            private end : DataItem;
        }
        connection def Constraints {
            end hasConstraint : 'Properties of DataItem'::Constraints => target.hasConstraint;
            doc /* {{block(Constraints)}} organizes a set of expected values that can be reported for the {{block(DataItem)}}. See {{sect(Constraints)}}.*/
            private end : DataItem;
        }
        connection def ResetTrigger {
            end hasResetTrigger : 'Properties of DataItem'::ResetTrigger => target.hasResetTrigger;
            private end : DataItem;
        }
        connection def InitialValue {
            end hasInitialValue : 'Properties of DataItem'::InitialValue => target.hasInitialValue;
            private end : DataItem;
        }
        connection def Source {
            end hasSource : 'Properties of DataItem'::Source => target.hasSource;
            doc /* See {{sect(Source)}}.*/
            private end : DataItem;
        }
        connection def Observations {
            end madeForDataItem : DataItem => hasObservation.'Observation Information Model'::Observation::madeForDataItem;
            end hasObservation : 'Observation Information Model'::Observation => madeForDataItem.hasObservation;
            doc 
            /* {{block(Observations)}} groups one or more {{block(Observation)}} entities made for the {{block(DataItem)}} entity. 
             *
             * {{block(Component)}} {{termplural(observe)}} {{block(DataItem)}} entities to create {{block(Observation)}} entities for the {{block(DataItem)}} entities.
             *
             * See {{package(Observation Information Model)}} for the {{block(Observation)}} model.
             *
             * > Note 1 to entry: In the {{term(XML)}} representation, {{block(Observation)}} entities **MUST NOT** appear in the {{term(MTConnectDevices Response Document)}}.
             *
             * > Note 2 to entry: In the {{term(XML)}} representation, {{block(Observation)}} entities **MUST** appear only in the {{term(MTConnectStreams Response Document)}}.*/
        }
        connection def Definition {
            end hasDefinition : 'Properties of DataItem'::Definition => target.hasDefinition;
            doc /* See {{sect(Definition)}}.*/
            private end : DataItem;
        }
        package 'Properties of DataItem' {
            part def ResetTrigger {
                doc /* type of event that may cause a reset to occur.*/
                attribute value [1] : Profile::DataTypes::ResetTriggerEnum {
                    doc /* type of {{block(ResetTrigger)}}.*/
                }
            }
            part def Source {
                doc /* identifies the {{block(Component)}}, {{block(DataItem)}}, or {{block(Composition)}} from which a measured value originates.*/
                attribute componentId [0..1] : Profile::DataTypes::ID {
                    doc /* identifier of the {{block(Component)}} that represents the physical part of a piece of equipment where the data represented by the {{block(DataItem)}} originated.*/
                }
                attribute compositionId [0..1] : Profile::DataTypes::ID {
                    doc /* identifier of the {{block(Composition)}} that represents the physical part of a piece of equipment where the data represented by the {{block(DataItem)}} originated.*/
                }
                attribute dataItemId [0..1] : Profile::DataTypes::ID {
                    doc /* identifier of the {{block(DataItem)}} that represents the originally measured value of the data referenced by this {{block(DataItem)}}.*/
                }
                attribute value [0..1] : Profile::DataTypes::string {
                    doc /* identifier of the source entity.*/
                }
            }
            part def InitialValue {
                doc /* starting value for a {{block(DataItem)}} as well as the value to be set for the {{block(DataItem)}} after a reset event.*/
                attribute value [1] : Profile::DataTypes::string;
            }
            abstract part def Filter {
                doc /* provides a means to control when an {{term(agent)}} records updated information for a {{block(DataItem)}}. */
                attribute type [1] : Profile::DataTypes::FilterEnum {
                    doc /* type of {{block(Filter)}}.*/
                }
                attribute value [0..1] : Profile::DataTypes::float;
            }
            part def Constraints {
                doc /* {{termplural(organize)}} a set of expected values that can be reported for a {{block(DataItem)}}.*/
                attribute Maximum [0..1] : Profile::DataTypes::float {
                    doc 
                    /* numeric upper constraint.
                     *
                     * If the data reported for a data item is a range of numeric values, the expected value reported **MAY** be described with an upper limit defined by this constraint.*/
                }
                attribute Minimum [0..1] : Profile::DataTypes::float {
                    doc 
                    /* numeric lower constraint.
                     *
                     * If the data reported for a data item is a range of numeric values, the expected value reported **MAY** be described with a lower limit defined by this constraint.*/
                }
                attribute Nominal [0..1] : Profile::DataTypes::float {
                    doc /* numeric target or expected value.*/
                }
                attribute Value [0..*] : Profile::DataTypes::string {
                    doc 
                    /* single data value that is expected to be reported for a {{block(DataItem)}}.
                     *
                     * {{property(Constraints::Value)}} **MUST NOT** be used in conjunction with any other {{block(Constraint)}} elements.*/
                }
                part hasFilter [0..1] : Filter;
            }
            package 'Properties of Definition' {
                part def CellDefinition {
                    doc /* semantic definition of a {{block(Cell)}}.*/
                    attribute units [0..1] : Profile::DataTypes::UnitEnum {
                        doc /* same as {{property(DataItem::units)}}. See {{sect(Value Properties of DataItem)}}.*/
                    }
                    attribute key [0..1] : Profile::DataTypes::string {
                        doc 
                        /* unique identification of the {{block(Cell)}} in the {{block(Definition)}}. 
                         *
                         * The description applies to all {{block(Cell)}} {{termplural(observation)}} having this {{property(CellDefinition::key)}}.*/
                    }
                    attribute type [0..1] : Profile::DataTypes::DataItemTypeEnum {
                        doc /* same as {{property(DataItem::type)}}. See {{package(DataItem Types)}}.*/
                    }
                    attribute subType [0..1] : Profile::DataTypes::DataItemSubTypeEnum {
                        doc /* same as {{property(DataItem::subType)}}. See {{sect(DataItem)}}.*/
                    }
                    attribute keyType [0..1] : Profile::DataTypes::DataItemTypeEnum {
                        doc /* {{property(DataItem::type)}} that defines the meaning of {{property(CellDefinition::key)}}.*/
                    }
                    private attribute Description [0..1] : Profile::DataTypes::string {
                        doc /* textual description for {{block(CellDefinition)}}.*/
                    }
                }
                part def EntryDefinition {
                    doc /* semantic definition of an {{block(Entry)}}.*/
                    attribute key [0..1] : Profile::DataTypes::string {
                        doc 
                        /* unique identification of the {{block(Entry)}} in the {{block(Definition)}}. 
                         *
                         * The description applies to all {{block(Entry)}} {{termplural(observation)}} having this {{property(EntryDefinition::key)}}.*/
                    }
                    attribute units [0..1] : Profile::DataTypes::UnitEnum {
                        doc /* same as {{property(DataItem::units)}}. See {{sect(Value Properties of DataItem)}}.*/
                    }
                    part hasCellDefinition [0..*] : CellDefinition;
                    attribute type [0..1] : Profile::DataTypes::DataItemTypeEnum {
                        doc /* same as {{property(DataItem::type)}}. See {{package(DataItem Types)}}.*/
                    }
                    attribute subType [0..1] : Profile::DataTypes::DataItemSubTypeEnum {
                        doc /* same as {{property(DataItem::subType)}}. See {{sect(DataItem)}}.*/
                    }
                    attribute keyType [0..1] : Profile::DataTypes::DataItemTypeEnum {
                        doc /* {{property(DataItem::type)}} that defines the meaning of {{property(EntryDefinition::key)}}.*/
                    }
                    private attribute Description [0..1] : Profile::DataTypes::string {
                        doc /* textual description for {{block(EntryDefinition)}}.*/
                    }
                }
                connection def CellDefinitions {
                    end hasCellDefinition : CellDefinition => target.hasCellDefinition;
                    doc /* {{block(CellDefinitions)}} groups one or more {{block(CellDefinition)}} entities if {{property(DataItem::representation)}} is `TABLE`. See {{sect(CellDefinition)}}.*/
                    private end : EntryDefinition;
                }
                doc /* This section provides semantic information for the elements of the {{block(Definition)}} for a {{block(DataItem)}}.*/
            }
            part def Definition {
                doc /* defines the meaning of {{block(Entry)}} and {{block(Cell)}} entities when the associated {{property(DataItem::representation)}} is either `DATA_SET` or `TABLE`.*/
                part hasCellDefinition [0..*] : 'Properties of Definition'::CellDefinition;
                part hasEntryDefinition [0..*] : 'Properties of Definition'::EntryDefinition;
                private attribute Description [0..1] : Profile::DataTypes::string {
                    doc /* textual description for {{block(Definition)}}.*/
                }
            }
            connection def CellDefinitions {
                end hasCellDefinition : 'Properties of Definition'::CellDefinition => target.hasCellDefinition;
                doc /* {{block(CellDefinitions)}} groups one or more {{block(CellDefinition)}} entities. See {{sect(CellDefinition)}}.*/
                private end : Definition;
            }
            connection def EntryDefinitions {
                end hasEntryDefinition : 'Properties of Definition'::EntryDefinition => target.hasEntryDefinition;
                doc /* {{block(EntryDefinitions)}} groups one or more {{block(EntryDefinition)}} entities. See {{sect(EntryDefinition)}}.*/
                private end : Definition;
            }
            package 'Relationship Types for DataItem' {
                part def SpecificationRelationship :> AbstractDataItemRelationship {
                    doc /* {{block(AbstractDataItemRelationship)}} that provides a semantic reference to another {{block(Specification)}} described by {{property(SpecificationRelationship::type)}} and {{property(SpecificationRelationship::idRef)}}.*/
                    attribute type [1] : Profile::DataTypes::SpecificationRelationshipTypeEnum {
                        doc /* specifies how the {{block(Specification)}} is related.*/
                    }
                }
                part def DataItemRelationship :> AbstractDataItemRelationship {
                    doc /* {{block(AbstractDataItemRelationship)}} that provides a semantic reference to another {{block(DataItem)}} described by {{property(DataItemRelationship::type)}}.*/
                    attribute type [1] : Profile::DataTypes::DataItemRelationshipTypeEnum {
                        doc /* specifies how the {{block(DataItem)}} is related.*/
                    }
                }
                abstract part def AbstractDataItemRelationship {
                    doc /* association between a {{block(DataItem)}} and another entity.*/
                    comment /* Description*/
                    attribute idRef [1] : Profile::DataTypes::ID {
                        doc /* reference to the related entity's `id`.*/
                    }
                    attribute name [0..1] : Profile::DataTypes::string {
                        doc /* descriptive name associated with this {{block(AbstractDataItemRelationship)}}.*/
                    }
                    doc /* {{block(AbstractDataItemRelationship)}} is an abstract entity and hence will be realized by specific {{block(AbstractDataItemRelationship)}} types in an {{block(MTConnectDevices)}} entity. See {{package(Relationship Types for DataItem)}}.*/
                }
                doc /* This section provides semantic information for the types of {{block(AbstractDataItemRelationship)}} that can be defined for a {{block(DataItem)}}.*/
            }
            connection def Filter {
                end hasFilter : Filter => target.hasFilter;
                doc /* **DEPRECATED** in *MTConnect Version 1.4*. Moved to the {{block(Filters)}}. See {{package(Properties of DataItem)}}.*/
                private end : Constraints;
            }
            part def MinimumDeltaFilter :> Filter {
                doc /* {{def(FilterEnum::MINIMUM_DELTA)}}*/
                attribute type [1] :>> type : Profile::DataTypes::FilterEnum default type::MINIMUM_DELTA;
            }
            part def PeriodFilter :> Filter {
                doc /* {{def(FilterEnum::PERIOD)}}*/
                attribute type [1] :>> type : Profile::DataTypes::FilterEnum :> type default type::PERIOD;
                attribute value :>> value : Profile::DataTypes::SECOND;
            }
            doc 
            /* This section provides additional semantic information for the Part Properties of {{block(DataItem)}}.
             *
             * > Note: See {{sect(DataItems Schema Diagrams)}} for XML schema of the elements for {{block(DataItem)}}.*/
        }
        connection def Relationships {
            end hasRelationship : 'Properties of DataItem'::'Relationship Types for DataItem'::AbstractDataItemRelationship => target.hasRelationship;
            doc /* {{block(Relationships)}} groups one or more {{block(DataItemRelationship)}} and {{block(SpecificationRelationship)}}. See {{package(Relationships)}}.*/
            private end : DataItem;
        }
        doc 
        /* This section provides semantic information for the {{block(DataItem)}} entity. {{figure(DataItems)}} shows the {{block(DataItem)}} model. 
         *
         * ![DataItems](figures/DataItems.png "DataItems"){: width="0.8"}
         *
         * > Note: See {{sect(DataItems Schema Diagrams)}} for XML schema.*/
        comment /* DataItems Model*/
        doc 
        /* For an {{block(MTConnectDevices)}} entity, {{termplural(DataItem)}} describe data that can be reported by a piece of equipment and are associated with {{block(Device)}} and {{block(Component)}} entities. While the {{termplural(DataItem)}} describe the data that can be reported by a piece of equipment as an {{block(MTConnectDevices)}} entity, the actual data values are provided by the {{block(MTConnectStreams)}} entity in the {{term(MTConnectStreams Response Document)}}. See {{package(Observation Information Model)}} for detail on the reported values.
         *
         * Each {{term(DataItem)}} **SHOULD** be modeled for the {{block(MTConnectDevices)}} entity such that it is associated with the entity that the reported data directly applies.
         *
         * {{block(DataItem)}} describes specific types of {{termplural(DataItem)}} that represent a numeric value, a functioning state, or a health status reported by a piece of equipment. {{block(DataItem)}} provides a detailed description for each {{term(DataItem)}} that is reported; it defines the type of data being reported and an array of optional attributes that further describe that data. The different types of {{block(DataItem)}} elements are defined in {{package(DataItem Types)}}.*/
    }
    package References {
        abstract part def Reference {
            doc /* pointer to information that is associated with another entity defined elsewhere in the {{block(MTConnectDevices)}} entity for a piece of equipment.*/
            comment /* Description*/
            attribute idRef [1] : Profile::DataTypes::ID {
                doc /* pointer to the `id` of an entity that contains the information to be associated with this entity.*/
            }
            attribute name [0..1] : Profile::DataTypes::string {
                doc /*  name of an element or a piece of equipment.*/
            }
            private attribute dataItemId [1] : Profile::DataTypes::ID {
                doc /* pointer to the {{property(DataItem::id)}} that contains the information to be associated with this entity.*/
            }
            private attribute refDataItemId [1] : Profile::DataTypes::ID {
                doc /* pointer to the {{property(DataItem::id)}} that contains the information to be associated with this entity.*/
            }
            doc /* {{block(Reference)}} is an abstract entity and will be realized by a specific {{block(Reference)}} type for an {{block(MTConnectDevices)}} entity. See {{sect(ComponentRef)}} and {{sect(DataItemRef)}}.*/
        }
        part def DataItemRef :> Reference {
            doc /* {{block(Reference)}} that is a pointer to a {{block(DataItem)}} associated with another entity defined for a piece of equipment.*/
            comment /* Description*/
            private ref part idRef [1] :>> idRef : DataItems::DataItem {
                doc /* pointer to the {{property(DataItem::id)}} that contains the information to be associated with this entity.*/
            }
            doc /* {{block(DataItemRef)}} allows the data associated with a {{block(DataItem)}} defined in another entity to be directly associated with this entity.*/
        }
        part def ComponentRef :> Reference {
            doc /* {{block(Reference)}} that is a pointer to all of the information associated with another entity defined for a piece of equipment.
             */
            comment /* Description*/
            private ref part idRef [1] :>> idRef : Components::Component {
                doc /* pointer to the {{property(Component::id)}} that contains the information to be associated with this entity.*/
            }
            doc /* {{block(ComponentRef)}} allows all of the information of ({{term(lower level)}} {{block(Component)}} entities that is associated with the other entity to be directly associated with this entity.*/
        }
        private connection def {
            end idRef :>> id::idRef : DataItems::DataItem => id.'Device Information Model'::References::DataItemRef::idRef;
            private end id : DataItemRef;
        }
        private connection def {
            end idRef :>> id::idRef : Components::Component => id.'Device Information Model'::References::ComponentRef::idRef;
            private end id : ComponentRef;
        }
        doc 
        /* This section provides semantic information for the {{block(Reference)}} entity. {{figure(References)}} shows the {{block(Reference)}} model. 
         *
         * {{block(Reference)}} may be modeled as part of a {{block(Device)}}, {{block(Component)}} or {{block(Interface)}} type.
         *
         * ![References](figures/References.png "References"){: width="0.8"}
         *
         * > Note: See {{sect(References Schema Diagrams)}} for XML schema of {{block(Reference)}} and its types.*/
        comment /* References Model*/
        doc /* {{block(References)}} {{termplural(organize)}} pointers to information defined elsewhere within the {{block(MTConnectDevices)}} entity for a piece of equipment. It is an efficient method to associate information with an element without duplicating any of the data or structure.*/
    }
    package Configurations {
        package CoordinateSystems {
            part def CoordinateSystem {
                doc /* reference system that associates a unique set of n parameters with each point in an n-dimensional space. {{cite(ISO 10303-218:2004)}}*/
                comment /* Description*/
                attribute id [1] : Profile::DataTypes::ID {
                    doc /* unique identifier for the coordinate system.*/
                }
                attribute name [0..1] : Profile::DataTypes::string {
                    doc /* name of the coordinate system.*/
                }
                attribute nativeName [0..1] : Profile::DataTypes::string {
                    doc /* manufacturer's name or users name for the coordinate system.*/
                }
                attribute parentIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* pointer to the {{property(CoordinateSystem::id)}}.*/
                }
                part hasOrigin [0..1] : AbstractOrigin;
                part hasTransformation [0..1] : 'Device Information Model'::Configurations::CoordinateSystems::Transformation;
                attribute type [1] : Profile::DataTypes::CoordinateSystemTypeEnum {
                    doc /* type of coordinate system.*/
                }
                attribute uuid [0..1] : Profile::DataTypes::UUID {
                    doc /* {{term(UUID)}} for the coordinate system.*/
                }
                attribute Description [0..1] : Profile::DataTypes::string {
                    doc /* natural language description of the {{block(CoordinateSystem)}}.*/
                }
                doc /* At most only one of {{block(Origin)}} or {{block(Transformation)}} **MUST** be defined for a {{block(CoordinateSystem)}}.*/
            }
            connection def Transformation {
                end hasTransformation : 'Device Information Model'::Configurations::CoordinateSystems::Transformation => target.hasTransformation;
                doc /* See {{sect(Transformation)}}.*/
                private end : CoordinateSystem;
            }
            connection def Origin {
                end hasOrigin : AbstractOrigin => target.hasOrigin;
                doc /* See {{sect(Origin)}}.*/
                private end : CoordinateSystem;
            }
            part def Origin :> AbstractOrigin {
                doc /* coordinates of the origin position of a coordinate system.*/
                private attribute value [0..1] : Profile::DataTypes::float3d;
            }
            part def Transformation {
                doc /* process of transforming to the origin position of the coordinate system from a parent coordinate system using {{block(Translation)}} and {{block(Rotation)}}.*/
                comment /* Description*/
                part hasTranslation [0..1] : AbstractTranslation;
                part hasRotation [0..1] : AbstractRotation;
                doc /* At a minimum, a {{block(Translation)}} or a {{block(Rotation)}} **MUST** be defined for a {{block(Transformation)}}.*/
            }
            connection def Rotation {
                end hasRotation : AbstractRotation => target.hasRotation;
                doc /* See {{sect(Rotation)}}.*/
                private end : 'Device Information Model'::Configurations::CoordinateSystems::Transformation;
            }
            connection def Translation {
                end hasTranslation : AbstractTranslation => target.hasTranslation;
                doc /* See {{sect(Translation)}}.*/
                private end : 'Device Information Model'::Configurations::CoordinateSystems::Transformation;
            }
            abstract part def AbstractRotation {
                doc /* rotations about X, Y, and Z axes are expressed in A, B, and C respectively within a 3-dimensional vector. 
                 */
            }
            abstract part def AbstractTranslation {
                doc /* translations along X, Y, and Z axes are expressed as x,y, and z respectively within a 3-dimensional vector. */
            }
            abstract part def AbstractOrigin {
                doc /* coordinates of the origin position of a coordinate system.*/
            }
            part def OriginDataSet :> 'Observation Information Model'::Representations::DataSet, AbstractOrigin {
                doc /* coordinates of the origin position of a coordinate system represented as a dataset.*/
                attribute X [0..1] : Profile::DataTypes::MILLIMETER {
                    doc /* x-coordinate.*/
                }
                attribute Y [0..1] : Profile::DataTypes::MILLIMETER {
                    doc /* y-coordinate.*/
                }
                attribute Z [0..1] : Profile::DataTypes::MILLIMETER {
                    doc /* x-coordinate.*/
                }
            }
            part def Translation :> AbstractTranslation {
                doc /* translations along X, Y, and Z axes are expressed as x,y, and z respectively within a 3-dimensional vector. */
                private attribute value [0..1] : Profile::DataTypes::float3d;
            }
            part def TranslationDataSet :> 'Observation Information Model'::Representations::DataSet, AbstractTranslation {
                doc /* translations along X, Y, and Z axes are expressed as x,y, and z respectively within a 3-dimensional vector represented as a dataset.*/
                attribute X [0..1] : Profile::DataTypes::MILLIMETER {
                    doc /* translation along X axis.*/
                }
                attribute Y [0..1] : Profile::DataTypes::MILLIMETER {
                    doc /* translation along Y axis.*/
                }
                attribute Z [0..1] : Profile::DataTypes::MILLIMETER {
                    doc /* translation along Z axis.*/
                }
            }
            part def RotationDataSet :> 'Observation Information Model'::Representations::DataSet, AbstractRotation {
                doc /* rotations about X, Y, and Z axes are expressed in A, B, and C respectively within a 3-dimensional vector represented as a dataset.
                 */
                attribute A [0..1] : Profile::DataTypes::DEGREE {
                    doc /* rotation about X axis.*/
                }
                attribute B [0..1] : Profile::DataTypes::DEGREE {
                    doc /* rotation about Y axis.*/
                }
                attribute C [0..1] : Profile::DataTypes::DEGREE {
                    doc /* rotation about Z axis.*/
                }
            }
            part def Rotation :> AbstractRotation {
                doc /* rotations about X, Y, and Z axes are expressed in A, B, and C respectively within a 3-dimensional vector. 
                 */
                private attribute value [0..1] : Profile::DataTypes::float3d;
            }
            doc 
            /* This section provides semantic information for the {{block(CoordinateSystem)}} entity.
             *
             * ![CoordinateSystem](figures/CoordinateSystem.png "CoordinateSystem"){: width="0.8"}
             *
             * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.
             *
             * ![CoordinateSystem Example](figures/CoordinateSystem%20Example.png "CoordinateSystem Example"){: width="0.8"}
             *
             * > Note: See {{lst(coordinatesystem-example)}} for the {{term(XML)}} representation of the same example.*/
        }
        package Motion {
            part def Motion {
                doc /* movement of the component relative to a coordinate system. */
                comment /* Description*/
                attribute actuation [1] : Profile::DataTypes::MotionActuationTypeEnum {
                    doc /* describes if this component is actuated directly or indirectly as a result of other motion.*/
                }
                attribute coordinateSystemIdRef [1] : Profile::DataTypes::ID {
                    doc /* coordinate system within which the kinematic motion occurs.*/
                }
                attribute id [1] : Profile::DataTypes::ID {
                    doc /* unique identifier for this element.*/
                }
                attribute parentIdRef [0..1] : Profile::DataTypes::ID {
                    doc 
                    /* pointer to the {{property(Motion::id)}}.
                     *
                     * The kinematic chain connects all components using the parent relations. All motion is connected to the motion of the parent. The first node in the chain will not have a parent.*/
                }
                attribute type [1] : Profile::DataTypes::MotionTypeEnum {
                    doc /* type of motion.*/
                }
                part hasAxis [0..1] : AbstractAxis;
                part hasOrigin [0..1] : CoordinateSystems::AbstractOrigin;
                part hasTransformation [0..1] : CoordinateSystems::Transformation;
                private attribute Description [0..1] : Profile::DataTypes::string {
                    doc /* textual description for {{block(Motion)}}.*/
                }
                doc 
                /* {{block(Motion)}} specifies the kinematic chain of the {{block(component)}} entities.
                 *
                 * At most only one of {{block(Origin)}} or {{block(Transformation)}} **MUST** be defined for a {{block(Motion)}}.*/
            }
            abstract part def AbstractAxis {
                doc /* axis along or around which the {{block(Component)}} moves relative to a coordinate system.*/
            }
            connection def Transformation {
                end hasTransformation : CoordinateSystems::Transformation => target.hasTransformation;
                doc /* See {{sect(Transformation)}}.*/
                private end : Configurations::Motion::Motion;
            }
            connection def Axis {
                end hasAxis : AbstractAxis => target.hasAxis;
                doc /* See {{sect(Axis)}}.*/
                private end : Configurations::Motion::Motion;
            }
            connection def Origin {
                end hasOrigin : CoordinateSystems::AbstractOrigin => target.hasOrigin;
                doc /* See {{sect(Origin)}}.*/
                private end : Configurations::Motion::Motion;
            }
            part def AxisDataSet :> 'Observation Information Model'::Representations::DataSet, AbstractAxis {
                doc /* axis along or around which the {{block(Component)}} moves relative to a coordinate system represented as a dataset.*/
                attribute X [0..1] : Profile::DataTypes::float {
                    doc /* x-component of {{block(Axis)}}.*/
                }
                attribute Y [0..1] : Profile::DataTypes::float {
                    doc /* y-component of {{block(Axis)}}.*/
                }
                attribute Z [0..1] : Profile::DataTypes::float {
                    doc /* z-component of {{block(Axis)}}.*/
                }
            }
            part def Axis :> AbstractAxis {
                doc /* axis along or around which the {{block(Component)}} moves relative to a coordinate system.*/
                private attribute value [0..1] : Profile::DataTypes::float3d;
            }
            doc 
            /* This section provides semantic information for the {{block(Motion)}} entity.
             *
             * ![Motion](figures/Motion.png "Motion"){: width="0.8"}
             *
             * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.
             *
             * ![Motion Example](figures/Motion%20Example.png "Motion Example"){: width="0.8"}
             *
             * > Note: See {{lst(motion-example)}} for the {{term(XML)}} representation of the same example.*/
        }
        package Specifications {
            part def Specification {
                doc /* design characteristics for a piece of equipment.*/
                attribute type [1] : Profile::DataTypes::DataItemTypeEnum {
                    doc /* same as {{property(DataItem::type)}}. See {{package(DataItem Types)}}.*/
                }
                attribute subType [0..1] : Profile::DataTypes::DataItemSubTypeEnum {
                    doc /* same as {{property(DataItem::subType)}}. See {{sect(DataItem)}}.*/
                }
                attribute dataItemIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* reference to the {{property(DataItem::id)}} associated with this entity.*/
                }
                attribute units [0..1] : Profile::DataTypes::UnitEnum {
                    doc /* same as {{property(DataItem::units)}}. See {{sect(DataItem)}}.*/
                }
                attribute compositionIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* reference to the {{property(Composition::id)}} associated with this entity.*/
                }
                attribute name [0..1] : Profile::DataTypes::string {
                    doc /* {{property(Specification::name)}} provides additional meaning and differentiates between {{block(Specification)}} entities.*/
                }
                attribute coordinateSystemIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* references the {{block(CoordinateSystem)}} for geometric {{block(Specification)}} elements.*/
                }
                attribute id [0..1] : Profile::DataTypes::ID {
                    doc /* unique identifier for this {{block(Specification)}}.*/
                }
                attribute originator [1] : Profile::DataTypes::OriginatorEnum default originator::MANUFACTURER {
                    doc /* reference to the creator of the {{block(Specification)}}.*/
                }
                part hasMaximum [0..1] : Maximum;
                part hasUpperLimit [0..1] : 'Device Information Model'::Configurations::Specifications::UpperLimit;
                part hasLowerWarning [0..1] : 'Device Information Model'::Configurations::Specifications::LowerWarning;
                part hasLowerLimit [0..1] : 'Device Information Model'::Configurations::Specifications::LowerLimit;
                part hasUpperWarning [0..1] : 'Device Information Model'::Configurations::Specifications::UpperWarning;
                part hasNominal [0..1] : 'Device Information Model'::Configurations::Specifications::Nominal;
                part hasMinimum [0..1] : Minimum;
            }
            part def ProcessSpecification :> Specification {
                doc /* {{block(Specification)}} that provides information used to assess the conformance of a variable to process requirements.*/
                part hasSpecificationLimits [0..1] : SpecificationLimits;
                part hasControlLimits [0..1] : ControlLimits;
                part hasAlarmLimits [0..1] : AlarmLimits;
            }
            part def ControlLimits {
                doc /* set of limits that is used to indicate whether a process variable is stable and in control.*/
                part upperLimit [0..1] : 'Device Information Model'::Configurations::Specifications::UpperLimit;
                part upperWarning [0..1] : 'Device Information Model'::Configurations::Specifications::UpperWarning;
                part lowerWarning [0..1] : 'Device Information Model'::Configurations::Specifications::LowerWarning;
                part nominal [0..1] : 'Device Information Model'::Configurations::Specifications::Nominal;
                part lowerLimit [0..1] : 'Device Information Model'::Configurations::Specifications::LowerLimit;
            }
            part def AlarmLimits {
                doc /* set of limits that is used to trigger warning or alarm indicators.*/
                part upperLimit [0..1] : 'Device Information Model'::Configurations::Specifications::UpperLimit;
                part upperWarning [0..1] : 'Device Information Model'::Configurations::Specifications::UpperWarning;
                part lowerLimit [0..1] : 'Device Information Model'::Configurations::Specifications::LowerLimit;
                part lowerWarning [0..1] : 'Device Information Model'::Configurations::Specifications::LowerWarning;
            }
            part def SpecificationLimits {
                doc /* set of limits that define a range of values designating acceptable performance for a variable.*/
                part upperLimit [0..1] : 'Device Information Model'::Configurations::Specifications::UpperLimit;
                part nominal [0..1] : 'Device Information Model'::Configurations::Specifications::Nominal;
                part lowerLimit [0..1] : 'Device Information Model'::Configurations::Specifications::LowerLimit;
            }
            connection def Nominal {
                end nominal : 'Device Information Model'::Configurations::Specifications::Nominal => target.nominal;
                end : ControlLimits;
            }
            connection def Nominal {
                end nominal : 'Device Information Model'::Configurations::Specifications::Nominal => target.nominal;
                end : SpecificationLimits;
            }
            connection def UpperLimit {
                end upperLimit : 'Device Information Model'::Configurations::Specifications::UpperLimit => target.upperLimit;
                end : SpecificationLimits;
            }
            connection def LowerLimit {
                end lowerLimit : 'Device Information Model'::Configurations::Specifications::LowerLimit => target.lowerLimit;
                end : AlarmLimits;
            }
            connection def UpperWarning {
                end upperWarning : 'Device Information Model'::Configurations::Specifications::UpperWarning => target.upperWarning;
                end : AlarmLimits;
            }
            connection def LowerLimit {
                end lowerLimit : 'Device Information Model'::Configurations::Specifications::LowerLimit => target.lowerLimit;
                end : ControlLimits;
            }
            connection def LowerLimit {
                end lowerLimit : 'Device Information Model'::Configurations::Specifications::LowerLimit => target.lowerLimit;
                end : SpecificationLimits;
            }
            connection def UpperWarning {
                end upperWarning : 'Device Information Model'::Configurations::Specifications::UpperWarning => target.upperWarning;
                end : ControlLimits;
            }
            connection def LowerWarning {
                end lowerWarning : 'Device Information Model'::Configurations::Specifications::LowerWarning => target.lowerWarning;
                end : AlarmLimits;
            }
            connection def UpperLimit {
                end upperLimit : 'Device Information Model'::Configurations::Specifications::UpperLimit => target.upperLimit;
                end : AlarmLimits;
            }
            connection def LowerWarning {
                end lowerWarning : 'Device Information Model'::Configurations::Specifications::LowerWarning => target.lowerWarning;
                end : ControlLimits;
            }
            connection def UpperLimit {
                end upperLimit : 'Device Information Model'::Configurations::Specifications::UpperLimit => target.upperLimit;
                end : ControlLimits;
            }
            part def UpperWarning {
                doc /* upper boundary indicating increased concern and supervision may be required.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            part def UpperLimit {
                doc 
                /* upper conformance boundary for a variable.
                 *
                 * > Note: immediate concern or action may be required.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            part def Maximum {
                doc /* numeric upper constraint.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            part def LowerLimit {
                doc 
                /* lower conformance boundary for a variable.
                 *
                 * > Note: immediate concern or action may be required.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            part def LowerWarning {
                doc /* lower boundary indicating increased concern and supervision may be required.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            part def Minimum {
                doc /* numeric lower constraint.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            part def Nominal {
                doc /* numeric target or expected value.*/
                attribute value [1] : Profile::DataTypes::float;
            }
            connection def SpecificationLimits {
                end hasSpecificationLimits : SpecificationLimits => target.hasSpecificationLimits;
                doc /* See {{sect(SpecificationLimits)}}.*/
                private end : ProcessSpecification;
            }
            connection def ControlLimits {
                end hasControlLimits : ControlLimits => target.hasControlLimits;
                doc /* See {{sect(ControlLimits)}}.*/
                private end : ProcessSpecification;
            }
            connection def AlarmLimits {
                end hasAlarmLimits : AlarmLimits => target.hasAlarmLimits;
                doc /* See {{sect(AlarmLimits)}}.*/
                private end : ProcessSpecification;
            }
            connection def Maximum {
                end hasMaximum : Maximum => target.hasMaximum;
                private end : Specification;
            }
            connection def UpperLimit {
                end hasUpperLimit : 'Device Information Model'::Configurations::Specifications::UpperLimit => target.hasUpperLimit;
                private end : Specification;
            }
            connection def LowerWarning {
                end hasLowerWarning : 'Device Information Model'::Configurations::Specifications::LowerWarning => target.hasLowerWarning;
                private end : Specification;
            }
            connection def LowerLimit {
                end hasLowerLimit : 'Device Information Model'::Configurations::Specifications::LowerLimit => target.hasLowerLimit;
                private end : Specification;
            }
            connection def UpperWarning {
                end hasUpperWarning : 'Device Information Model'::Configurations::Specifications::UpperWarning => target.hasUpperWarning;
                private end : Specification;
            }
            connection def Nominal {
                end hasNominal : 'Device Information Model'::Configurations::Specifications::Nominal => target.hasNominal;
                private end : Specification;
            }
            connection def Minimum {
                end hasMinimum : Minimum => target.hasMinimum;
                private end : Specification;
            }
            doc 
            /* This section provides semantic information for the {{block(Specification)}} entity.
             *
             * ![Specifications](figures/Specifications.png "Specifications"){: width="0.8"}
             *
             * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.
             *
             * ![Specification Example](figures/Specification%20Example.png "Specification Example"){: width="0.8"}
             *
             * > Note: See {{lst(specification-example)}} for the {{term(XML)}} representation of the same example.*/
        }
        package Sensor {
            connection def Channels {
                end hasChannel : Channel => isChannelOf.hasChannel;
                end isChannelOf : SensorConfiguration => hasChannel.'Device Information Model'::Configurations::Sensor::Channel::isChannelOf;
                doc /* {{block(Channels)}} groups one or more {{block(Channel)}} entities. See {{block(Channel)}}.*/
            }
            part def SensorConfiguration {
                doc /* configuration for a {{block(Sensor)}}.*/
                comment /* Description*/
                attribute CalibrationDate [0..1] : Profile::DataTypes::datetime {
                    doc /* Date upon which the {{term(sensor unit)}} was last calibrated.*/
                }
                attribute CalibrationInitials [0..1] : Profile::DataTypes::string {
                    doc /* The initials of the person verifying the validity of the calibration data.*/
                }
                attribute FirmwareVersion [1] : Profile::DataTypes::string {
                    doc /* Version number for the sensor unit as specified by the manufacturer.*/
                }
                attribute NextCalibrationDate [0..1] : Profile::DataTypes::datetime {
                    doc /* Date upon which the {{term(sensor unit)}} is next scheduled to be calibrated.*/
                }
                part hasChannel [0..*] : Channel;
                doc 
                /* ![SensorConfiguration](figures/SensorConfiguration.png "SensorConfiguration"){: width="0.8"}
                 *
                 * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.*/
            }
            part def Channel {
                doc /* {{term(sensing element)}} of a {{block(Sensor)}}.*/
                comment /* Description*/
                attribute CalibrationDate [0..1] : Profile::DataTypes::datetime {
                    doc /* Date upon which the {{term(sensor unit)}} was last calibrated to the {{term(sensor element)}}.*/
                }
                attribute CalibrationInitials [0..1] : Profile::DataTypes::string {
                    doc /* The initials of the person verifying the validity of the calibration data.*/
                }
                attribute name [0..1] : Profile::DataTypes::string {
                    doc /* name of the specific {{term(sensing element)}}.*/
                }
                attribute NextCalibrationDate [0..1] : Profile::DataTypes::datetime {
                    doc /* Date upon which the {{term(sensor element)}} is next scheduled to be calibrated with the {{term(sensor unit)}}.*/
                }
                attribute number [1] : Profile::DataTypes::string {
                    doc /* unique identifier that will only refer to a specific {{term(sensing element)}}.*/
                }
                private ref part isChannelOf : SensorConfiguration;
                private attribute Description [0..1] : Profile::DataTypes::string {
                    doc /* textual description for {{block(Channel)}}.*/
                }
                doc /* When {{block(Sensor)}} has multiple {{termplural(sensing element)}}, each {{term(sensing element)}} is modeled as a {{block(Channel)}} for the {{block(Sensor)}}. */
            }
            doc 
            /* This section provides semantic information for the {{block(SensorConfiguration)}} entity.
             *
             * {{term(sensor)}} is a unique type of a piece of equipment.  A {{term(sensor)}} is typically comprised of two major components: a {{term(sensor unit)}} that provides signal processing, conversion, and communications and the {{termplural(sensing element)}} that provides a signal or measured value.
             *
             * The {{term(sensor unit)}} is modeled as a {{term(lower level)}} {{block(Component)}} called {{block(Sensor)}}.  The {{term(sensing element)}} may be modeled as a {{block(Composition)}} element of a {{block(Sensor)}} element and the measured value would be modeled as a {{block(DataItem)}} (See {{sect(DataItems)}} for more information on {{block(DataItem)}} elements).  Each {{term(sensor unit)}} may have multiple {{termplural(sensing element)}}; each representing the data for a variety of measured values.
             *
             * ![Sensing Element provided as a DataItem Example](figures/Sensing%20Element%20provided%20as%20a%20DataItem%20Example.png "Sensing Element provided as a DataItem Example"){: width="0.8"}
             *
             * > Note: See {{lst(example-of-sensing-element-provided-as-data-item-associated-with-a-component)}} for an {{term(XML)}} example.
             *
             * When a {{term(sensor unit)}} is modeled as a {{block(Component)}} or as a separate piece of equipment, it may provide additional configuration information for the {{termplural(sensor element)}} and the {{term(sensor unit)}} itself.  
             *
             * ![Sensor for Rotary Axis Example](figures/Sensor%20for%20Rotary%20Axis%20Example.png "Sensor for Rotary Axis Example"){: width="0.8"}
             *
             * > Note: If a {{block(Sensor)}} provides vibration measurement data for the spindle on a piece of equipment, it could be modeled as a {{block(Sensor)}} for rotary axis named `C`. See {{lst(example-of-sensor-for-rotary-axis)}} for an {{term(XML)}} example.
             *
             * ![Sensor unit with Sensing Elements Example](figures/Sensor%20unit%20with%20Sensing%20Elements%20Example.png "Sensor unit with Sensing Elements Example"){: width="0.8"}
             *
             * > Note: If a {{block(Sensor)}} provides measurement data for multiple {{block(Component)}} elements within a piece of equipment and is not associated with any particular {{block(Component)}}, it **MAY** be modeled as an independent {{block(Component)}} and the data associated with measurements are associated with their associated {{block(Component)}} entities. See {{lst(example-of-sensor-unit-with-sensing-element)}} for an {{term(XML)}} example.
             *
             * {{block(Configuration)}} data provides information required for maintenance and support of the sensor.
             *
             * When {{block(Sensor)}} represents the {{term(sensor unit)}} for multiple {{term(sensing element)}}(s), each sensing element is represented by a {{block(Channel)}}.   The {{term(sensor unit)}} itself and each {{block(Channel)}} representing one {{term(sensing element)}} **MAY** have its own configuration data.
             *
             * ![Sensor Configuration Example](figures/Sensor%20Configuration%20Example.png "Sensor Configuration Example"){: width="0.8"}
             *
             * > Note: See {{lst(example-of-configuration-data-for-sensor)}} for an {{term(XML)}} example.
             */
        }
        package Relationships {
            abstract part def ConfigurationRelationship {
                doc /* association between two pieces of equipment or assets that may function independently but together perform a manufacturing operation.*/
                comment /* Description*/
                attribute name [0..1] : Profile::DataTypes::string {
                    doc /* name associated with this {{block(ConfigurationRelationship)}}.*/
                }
                attribute id [1] : Profile::DataTypes::ID {
                    doc /* unique identifier for this {{block(ConfigurationRelationship)}}.*/
                }
                attribute type [1] : Profile::DataTypes::RelationshipTypeEnum {
                    doc /* defines the authority that this piece of equipment has relative to the associated piece of equipment.*/
                }
                attribute criticality [0..1] : Profile::DataTypes::CriticalityTypeEnum {
                    doc /* defines whether the services or functions provided by the associated piece of equipment is required for the operation of this piece of equipment.*/
                }
                doc /* {{block(ConfigurationRelationship)}} is an abstract entity and hence will be realized by specific {{block(ConfigurationRelationship)}} types in an {{block(MTConnectDevices)}} entity. See {{sect(ComponentRelationship)}} and {{sect(DeviceRelationship)}}.*/
            }
            part def ComponentRelationship :> ConfigurationRelationship {
                doc /* {{block(ConfigurationRelationship)}} that describes the association between a {{block(Component)}} or an {{block(Asset)}} and another {{block(Component)}}.*/
                attribute idRef [1] : Profile::DataTypes::ID {
                    doc /* reference to the associated {{block(Component)}}.*/
                }
            }
            part def DeviceRelationship :> ConfigurationRelationship {
                doc /* {{block(ConfigurationRelationship)}} that describes the association between a {{block(Component)}} or an {{block(Asset)}} and a {{block(Device)}}.*/
                attribute deviceUuidRef [1] : Profile::DataTypes::UUID {
                    doc /* reference to the {{property(Device::uuid)}} of the associated piece of equipment.*/
                }
                attribute href [0..1] : Profile::DataTypes::xlinkhref {
                    doc /* {{term(URI)}} identifying the {{term(agent)}} that is publishing information for the associated piece of equipment. */
                    comment /* Description*/
                    doc 
                    /* {{property(DeviceRelationship::href)}} **MUST** also include the {{property(Device::uuid)}} for that specific piece of equipment.
                     *
                     * {{property(href)}} is of type `xlink:href` from the W3C XLink specification: {{cite(https://www.w3.org/TR/xlink11/)}}.*/
                }
                attribute role [0..1] : Profile::DataTypes::RoleTypeEnum {
                    doc /* defines the services or capabilities that the referenced piece of equipment provides relative to this piece of equipment.*/
                }
                attribute 'xlink:type' [0..1] : Profile::DataTypes::xlinktype {
                    doc /* `xlink:type`**MUST** have a fixed value of `locator` as defined in W3C XLink 1.1 {{cite(https://www.w3.org/TR/xlink11/)}}.*/
                    comment /* Description*/
                    doc /* If the {{property(DeviceRelationship::href)}} is provided, it **MUST** conform to the {{term(URI)}} syntactic rules as defined in IETF RFC 3986 for Uniform Resource Identifiers. {{cite(https://www.ietf.org/rfc/rfc3986.txt)}}*/
                }
            }
            part def AssetRelationship :> ConfigurationRelationship {
                doc /* {{block(ConfigurationRelationship)}} that describes the association between a {{block(Component)}} or an {{block(Asset)}} and another {{block(Asset)}}.*/
                attribute assetIdRef [1] : Profile::DataTypes::ID {
                    doc /* uuid of the related {{block(Asset)}}.*/
                }
                attribute assetType [1] : Profile::DataTypes::string {
                    doc /* type of {{block(Asset)}} being referenced.*/
                }
                attribute href [0..1] : Profile::DataTypes::xlinkhref {
                    doc /* {{term(URI)}} reference to the associated {{block(Asset)}}.*/
                    comment /* Description*/
                    doc 
                    /* {{property(AssetRelationship::href)}} **MUST** also include the {{property(Device::uuid)}} for that specific piece of equipment.
                     *
                     * {{property(AssetRelationship::href)}} is of type `xlink:href` from the W3C XLink specification: {{cite(https://www.w3.org/TR/xlink11/)}}.*/
                }
            }
            doc 
            /* This section provides semantic information for the {{block(ConfigurationRelationship)}} entity.
             *
             * ![Relationships](figures/Relationships.png "Relationships"){: width="0.8"}
             *
             * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.
             *
             * ![Relationship Example](figures/Relationship%20Example.png "Relationship Example"){: width="0.8"}
             *
             * > Note: See {{lst(relationship-example)}} for the {{term(XML)}} representation of the same example.*/
        }
        part def Configuration :> Glossary::'MTConnect Terms'::Configuration {
            doc /* technical information about an entity describing its physical layout, functional characteristics, and relationships with other entities.*/
            private ref part isConfigurationFor : Components::Component;
            part hasSolidModel [0..1] : SolidModel::SolidModel;
            part hasSensorConfiguration [0..1] : Sensor::SensorConfiguration;
            part hasMotion [0..1] : Motion::Motion;
            part hasRelationship [0..*] : Relationships::ConfigurationRelationship;
            part hasCoordinateSystem [0..*] : CoordinateSystems::CoordinateSystem;
            part hasSpecification [0..*] : Specifications::Specification;
            private ref part isConfigurationFor : Compositions::Composition;
            part hasImageFile [0..*] : 'Device Information Model'::Configurations::ImageFiles::ImageFile;
            part hasPowerSource [0..*] : 'Device Information Model'::Configurations::PowerSources::PowerSource;
        }
        package SolidModel {
            part def SolidModel {
                doc /* references to a file with the three-dimensional geometry of the {{block(Component)}} or {{block(Composition)}}.*/
                comment /* Description*/
                attribute id [1] : Profile::DataTypes::ID {
                    doc /* unique identifier for this element.*/
                }
                part hasTransformation [0..1] : CoordinateSystems::Transformation;
                part hasScale [0..1] : AbstractScale;
                attribute solidModelIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* associated model file if an item reference is used.*/
                }
                attribute href [0..1] : Profile::DataTypes::string {
                    doc 
                    /* {{term(URL)}} giving the location of the {{block(SolidModel)}}. 
                     *
                     * If not present, the model referenced in the {{property(SolidModel::solidModelIdRef)}} is used.
                     *
                     * {{property(SolidModel::href)}} is of type `xlink:href` from the W3C XLink specification.*/
                }
                attribute itemRef [0..1] : Profile::DataTypes::string {
                    doc 
                    /* reference to the item within the model within the related geometry. A {{property(SolidModel::solidModelIdRef)}} **MUST** be given. 
                     *
                     * > Note: `Item` defined in ASME Y14.100 - A nonspecific term used to denote any unit or product, including materials, parts, assemblies, equipment, accessories, and computer software.*/
                }
                attribute mediaType [1] : Profile::DataTypes::MediaTypeEnum {
                    doc /* format of the referenced document.*/
                }
                attribute coordinateSystemIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* reference to the coordinate system for this {{block(SolidModel)}}.*/
                }
                attribute nativeUnits [0..1] : Profile::DataTypes::NativeUnitEnum {
                    doc /* same as {{property(DataItem::nativeUnits)}}. See {{sect(DataItem)}}.*/
                }
                attribute units [0..1] : Profile::DataTypes::UnitEnum {
                    doc /* same as {{property(DataItem::units)}}. See {{sect(DataItem)}}.*/
                }
                doc 
                /* The geometry **MAY** have a transformation and a scale to position the {{block(Component)}} with respect to the other {{block(Component)}}s. A geometry file can contain a set of assembled items, in this case, the {{block(SolidModel)}} references the {{property(SolidModel::id)}} of the assembly model file and the specific item within that file.
                 *
                 * The {{block(SolidModel)}} **MAY** provide a translation, rotation, and scale to correctly place it relative to the other geometries in the machine. If the {{block(Component)}} can move and has a {{block(Motion)}} {{block(Configuration)}}, the {{block(SolidModel)}} will move when the {{block(Component)}} or {{block(Composition)}} moves.
                 *
                 * Either an {{property(SolidModel::href)}} or a {{property(SolidModel::modelIdRef)}} and an {{property(SolidModel::itemRef)}} **MUST** be specified.*/
            }
            connection def Transformation {
                end hasTransformation : CoordinateSystems::Transformation => target.hasTransformation;
                doc /* See {{sect(Transformation)}}.*/
                end : Configurations::SolidModel::SolidModel;
            }
            abstract part def AbstractScale {
                doc /* either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the {{block(SolidModel)}}.*/
            }
            connection def Scale {
                end hasScale : AbstractScale => target.hasScale;
                doc /* See {{sect(Scale)}}.*/
                end : Configurations::SolidModel::SolidModel;
            }
            part def ScaleDataSet :> 'Observation Information Model'::Representations::DataSet, AbstractScale {
                doc /* either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the {{block(SolidModel)}} represented as a dataset.*/
                attribute X [0..1] : Profile::DataTypes::float {
                    doc /* multiplier for X axis.*/
                }
                attribute Y [0..1] : Profile::DataTypes::float {
                    doc /* multiplier for Y axis.*/
                }
                attribute Z [0..1] : Profile::DataTypes::float {
                    doc /* multiplier for Z axis.*/
                }
            }
            part def Scale :> AbstractScale {
                doc /* either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the {{block(SolidModel)}}.*/
                private attribute value [0..1] : Profile::DataTypes::float3d;
            }
            doc 
            /* This section provides semantic information for the {{block(SolidModel)}} entity.
             *
             * ![SolidModel](figures/SolidModel.png "SolidModel"){: width="0.8"}
             *
             * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.
             *
             * ![SolidModel Example](figures/SolidModel%20Example.png "SolidModel Example"){: width="0.8"}
             *
             * > Note: See {{lst(solidmodel-example)}} for the {{term(XML)}} representation of the same example.*/
        }
        connection def SolidModel {
            end hasSolidModel : SolidModel::SolidModel => target.hasSolidModel;
            doc /* See {{sect(SolidModel)}}.*/
            private end : Configuration;
        }
        connection def SensorConfiguration {
            end hasSensorConfiguration : Sensor::SensorConfiguration => target.hasSensorConfiguration;
            doc /* See {{block(SensorConfiguration)}}.*/
            private end : Configuration;
        }
        connection def Motion {
            end hasMotion : Motion::Motion => target.hasMotion;
            doc /* See {{sect(Motion)}}.*/
            private end : Configuration;
        }
        connection def Relationships {
            end hasRelationship : Relationships::ConfigurationRelationship => target.hasRelationship;
            doc /* {{block(Relationships)}} groups one or more {{block(ConfigurationRelationship)}} types. See {{package(Relationships)}}.*/
            private end : Configuration;
        }
        connection def CoordinateSystems {
            end hasCoordinateSystem : CoordinateSystems::CoordinateSystem => target.hasCoordinateSystem;
            doc /* {{block(CoordinateSystems)}} groups one or more {{block(CoordinateSystem)}} entities. See {{package(CoordinateSystems)}}.*/
            private end : Configuration;
        }
        connection def Specifications {
            end hasSpecification : Specifications::Specification => target.hasSpecification;
            doc /* {{block(Specifications)}} groups one or more {{block(Specification)}} entities. See {{package(Specifications)}}.*/
            private end : Configuration;
        }
        connection def ImageFiles {
            end hasImageFile : 'Device Information Model'::Configurations::ImageFiles::ImageFile => target.hasImageFile;
            doc /* {{block(ImageFiles)}} groups one or more {{block(ImageFile)}} entities. See {{package(ImageFiles)}}.*/
            private end : Configuration;
        }
        package ImageFiles {
            part def ImageFile {
                doc /* reference to a file containing an image of the {{block(Component)}}.*/
                attribute id [1] : Profile::DataTypes::ID {
                    doc /* unique identifier of the image file.*/
                }
                attribute href [1] : Profile::DataTypes::string {
                    doc /* {{term(URL)}} giving the location of the image file.*/
                }
                attribute mediaType [1] : Profile::DataTypes::string {
                    doc /* mime type of the image file.*/
                }
                attribute name [0..1] : Profile::DataTypes::string {
                    doc /* description of the image file.*/
                }
            }
            doc /* This section provides semantic information for the {{block(ImageFile)}} entity.*/
        }
        connection def PowerSources {
            end hasPowerSource : 'Device Information Model'::Configurations::PowerSources::PowerSource => target.hasPowerSource;
            doc /* {{block(PowerSources)}} groups one or more {{block(PowerSource)}} entities. See {{package(PowerSources)}}.*/
            private end : Configuration;
        }
        package PowerSources {
            part def PowerSource {
                doc /* potential energy sources for the {{block(Component)}}.*/
                attribute type [1] : Profile::DataTypes::PowerSourceTypeEnum {
                    doc /* type of the power source.*/
                }
                attribute id [1] : Profile::DataTypes::ID {
                    doc /* unique identifier for the power source.*/
                }
                attribute componentIdRef [0..1] : Profile::DataTypes::ID {
                    doc /* reference to the {{block(Component)}} providing observations about the power source.*/
                }
                attribute order [0..1] : Profile::DataTypes::integer {
                    doc /* optional precedence for a given power source.*/
                }
                attribute value [1] : Profile::DataTypes::string {
                    doc /* name of the power source.*/
                }
            }
            doc 
            /* This section provides semantic information for the {{block(PowerSource)}} entity.
             *
             * ![PowerSources](figures/PowerSources.png "PowerSources"){: width="0.8"}
             *
             */
        }
        doc 
        /* {{figure(Configuration)}} shows the abstract {{block(Configuration)}} and its types.
         *
         * ![Configuration](figures/Configuration.png "Configuration"){: width="0.8"}
         *
         * > Note: See {{sect(Configuration Schema Diagrams)}} for XML schema.*/
        comment /* Configurations Model*/
        doc /* This section provides semantic information for the {{block(Configuration)}} entity that is used to model technical information about a {{block(Component)}}. */
    }
    part def Device :> Components::Component, Glossary::'MTConnect Terms'::Device {
        doc /* {{block(Component)}} composed of a piece of equipment that produces {{termplural(observation)}} about itself.*/
        comment /* Description*/
        part hasAuxiliary [0..*] : Components::'Component Types'::Auxiliary;
        part hasController [0..*] : Components::'Component Types'::Controller;
        part hasInterface [0..*] : 'Interface Interaction Model'::Interface;
        part hasResource [0..*] : Components::'Component Types'::Resource;
        part hasStructure [0..*] : Components::'Component Types'::Structure;
        attribute iso841Class [0..1] : Profile::DataTypes::string {
            doc /* **DEPRECATED** in *MTConnect Version 1.2*.*/
        }
        attribute uuid [1] :>> uuid : Profile::DataTypes::UUID {
            doc /* universally unique identifier for the element.*/
        }
        attribute mtconnectVersion [0..1] : Profile::DataTypes::string {
            doc /* MTConnect version of the {{term(Device Information Model)}} used to configure the information to be published for a piece of equipment in an {{term(MTConnect Response Document)}}.*/
        }
        part hasSystem [0..*] : Components::'Component Types'::System;
        attribute name [1] :>> name : Profile::DataTypes::string {
            doc /* name of an element or a piece of equipment.*/
        }
        private part hasPart [0..*] : Components::'Component Types'::Part;
        private part hasProcess [0..*] : Components::'Component Types'::Process;
        part hasAxis [0..*] : Components::'Component Types'::Axis;
        part hasAdapter [0..*] : Components::'Component Types'::Adapter;
        part observesAvailability [1] : 'Observation Information Model'::'Observation Types'::'Event Types'::Availability;
        part observesAssetChanged [1] : 'Observation Information Model'::'Observation Types'::'Event Types'::AssetChanged;
        part observesAssetRemoved [1] : 'Observation Information Model'::'Observation Types'::'Event Types'::AssetRemoved;
        attribute hash [0..1] : Profile::DataTypes::string {
            doc /* condensed message digest from a secure one-way hash function. {{cite(FIPS PUB 180-4)}}*/
        }
        state def Device {
            state INACTIVE;
            state COMMITTED;
            state PREPARING;
        }
        doc 
        /* A {{block(Device)}} {{termplural(organize)}} its parts as {{block(Component)}} entities.
         *
         * A {{block(Device)}} **MUST** have a {{property(Device::name)}} and {{property(Device::uuid)}} to identify itself. 
         *
         * A {{block(Device)}} **MUST** have the following {{block(DataItems)}}: {{block(Availability)}}, {{block(AssetChanged)}}, and {{block(AssetRemoved)}}.
         *
         * See {{package(Components)}} for more details on the properties of {{block(Device)}}.
         *
         * > See {{sect(Part Properties of Device)}} for a list of {{term(top level)}} {{block(Component)}} types for a {{block(Device)}}.
         */
        exhibit state : Device;
    }
    connection def {
        end observesAvailability : 'Observation Information Model'::'Observation Types'::'Event Types'::Availability => target.observesAvailability;
        private end : Device;
    }
    connection def {
        end observesAssetChanged : 'Observation Information Model'::'Observation Types'::'Event Types'::AssetChanged => target.observesAssetChanged;
        private end : Device;
    }
    connection def {
        end observesAssetRemoved : 'Observation Information Model'::'Observation Types'::'Event Types'::AssetRemoved => target.observesAssetRemoved;
        private end : Device;
    }
    doc 
    /* The {{term(Device Information Model)}} provides a representation of the physical and logical configuration for a piece of equipment used for a manufacturing process or for any other purpose.  It also provides the definition of data that may be reported by that equipment. 
     *
     * Using information defined in the {{term(Device Information Model)}}, a software application can determine the configuration and reporting capabilities of a piece of equipment.  To do this, the software application issues a {{term(probe request)}} (defined in {{package(Fundamentals)}}) to an {{term(agent)}} associated with a piece of equipment. An {{term(agent)}} responds to the {{term(probe request)}} with an {{term(MTConnectDevices Response Document)}} that contains information describing both the physical and logical structure of the piece of equipment and a detailed description of each {{term(Observation)}} that can be reported by the {{term(agent)}} associated with the piece of equipment. This information allows the client software application to interpret the document and to extract the data with the same meaning, value, and context that it had at its original source.  
     *
     * The {{term(MTConnectDevices Response Document)}} is comprised of two sections: {{block(Header)}} and {{block(Devices)}}.
     *
     * The {{block(Header)}} section contains protocol related information as defined in {{package(Fundamentals)}}.
     *
     * The {{block(Devices)}} section of the {{term(MTConnectDevices Response Document)}} contains a {{block(Device)}} entity for each piece of equipment described in the document.  Each {{block(Device)}} is comprised of two primary types of entities - {{termplural(Component)}} and {{termplural(DataItem)}}.  
     *
     * {{termplural(Component)}} organize information that represents the physical and logical parts and sub-parts of a piece of equipment (See {{package(Components)}} for more details).  
     *
     * {{termplural(DataItem)}} describe data that can be reported by a piece of equipment.  In the {{term(Device Information Model)}}, {{termplural(DataItem)}} are defined as {{block(DataItem)}} entities (See {{package(DataItem Types)}}).
     *
     * The {{termplural(Component)}} and {{termplural(DataItem)}} in the {{term(MTConnectDevices Response Document)}} provide information representing the physical and logical structure for a piece of equipment and the types of data that the piece of equipment can report relative to that structure.   The {{term(MTConnectDevices Response Document)}} does not contain values for the data types reported by the piece of equipment.  The {{term(MTConnectStreams Response Document)}} defined in {{package(Observation Information Model)}} provides the data values that are reported by the piece of equipment.
     *
     * > Note:  The MTConnect Standard also defines the information model for {{termplural(asset)}}.  An {{term(asset)}} is something that is used in the manufacturing process, but is not permanently associated with a single piece of equipment, can be removed from the piece of equipment without compromising its function, and can be associated with other pieces of equipment during its lifecycle.  See {{package(Asset Information Model)}} for more details on {{termplural(asset)}}.
     */
    comment /* Devices Appendix*/
    doc 
    /* {{newpage()}} 
     *
     * ## XML Schema Diagrams
     *
     * See XML schemas for the MTConnect standard here: {{url(https://schemas.mtconnect.org/)}}.
     *
     * ### Components Schema Diagrams
     *
     * See `Components` element in `MTConnectDevices` schema.
     *
     * See `Description` element in `MTConnectDevices` schema.
     *
     * ### DataItems Schema Diagrams
     *
     * See `DataItems` element in `MTConnectDevices` schema.
     *
     * See `Source` element in `MTConnectDevices` schema.
     *
     * See `Constraints` element in `MTConnectDevices` schema.
     *
     * See `Filter` element in `MTConnectDevices` schema.
     *
     * See `Definition` element in `MTConnectDevices` schema.
     *
     * ### References Schema Diagrams
     *
     * See `References` element in `MTConnectDevices` schema.
     *
     * See `ComponentRef` element in `MTConnectDevices` schema.
     *
     * See `DataItemRef` element in `MTConnectDevices` schema.
     *
     * ### Configuration Schema Diagrams
     *
     * See `Configuration` element in `MTConnectDevices` schema.
     *
     * See `CoordinateSystem` element in `MTConnectDevices` schema.
     *
     * See `Motion` element in `MTConnectDevices` schema.
     *
     * See `Relationships` element in `MTConnectDevices` schema.
     *
     * See `ComponentRelationship` element in `MTConnectDevices` schema.
     *
     * See `DeviceRelationship` element in `MTConnectDevices` schema.
     *
     * See `SensorConfiguration` element in `MTConnectDevices` schema.
     *
     * See `SolidModel` element in `MTConnectDevices` schema.
     *
     * See `Specifications` element in `MTConnectDevices` schema.
     *
     * See `ProcessSpecification` element in `MTConnectDevices` schema.
     *
     * ## XML Examples
     *
     * ### Device Entity Hierarchy Example
     *
     * ~~~~xml
     * <Devices>
     *   <Device id="d1" name="M12346" uuid="M80104K162N">
     *     <Components>
     *     <Axes id="a" name="base">
     *     <Components>
     *       <Linear id="x" name="X"/>
     *       <Linear id="y" name="Y"/>
     *       <Linear id="z" name="Z"/>
     *       <Rotary id="ar" name="B"/>
     *       <Linear id="w" name="Z3" nativeName="W"/>
     *       <Rotary id="c" name="C"/>
     *     </Components>
     *     </Axes>
     *     <Controller id="cont" name="controller">
     *     <Components>
     *       <Path id="path1" name="path"/>
     *     </Components>
     *     </Controller>
     *     <Door id="door1" name="door"/>
     *     <Systems id="systems" name="systems">
     *     <Components>
     *       <WorkEnvelope id="we1" name="workenv">
     *       <Compositions>
     *         <Composition type="WORKPIECE" id="wp"/>
     *         <Composition type="TABLE" id="tbl"/>
     *       </Compositions>
     *       </WorkEnvelope>
     *       <Electric id="elec" name="electric"/>
     *       <Hydraulic id="hydraulic" name="hydraulic"/>
     *       <Coolant id="coolant" name="coolant"/>
     *       <Pneumatic id="pneumatic" name="pneumatic"/>
     *       <Lubrication id="lubrication" name="lubrication"/>
     *     </Components>
     *     </Systems>
     *     <Auxiliaries id="Aux" name="auxiliaries">
     *     <Components>
     *       <Environmental id="room" name="environmental"/>
     *     </Components>
     *     </Auxiliaries>
     *     <Resources id="resources" name="resources">
     *     <Components>
     *       <Personnel id="personnel" name="personnel"/>
     *       <Materials id="materials" name="materials">
     *       <Components>
     *         <Stock id="procstock" name="stock"/>
     *       </Components>
     *       <Materials/>
     *     </Components> 
     *     </Resources>
     *     </Components>
     *   </Device>
     * </Devices>
     * ~~~~
     * {: caption="Device Entity Hierarchy Example"}
     *
     * ### Component Example
     *
     * ~~~~xml
     * <Devices>
     *   <Device id="d1" name="M12346" uuid="M80104K162N">
     *     <Description manufacturer="Example_Corporation" 
     *       serialNumber="272237"> Mill w/SMooth-G
     *     </Description>
     *   <DataItems>
     *     <DataItem category="EVENT" id="avail" name="avail" type="AVAILABILITY"/>
     *     <DataItem category="EVENT" id="d1_asset_chg" name="asset_chg" type="ASSET_CHANGED"/>
     *     <DataItem category="EVENT" id="d1_asset_rem" name="asset_rem" type="ASSET_REMOVED"/>
     *   </DataItems>
     *     <Components>
     *     <Controller id="cont" name="controller">
     *       <DataItems>
     *       <DataItem category="EVENT" id="estop" name="estop" type="EMERGENCY_STOP"/>
     *       <DataItem category="CONDITION" id="logic_cond" type="LOGIC_PROGRAM"/>
     *       <DataItem category="CONDITION" id="cont_system" type="SYSTEM"/>
     *       <DataItem category="SAMPLE" id="cut_time" type="ACCUMULATED_TIME" units="SECOND"/>
     *     </DataItems>
     *     <Components>
     *       <Path id="path1" name="path">
     *         <DataItems>
     *         <DataItem category="EVENT" id="execution" name="execution" type="EXECUTION"/>
     *         <DataItem category="SAMPLE" id="cspeed" subType="ACTUAL" type="CUTTING_SPEED" units="MILLIMETER/SECOND"/>
     *         <DataItem category="CONDITION" id="path_system" type="SYSTEM"/>
     *         <DataItem category="EVENT" id="cvars" representation="DATA_SET" type="VARIABLE"/>
     *         <DataItem category="EVENT" id="woffset" representation="TABLE" type="WORK_OFFSET"/>
     *       </DataItems>
     *       </Path>
     *     </Components>
     *     </Controller>
     *   </Components>
     *   </Device>
     * </Devices>
     * ~~~~
     * {: caption="Component Example"}
     *
     * ### Component with Compositions Example
     *
     * In {{term(XML)}}, `Composition` types are represented differently than `Component` types. For `Component` types, the element name is Pascal Case of the `Component` type name. Whereas, the element name for all `Composition`types is `Composition` and the type is defined by the `type` attribute of the element (see example below).
     *
     * ~~~~xml
     * <WorkEnvelope id="we1" name="workenv">
     *   <DataItems>
     *     <DataItem category="CONDITION" id="hardware1" name="hardware1" type="HARDWARE"/>
     *   </DataItems>
     *   <Compositions>
     *   <Composition type="WORKPIECE" id="wp"/>
     *   <Composition type="TABLE" id="tbl"/>
     *   </Compositions>
     * </WorkEnvelope>
     * ~~~~
     * {: caption="Component with Compositions Example"}
     *
     * ### CoordinateSystem Example
     *
     * ~~~~xml
     * <Devices>
     *   <Device id="d1" name="M12346" uuid="M80104K162N">
     *     <Description manufacturer="Example_Corporation" 
     *       serialNumber="272237"> Mill w/SMooth-G
     *     </Description>
     *     <DataItems>
     *       <DataItem id="avail" type="AVAILABILITY" category="EVENT"/>
     *       <DataItem category="EVENT" id="d1_asset_chg" name="asset_chg" type="ASSET_CHANGED"/>
     *       <DataItem category="EVENT" id="d1_asset_rem" name="asset_rem" type="ASSET_REMOVED"/>
     *     </DataItems>
     *     <Configuration>
     *       <CoordinateSystems>
     *         <CoordinateSystem id="base" type="BASE">
     *           <Origin>0 0 0</Origin>
     *         </CoordinateSystem>
     *         <CoordinateSystem id="machcoord" type="MACHINE" parentIdRef="base">
     *           <Transformation>
     *             <Translation>210 275 1430</Translation>
     *             <Rotation>0 0 0</Rotation>
     *           </Transformation>
     *         </CoordinateSystem>
     *         <CoordinateSystem id="workcoord" type="OBJECT" parentIdRef="machcoord">
     *           <Transformation>
     *             <Translation>0 0 0</Translation>
     *             <Rotation>0 0 0</Rotation>
     *           </Transformation>
     *         </CoordinateSystem>
     *       </CoordinateSystems>
     *     </Configuration>
     *   </Device>
     * </Devices>
     * ~~~~
     * {: caption="CoordinateSystem Example"}
     *
     * ### Motion Example
     *
     * ~~~~xml
     * <Devices>
     *   <Device id="d1" name="M12346" uuid="M80104K162N">
     *     <Description manufacturer="Example_Corporation" 
     *       serialNumber="272237"> Mill w/SMooth-G
     *     </Description>
     *     <DataItems>
     *       <DataItem id="avail" type="AVAILABILITY" category="EVENT"/>
     *       <DataItem category="EVENT" id="d1_asset_chg" name="asset_chg" type="ASSET_CHANGED"/>
     *       <DataItem category="EVENT" id="d1_asset_rem" name="asset_rem" type="ASSET_REMOVED"/>
     *     </DataItems>
     *     <Configuration>
     *       <CoordinateSystems>
     *         <CoordinateSystem id="base" type="BASE">
     *           <Origin>0 0 0</Origin>
     *         </CoordinateSystem>
     *         <CoordinateSystem id="machcoord" type="MACHINE" parentIdRef="base">
     *           <Transformation>
     *             <Translation>210 275 1430</Translation>
     *             <Rotation>0 0 0</Rotation>
     *           </Transformation>
     *         </CoordinateSystem>
     *         <CoordinateSystem id="workcoord" type="OBJECT" parentIdRef="machcoord">
     *           <Transformation>
     *             <Translation>0 0 0</Translation>
     *             <Rotation>0 0 0</Rotation>
     *           </Transformation>
     *         </CoordinateSystem>
     *       </CoordinateSystems>
     *     </Configuration>
     *     <Components>
     *       <Axes id="a" name="base">
     *         <Components>
     *           <Linear id="x" name="X">
     *             <Configuration>
     *               <Motion id="xmotion" coordinateSystemIdRef="machcoord" type="PRISMATIC" actuation="DIRECT">
     *                 <Transformation>
     *                   <Translaton>300 915 590</Translaton>
     *                   <Rotation>0 0 0</Rotation>
     *                 </Transformation>
     *                 <Axis>1.0 0 0</Axis>
     *               </Motion>
     *             </Configuration>
     *           </Linear>
     *           <DataItems>
     *             <DataItem id="xtravel" type="SYSTEM" category="CONDITION">
     *           </DataItems>
     *         </Components>
     *       </Axes>
     *     </Components>
     *   </Device>
     * </Devices>
     * ~~~~
     * {: caption="Motion Example"}
     *
     * ### Relationship Example
     *
     * ~~~~xml
     * <Components>
     *   <Axes id="a" name="base">
     *     <Components>
     *       <Linear id="x" name="X">
     *         <Configuration>        
     *           <Relationships>
     *             <ComponentRelationship id="xpar" type="PARENT" idRef="we1"/>
     *           </Relationships>
     *         </Configuration>
     *       </Linear>
     *       <DataItems>
     *         <DataItem id="xtravel" type="SYSTEM" category="CONDITION">
     *       </DataItems>
     *     </Components>
     *   </Axes>
     *   <Systems id="systems" name="systems">
     *     <Components>
     *       <WorkEnvelope id="we1" name="workenv">
     *         <Compositions>
     *           <Composition type="WORKPIECE" id="wp"/>
     *           <Composition type="TABLE" id="tbl"/>
     *         </Compositions>
     *         <DataItems>
     *           <DataItem id="we1cond" type="SYSTEM" category="CONDITION">
     *         </DataItems>
     *       </WorkEnvelope>
     *     </Components>
     *   </Systems>
     * </Components>
     * ~~~~
     * {: caption="Relationship Example"}
     *       
     * ### SolidModel Example
     *
     * ~~~~xml
     * <Devices>
     *   <Device id="d1" name="M12346" uuid="M80104K162N">
     *     <Description manufacturer="Example_Corporation" 
     *       serialNumber="272237"> Mill w/SMooth-G
     *     </Description>
     *     <DataItems>
     *       <DataItem id="avail" type="AVAILABILITY" category="EVENT"/>
     *       <DataItem category="EVENT" id="d1_asset_chg" name="asset_chg" type="ASSET_CHANGED"/>
     *       <DataItem category="EVENT" id="d1_asset_rem" name="asset_rem" type="ASSET_REMOVED"/>
     *     </DataItems>
     *     <Configuration>
     *       <CoordinateSystems>
     *         <CoordinateSystem id="base" type="BASE">
     *           <Origin>0 0 0</Origin>
     *         </CoordinateSystem>
     *         <CoordinateSystem id="machcoord" type="MACHINE" parentIdRef="base">
     *           <Transformation>
     *             <Translation>210 275 1430</Translation>
     *             <Rotation>0 0 0</Rotation>
     *           </Transformation>
     *         </CoordinateSystem>
     *         <CoordinateSystem id="workcoord" type="OBJECT" parentIdRef="machcoord">
     *           <Transformation>
     *             <Translation>0 0 0</Translation>
     *             <Rotation>0 0 0</Rotation>
     *           </Transformation>
     *         </CoordinateSystem>
     *       </CoordinateSystems>
     *     </Configuration>
     *     <Components>
     *       <Structures id="struct">
     *         <Configuration>
     *           <SolidModel id="model" mediaType="OBJ" href="/objs/mazak.obj" coordinateSystemIdRef="base">
     *             <Transformation>
     *               <Translation>0 860 0</Translation>
     *               <Rotation>-90 0 0</Rotation>
     *             </Transformation>
     *             <Scale>0.001 0.001 0.001</Scale>
     *           </SolidModel>
     *         </Configuration>
     *         <Components>
     *           <Structure id="xaxis" name="X_AXIS">
     *             <Configuration>
     *               <SolidModel id="x_model" mediaType="OBJ" itemRef="xaxis" solidModelIdRef="model" coordinateSystemIdRef="base"/>
     *             </Configuration>
     *             <DataItems>
     *               <DataItem type="SYSTEM" category="CONDITION" id="struct_cond"/>
     *             </DataItems>
     *           </Structure>
     *         </Components>
     *       </Structures>
     *     </Components>
     *   </Device>
     * </Devices>
     * ~~~~
     * {: caption="SolidModel Example"}
     *
     * ### Specification Example
     *
     * ~~~~xml
     * <Components>
     *   <Axes id="a" name="base">
     *     <Components>
     *       <Linear id="x" name="X">
     *         <Configuration>
     *           <Specifications>
     *             <Specification id="spec001" type="LENGTH" units="MILLIMETER">
     *               <Nominal>650</Nominal>
     *             </Specification>
     *             <Specification id="spec002" type="LINEAR_FORCE" units="NEWTON">
     *               <Maximum>5200</Maximum>
     *               <Minimum>0</Minimum>
     *             </Specification>
     *           </Specifications>
     *         </Configuration>
     *         <DataItems>
     *           <DataItem id="xtravel" type="SYSTEM" category="CONDITION">
     *         </DataItems>
     *       </Linear>
     *     </Components>
     *   </Axes>
     * </Components>
     * ~~~~
     * {: caption="Specification Example"}
     *
     * ### Example of sensing element provided as data item associated with a Component
     *
     * ~~~~xml
     * <Components>
     *   <Axes id="a" name="base"
     *     <Components>
     *       <Rotary id="c" name="C">
     *         <DataItems>
     *           <DataItem type="TEMPERATURE" id="servotemp4"
     *             category="SAMPLE" nativeUnits="CELSIUS"
     *             compositionId="Bmotor" units="CELSIUS"/>
     *           </DataItems>
     *       </Rotary>
     *     </Components>
     *   </Axes>
     * </Components>
     * ~~~~
     * {: caption="Example of sensing element provided as data item associated with a Component"}
     *
     * ### Example of Sensor for rotary axis
     *
     * ~~~~xml
     * <Components>
     *   <Axes id="a" name="base"
     *     <Components>
     *       <Rotary id="ar" name="B">
     *         <Components>
     *           <Sensor id="spdlm" name="Spindlemonitor">
     *             <DataItems>
     *               <DataItem type="DISPLACEMENT" id="cvib"
     *                 category="SAMPLE" name="Svib" 
     *                 units="MILLIMETER"/>
     *             </DataItems>
     *           </Sensor >
     *         <Components>
     *       </Rotary>
     *     </Components>
     *   </Axes>
     * </Components>
     * ~~~~
     * {: caption="Example of Sensor for rotary axis"}
     *
     * ### Example of sensor unit with sensing element
     *
     * ~~~~xml
     * <Axes id="a" name="base"
     *   <Components>
     *   <Sensor id="sens1" name="Sensorunit">
     *     <DataItems>
     *     <DataItem type="TEMPERATURE" id="sentemp"
     *       category="SAMPLE" name="Sensortemp" 
     *       units="CELSIUS"/> 
     *     </DataItems>
     *   </Sensor >
     *   <Linear id="x" name="X">
     *     <DataItems>
     *     <DataItem type="DISPLACEMENT" id="xvib"
     *       category="SAMPLE" name="xvib" 
     *       units="MILLIMETER">
     *       <Source componentId="sens1"/>
     *     </DataItem>
     *     </DataItems>
     *   </Rotary>
     *   <Linear id="y" name="Y">
     *     <DataItems>
     *     <DataItem type="DISPLACEMENT" id="yvib" 
     *       category="SAMPLE" name="yvib" 
     *       units="MILLIMETER">
     *       <Source componentId="sens1"/>
     *     </DataItem>
     *     </DataItems>
     *   </Linear>
     *   <Components>
     * </Axes>
     * ~~~~
     * {: caption="Example of sensor unit with sensing element"}
     *
     * ### Example of configuration data for Sensor
     *
     * ~~~~xml
     * <Sensor id="sensor" name="sensor">
     *   <Configuration>
     *     <SensorConfiguration>
     *       <FirmwareVersion>2.02</FirmwareVersion>
     *       <CalibrationDate>2010-05-16</CalibrationDate>
     *       <NextCalibrationDate>2010-05-16</NextCalibrationDate>
     *       <CalibrationInitials>WS</CalibrationInitials>
     *       <Channels>
     *         <Channel number="1" name="A/D:1">
     *           <Description>A/D With Thermister</Description>
     *         </Channel>
     *       </Channels>
     *     </SensorConfiguration>
     *   </Configuration>
     *   <DataItems>
     *     <DataItem category="CONDITION" id="sensorc" 
     *       name="sensorc" type="SYSTEM" />
     *     <DataItem category="SAMPLE" id="senv" name="sensorc"
     *       type="VOLTAGE_DC" units="VOLT" subType="ACTUAL" />
     *   </DataItems>
     * </Sensor>
     * ~~~~
     * {: caption="Example of configuration data for Sensor"}  */
}
package Imports {
    package 'CSV Imports' {
        occurrence def PropertyMap {
            private attribute propertyName : ScalarValues::String;
            private attribute stereotypeName : ScalarValues::String;
            private columnIndex;
        }
        occurrence def ImportDescriptor {
            private attribute csvFileName : ScalarValues::String;
            private attribute elementTypeName : ScalarValues::String;
            private attribute packageName : ScalarValues::String;
            private attribute diagramTypeName : ScalarValues::String;
            private useFirstRowAsHeaders;
            private useFindOwnerByTagId;
            private attribute stereoTypeNames : ScalarValues::String;
            private attribute identifierName : ScalarValues::String;
            private attribute relationEndIdentifier : ScalarValues::String;
            private attribute propertyMapNames [*] : ScalarValues::String;
            private attribute fieldSeparator : ScalarValues::String;
        }
    }
    package 'Unit Imports' {
        package 'Basic Units' {
            package 'Basic Length';
            package 'Basic Mass';
            package 'Basic Area';
            package 'Basic Volume';
            package 'Basic Time';
            package 'Basic Electric Current';
            package 'Basic Thermodynamic Temperature';
            package 'Basic Amount of Substance';
            package 'Basic Luminous Intensity';
            package 'Basic Speed and Velocity';
            package 'Basic Acceleration';
            package 'Basic Mass Density';
            package 'Basic Electric Current Density';
